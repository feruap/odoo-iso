[Unit]
Description=Amunet - visto bueno de compras por Telegram (Odoo -> Fernando -> depositos mk)
After=docker.service network-online.target
Wants=network-online.target
[Service]
Type=simple
WorkingDirectory=/opt/amunet-pagos-bot
ExecStart=/usr/bin/python3 /opt/amunet-pagos-bot/bot.py
Restart=always
RestartSec=15
StandardOutput=append:/var/log/amunet-pagos-bot.log
StandardError=append:/var/log/amunet-pagos-bot.log
[Install]
WantedBy=multi-user.target
