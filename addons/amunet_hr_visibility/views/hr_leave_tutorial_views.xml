<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Banner de ayuda en el formulario de solicitud de ausencias -->
    <record id="hr_leave_form_tutorial_banner" model="ir.ui.view">
        <field name="name">hr.leave.form.tutorial.banner</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='dashboard_warning_message']" position="before">
                <div class="alert alert-info d-flex align-items-start gap-3 mb-2" role="note">
                    <i class="fa fa-play-circle fa-2x mt-1 text-info"/>
                    <div>
                        <strong>¿Primera vez solicitando una ausencia?</strong>
                        <span class="ms-2">
                            <a href="/amunet_hr_visibility/static/video/Solicitud_de_vacaciones.mp4" target="_blank">
                                Ver video tutorial — Cómo solicitar vacaciones
                            </a>
                        </span>
                        <div class="mt-1 text-muted small">
                            1. Elige el tipo <b>Vacaciones LFT</b> ·
                            2. Selecciona tus fechas ·
                            3. Clic en <b>Guardar</b> y luego <b>Confirmar</b> ·
                            ¿Dudas? rrhh@amunet.com.mx
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Banner de ayuda para supervisores al aprobar/rechazar -->
    <record id="hr_leave_form_supervisor_banner" model="ir.ui.view">
        <field name="name">hr.leave.form.supervisor.banner</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='dashboard_warning_message']" position="before">
                <div class="alert alert-warning d-flex align-items-start gap-3 mb-2" role="note"
                     invisible="not can_approve">
                    <i class="fa fa-play-circle fa-2x mt-1 text-warning"/>
                    <div>
                        <strong>¿Primera vez aprobando una solicitud?</strong>
                        <span class="ms-2">
                            <a href="/amunet_hr_visibility/static/video/Aprobaci%C3%B3n%20Supervisores.mp4" target="_blank">
                                Ver video tutorial — Cómo aprobar o rechazar vacaciones
                            </a>
                        </span>
                        <div class="mt-1 text-muted small">
                            1. Revisa las fechas solicitadas ·
                            2. Clic en <b>Aprobar</b> o <b>Rechazar</b> ·
                            3. Si rechazas, escribe el motivo en los comentarios ·
                            ¿Dudas? rrhh@amunet.com.mx
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
