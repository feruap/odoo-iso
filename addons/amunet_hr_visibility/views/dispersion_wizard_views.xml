<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="amunet_dispersion_wizard_form" model="ir.ui.view">
        <field name="name">amunet.dispersion.wizard.form</field>
        <field name="model">amunet.dispersion.wizard</field>
        <field name="arch" type="xml">
            <form string="Archivos de dispersión">
                <sheet>
                    <div class="oe_title">
                        <h2>Archivos listos para descargar</h2>
                    </div>
                    <group>
                        <field name="resumen" readonly="1" nolabel="1"/>
                        <field name="advertencia" readonly="1" nolabel="1"
                               invisible="not advertencia"
                               style="color: #cc0000; font-weight: bold;"/>
                    </group>
                    <group string="Nómina (Grupo 1)">
                        <field name="nombre_nomina" readonly="1" string="Archivo"/>
                    </group>
                    <group string="Honorarios (Grupo 2)">
                        <field name="nombre_honorarios" readonly="1" string="Archivo"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_descargar_nomina"
                            type="object"
                            string="⬇ Descargar Nómina"
                            class="oe_highlight"/>
                    <button name="action_descargar_honorarios"
                            type="object"
                            string="⬇ Descargar Honorarios"
                            class="oe_highlight"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
