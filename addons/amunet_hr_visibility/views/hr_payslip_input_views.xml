<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pasa el contrato del recibo como valor por defecto al agregar
         una linea de "Otros ingresos" (hr.payslip.input), para que
         no quede el campo vacio y el usuario no tenga que seleccionarlo. -->
    <record id="hr_payslip_input_contract_default" model="ir.ui.view">
        <field name="name">hr.payslip.form.input.contract.default</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='input_line_ids']/list/field[@name='contract_id']" position="replace">
                <field
                    name="contract_id"
                    domain="[('employee_id','=',parent.employee_id)]"
                    context="{'default_employee_id': parent.employee_id, 'default_contract_id': parent.contract_id}"
                    column_invisible="True"
                />
            </xpath>
        </field>
    </record>
</odoo>
