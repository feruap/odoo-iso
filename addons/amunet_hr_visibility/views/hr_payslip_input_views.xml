<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_input_contract_default" model="ir.ui.view">
        <field name="name">hr.payslip.form.input.contract.default</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_form"/>
        <field name="arch" type="xml">
            <!-- Pasar contract_id como default al agregar líneas de otros ingresos -->
            <xpath expr="//field[@name='input_line_ids']" position="attributes">
                <attribute name="context">{'default_contract_id': contract_id, 'default_employee_id': employee_id}</attribute>
            </xpath>
            <!-- Ocultar la columna contract_id en la lista -->
            <xpath expr="//field[@name='input_line_ids']/list/field[@name='contract_id']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
        </field>
    </record>
</odoo>
