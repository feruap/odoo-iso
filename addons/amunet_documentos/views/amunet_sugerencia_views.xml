<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amunet_sugerencia_list" model="ir.ui.view">
        <field name="name">amunet.documento.sugerencia.list</field>
        <field name="model">amunet.documento.sugerencia</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'pendiente'"
                  decoration-success="state == 'aceptada'"
                  decoration-muted="state == 'rechazada'">
                <field name="fecha_creacion"/>
                <field name="documento_codigo"/>
                <field name="secciones_ids" widget="many2many_tags"/>
                <field name="creado_por_id"/>
                <field name="motivo"/>
                <field name="state" widget="badge"/>
                <field name="decidido_por_id"/>
            </list>
        </field>
    </record>

    <record id="view_amunet_sugerencia_form" model="ir.ui.view">
        <field name="name">amunet.documento.sugerencia.form</field>
        <field name="model">amunet.documento.sugerencia</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_aceptar" string="Aceptar"
                            type="object" class="btn-success"
                            icon="fa-check"
                            invisible="state != 'pendiente'"
                            groups="amunet_documentos.group_responsable_sanitario"
                            confirm="¿Confirmas que todas las firmas están completas y autorizas este control de cambios?"/>
                    <button name="action_rechazar" string="Rechazar"
                            type="object" class="btn-danger"
                            icon="fa-times"
                            invisible="state != 'pendiente'"
                            groups="amunet_documentos.group_responsable_sanitario"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pendiente,aceptada,rechazada"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="documento_id" readonly="state != 'pendiente'"
                                   options="{'no_create': True}"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="creado_por_id" string="Nombre del solicitante" readonly="1"/>
                            <field name="fecha_creacion" readonly="1"/>
                            <field name="tipo_cambio" readonly="state != 'pendiente'"
                                   widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group>
                            <field name="decidido_por_id" readonly="1"
                                   invisible="state == 'pendiente'"/>
                            <field name="fecha_decision" readonly="1"
                                   invisible="state == 'pendiente'"/>
                        </group>
                    </group>
                    <group string="Secciones afectadas">
                        <field name="secciones_ids" widget="many2many_tags"
                               readonly="state != 'pendiente'"
                               nolabel="1"
                               placeholder="Selecciona una o varias secciones que cambian..."/>
                    </group>
                    <group string="Alcance del cambio (marque con X la casilla correspondiente)">
                        <group>
                            <field name="alcance_material" readonly="state != 'pendiente'"/>
                            <field name="alcance_documentos" readonly="state != 'pendiente'"/>
                            <field name="alcance_equipo" readonly="state != 'pendiente'"/>
                        </group>
                        <group>
                            <field name="alcance_procesos" readonly="state != 'pendiente'"/>
                            <field name="alcance_estructura" readonly="state != 'pendiente'"/>
                            <field name="alcance_sgc" readonly="state != 'pendiente'"/>
                        </group>
                    </group>
                    <group string="Justificación del cambio">
                        <field name="motivo" nolabel="1" readonly="state != 'pendiente'"
                               placeholder="Describe por qué se propone este cambio."/>
                    </group>
                    <group invisible="not referencia_html or state != 'pendiente' or creado_por_id != uid"
                           string="Contenido actual del documento (solo lectura — para referencia)">
                        <field name="referencia_html" nolabel="1" readonly="1"/>
                    </group>
                    <separator string="Detalle de cambios (Dice actualmente → Debe decir)"/>
                    <field name="cambios_ids" readonly="state != 'pendiente'">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="elemento" string="Elemento que cambia"
                                   placeholder="Ej: Actividad 1, Párrafo del objetivo..."/>
                            <field name="texto_actual" string="Dice actualmente"
                                   optional="show"/>
                            <field name="texto_propuesto" string="Debe decir"
                                   optional="show"/>
                        </list>
                    </field>
                    <group string="Motivo del rechazo (obligatorio para rechazar)"
                           invisible="creado_por_id == uid and state == 'pendiente'">
                        <field name="motivo_rechazo" nolabel="1"
                               readonly="state != 'pendiente'"
                               placeholder="Si vas a rechazar, escribe aquí el motivo antes de hacer clic en Rechazar."/>
                    </group>
                    <separator string="Comité técnico"/>
                    <field name="comite_users_ids" invisible="1"/>
                    <field name="comite_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="fecha" string="Fecha" readonly="1"/>
                            <field name="nombre_id" string="Nombre"
                                   domain="[('id', 'in', parent.comite_users_ids)]"
                                   options="{'no_create': True}"/>
                            <field name="usuario_firma_id" string="Firmado por" readonly="1"/>
                            <field name="fecha_firma" string="Fecha de firma" readonly="1"/>
                            <button name="action_firmar_comite" type="object"
                                    string="Firmar" icon="fa-pencil-square-o"
                                    invisible="usuario_firma_id"
                                    groups="amunet_documentos.group_comite_tecnico"/>
                        </list>
                    </field>
                    <separator string="Firmas de aplicación del cambio"/>
                    <group>
                        <group string="Realizó">
                            <field name="realizo_id"
                                   readonly="firma_realizo_id"
                                   options="{'no_create': True}"/>
                            <field name="firma_realizo_id" readonly="1"
                                   invisible="not firma_realizo_id"/>
                            <field name="fecha_realizo" readonly="1"
                                   invisible="not fecha_realizo"/>
                            <button name="action_firmar_realizo" type="object"
                                    string="Firmar" icon="fa-pencil-square-o"
                                    class="btn-primary"
                                    invisible="not realizo_id or firma_realizo_id"/>
                        </group>
                        <group string="Revisó">
                            <field name="reviso_id"
                                   readonly="firma_reviso_id"
                                   options="{'no_create': True}"/>
                            <field name="firma_reviso_id" readonly="1"
                                   invisible="not firma_reviso_id"/>
                            <field name="fecha_reviso" readonly="1"
                                   invisible="not fecha_reviso"/>
                            <button name="action_firmar_reviso" type="object"
                                    string="Firmar" icon="fa-pencil-square-o"
                                    class="btn-primary"
                                    invisible="not reviso_id or firma_reviso_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Aprobó la aplicación">
                            <field name="aprobo_id"
                                   readonly="firma_aprobo_id"
                                   options="{'no_create': True}"/>
                            <field name="firma_aprobo_id" readonly="1"
                                   invisible="not firma_aprobo_id"/>
                            <field name="fecha_aprobo" readonly="1"
                                   invisible="not fecha_aprobo"/>
                            <button name="action_firmar_aprobo" type="object"
                                    string="Firmar" icon="fa-pencil-square-o"
                                    class="btn-primary"
                                    invisible="not aprobo_id or firma_aprobo_id"/>
                        </group>
                        <group/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_amunet_sugerencia" model="ir.actions.act_window">
        <field name="name">Control de cambios</field>
        <field name="res_model">amunet.documento.sugerencia</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_amunet_sugerencia_mis_pendientes" model="ir.actions.act_window">
        <field name="name">Controles de cambio pendientes (mis documentos)</field>
        <field name="res_model">amunet.documento.sugerencia</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','pendiente'),('documento_id.elabora_id','=',uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No tienes controles de cambio por decidir</p>
        </field>
    </record>
</odoo>
