<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción cliente: panel de bienvenida de Lista maestra -->
    <record id="action_lista_maestra_hub" model="ir.actions.client">
        <field name="name">Lista maestra</field>
        <field name="tag">amunet_documentos.lista_maestra_hub</field>
    </record>

    <!-- ── Raíz ── -->
    <menuitem id="menu_amunet_documentos_root" name="Control de Documentos"
              sequence="90"/>

    <!-- ── Nivel 1: ítems directos ── -->
    <record id="menu_amunet_lista_maestra_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(6,0,[ref('amunet_documentos.group_documentos_manager')])]"/>
    </record>

    <menuitem id="menu_amunet_documentos_lista_maestra" name="PNOs vigentes"
              parent="menu_amunet_lista_maestra_root"
              action="action_amunet_documento_lista_maestra" sequence="10"
              groups="amunet_documentos.group_documentos_manager"/>

    <menuitem id="menu_amunet_documentos_formatos" name="Formatos"
              parent="menu_amunet_lista_maestra_root"
              action="action_amunet_documento_formato" sequence="20"
              groups="amunet_documentos.group_documentos_manager"/>

    <menuitem id="menu_amunet_documentos_obsoletos" name="Documentos obsoletos"
              parent="menu_amunet_lista_maestra_root"
              action="action_amunet_documento_obsoletos" sequence="30"
              groups="amunet_documentos.group_documentos_manager"/>

    <menuitem id="menu_amunet_prueba_rapida" name="Datos de pruebas rápidas"
              parent="menu_amunet_lista_maestra_root"
              action="action_amunet_prueba_rapida" sequence="40"
              groups="amunet_documentos.group_prueba_rapida_editor"/>

    <record id="menu_amunet_formato_mis_solicitudes" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- ── Submenú: Mis pendientes (desactivado: el tablero Inicio lo cubre) ── -->
    <record id="menu_amunet_mis_pendientes" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <menuitem id="menu_amunet_documentos_a_corregir" name="Documentos a corregir"
              parent="menu_amunet_mis_pendientes"
              action="action_amunet_documento_a_corregir" sequence="10"/>

    <menuitem id="menu_amunet_documentos_por_revisar" name="Documentos por revisar"
              parent="menu_amunet_mis_pendientes"
              action="action_amunet_documento_por_revisar" sequence="20"/>

    <menuitem id="menu_amunet_documentos_por_autorizar" name="Documentos por autorizar"
              parent="menu_amunet_mis_pendientes"
              action="action_amunet_documento_por_autorizar" sequence="30"/>


    <menuitem id="menu_amunet_distribucion_mis_docs" name="Mis documentos por acusar"
              parent="menu_amunet_mis_pendientes"
              action="action_distribucion_mis_docs" sequence="55"/>

    <!-- ── Submenú: Gestión (solo managers) ── -->
    <menuitem id="menu_amunet_gestion" name="Gestión"
              parent="menu_amunet_documentos_root"
              sequence="40"
              groups="amunet_documentos.group_documentos_manager,amunet_documentos.group_responsable_sanitario,amunet_documentos.group_supervisor_documentacion"/>

    <record id="menu_amunet_formato_permisos" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="menu_amunet_distribucion_panel" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="menu_amunet_bitacora_firmas" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="menu_amunet_formato_solicitudes_pendientes" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <menuitem id="menu_amunet_catalogo_firma" name="Catálogo de firmas"
              parent="menu_amunet_gestion"
              action="action_amunet_catalogo_firma" sequence="20"
              groups="group_documentos_manager"/>

    <!-- ── Configuración (managers) ── -->
    <menuitem id="menu_amunet_documentos_config" name="Configuracion"
              parent="menu_amunet_documentos_root"
              sequence="90" groups="group_documentos_manager"/>

    <menuitem id="menu_amunet_firma_config" name="Politicas de firmas"
              parent="menu_amunet_documentos_config"
              action="action_amunet_firma_config" sequence="10"/>
</odoo>
