<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_documentos_user" model="res.groups">
        <field name="name">Documentos: Usuario</field>
    </record>
    <record id="group_documentos_manager" model="res.groups">
        <field name="name">Documentos: Responsable</field>
        <field name="implied_ids" eval="[(4, ref('group_documentos_user'))]"/>
    </record>
    <record id="group_comite_tecnico" model="res.groups">
        <field name="name">Documentos: Comité técnico</field>
        <field name="implied_ids" eval="[(4, ref('group_documentos_user'))]"/>
    </record>
    <record id="group_responsable_sanitario" model="res.groups">
        <field name="name">Documentos: Responsable Sanitario</field>
        <field name="implied_ids" eval="[(4, ref('group_documentos_user'))]"/>
    </record>
    <record id="group_supervisor_documentacion" model="res.groups">
        <field name="name">Documentos: Supervisora de Documentación</field>
        <field name="implied_ids" eval="[(4, ref('group_documentos_user'))]"/>
    </record>

    <!-- Grupos por área para control de visibilidad de documentos -->
    <record id="group_docs_area_al" model="res.groups">
        <field name="name">Documentos: Área Almacén</field>
        <field name="implied_ids" eval="[(4, ref('group_documentos_user'))]"/>
    </record>
    <record id="group_docs_area_cc" model="res.groups">
        <field name="name">Documentos: Área Control Calidad</field>
        <field name="implied_ids" eval="[(4, ref('group_documentos_user'))]"/>
    </record>
    <record id="group_docs_area_pr" model="res.groups">
        <field name="name">Documentos: Área Producción</field>
        <field name="implied_ids" eval="[(4, ref('group_documentos_user'))]"/>
    </record>
    <record id="group_docs_area_rh" model="res.groups">
        <field name="name">Documentos: Área Recursos Humanos</field>
        <field name="implied_ids" eval="[(4, ref('group_documentos_user'))]"/>
    </record>
</odoo>
