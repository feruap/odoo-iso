<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Todos los empleados: solo pueden VER documentos generales (GE) -->
    <record id="rule_docs_base_ge" model="ir.rule">
        <field name="name">Documentos: Empleados - solo lectura de generales</field>
        <field name="model_id" ref="model_amunet_documento"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('area', '=', 'GE')]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

