<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="amunet_documentos.ListaMaestraHub">
        <div class="o_view_controller">
            <div class="container py-5">
                <h3 class="mb-1 fw-bold">Lista maestra de documentos controlados</h3>
                <p class="text-muted mb-4">Selecciona la lista que quieres consultar o gestionar.</p>
                <div class="row g-4">

                    <div class="col-12">
                        <div class="card shadow-sm border-0 lm-card lm-card-highlight"
                             t-on-click="() => this.openAction('amunet_cc_general.action_mis_pendientes_dashboard')">
                            <div class="card-body d-flex align-items-center gap-3 py-3 px-4">
                                <i class="fa fa-bell fa-2x text-warning"/>
                                <div>
                                    <h5 class="card-title mb-1">Mis pendientes</h5>
                                    <p class="card-text text-muted small mb-0">
                                        Tablero de documentos y tareas que requieren tu atención
                                    </p>
                                </div>
                                <i class="fa fa-chevron-right ms-auto text-muted"/>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card h-100 shadow-sm border-0 lm-card"
                             t-on-click="() => this.openAction('amunet_documentos.action_amunet_documento_lista_maestra')">
                            <div class="card-body d-flex align-items-center gap-3 py-4 px-4">
                                <i class="fa fa-file-text-o fa-2x text-primary"/>
                                <div>
                                    <h5 class="card-title mb-1">PNOs vigentes</h5>
                                    <p class="card-text text-muted small mb-0">
                                        Procedimientos normalizados de operación en vigor
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card h-100 shadow-sm border-0 lm-card"
                             t-on-click="() => this.openAction('amunet_documentos.action_amunet_documento_formato')">
                            <div class="card-body d-flex align-items-center gap-3 py-4 px-4">
                                <i class="fa fa-wpforms fa-2x text-success"/>
                                <div>
                                    <h5 class="card-title mb-1">Formatos</h5>
                                    <p class="card-text text-muted small mb-0">
                                        Formatos controlados vigentes
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card h-100 shadow-sm border-0 lm-card"
                             t-on-click="() => this.openAction('amunet_documentos.action_amunet_documento_obsoletos')">
                            <div class="card-body d-flex align-items-center gap-3 py-4 px-4">
                                <i class="fa fa-archive fa-2x text-warning"/>
                                <div>
                                    <h5 class="card-title mb-1">Documentos obsoletos</h5>
                                    <p class="card-text text-muted small mb-0">
                                        Historial de versiones anteriores
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card h-100 shadow-sm border-0 lm-card"
                             t-on-click="() => this.openAction('amunet_documentos.action_amunet_prueba_rapida')">
                            <div class="card-body d-flex align-items-center gap-3 py-4 px-4">
                                <i class="fa fa-flask fa-2x text-info"/>
                                <div>
                                    <h5 class="card-title mb-1">Datos de pruebas rápidas</h5>
                                    <p class="card-text text-muted small mb-0">
                                        Catálogo de pruebas de diagnóstico IVD
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card h-100 shadow-sm border-0 lm-card"
                             t-on-click="() => this.openAction('amunet_cc_general.action_cc_general')">
                            <div class="card-body d-flex align-items-center gap-3 py-4 px-4">
                                <i class="fa fa-exchange fa-2x" style="color:#6f42c1"/>
                                <div>
                                    <h5 class="card-title mb-1">Control de cambios</h5>
                                    <p class="card-text text-muted small mb-0">
                                        Registro y seguimiento de controles de cambio documentales
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card h-100 shadow-sm border-0 lm-card"
                             t-on-click="() => this.openAction('amunet_desviaciones.action_desviacion')">
                            <div class="card-body d-flex align-items-center gap-3 py-4 px-4">
                                <i class="fa fa-exclamation-triangle fa-2x text-danger"/>
                                <div>
                                    <h5 class="card-title mb-1">Desviaciones / NC</h5>
                                    <p class="card-text text-muted small mb-0">
                                        Registro y seguimiento de desviaciones y no conformidades
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card h-100 shadow-sm border-0 lm-card"
                             t-on-click="() => this.openAction('amunet_programa_auditorias.action_programa_auditoria')">
                            <div class="card-body d-flex align-items-center gap-3 py-4 px-4">
                                <i class="fa fa-calendar fa-2x" style="color:#2b7bb9"/>
                                <div>
                                    <h5 class="card-title mb-1">Programas anuales</h5>
                                    <p class="card-text text-muted small mb-0">
                                        Programa anual de auditorías internas
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card h-100 shadow-sm border-0 lm-card"
                             t-on-click="() => this.openAction('amunet_plan_auditorias.action_plan_auditoria')">
                            <div class="card-body d-flex align-items-center gap-3 py-4 px-4">
                                <i class="fa fa-search fa-2x" style="color:#38a169"/>
                                <div>
                                    <h5 class="card-title mb-1">Auditorías internas</h5>
                                    <p class="card-text text-muted small mb-0">
                                        Planes, informes y registros de auditorías internas
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card h-100 shadow-sm border-0 lm-card"
                             t-on-click="() => this.openAction('amunet_proveedores.action_auditoria_proveedor')">
                            <div class="card-body d-flex align-items-center gap-3 py-4 px-4">
                                <i class="fa fa-truck fa-2x" style="color:#805ad5"/>
                                <div>
                                    <h5 class="card-title mb-1">Auditorías a proveedores</h5>
                                    <p class="card-text text-muted small mb-0">
                                        Informes de auditoría técnica a proveedores
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card h-100 shadow-sm border-0 lm-card"
                             t-on-click="() => this.openAction('amunet_copias_controladas.action_copia_controlada')">
                            <div class="card-body d-flex align-items-center gap-3 py-4 px-4">
                                <i class="fa fa-print fa-2x" style="color:#d69e2e"/>
                                <div>
                                    <h5 class="card-title mb-1">Copias controladas</h5>
                                    <p class="card-text text-muted small mb-0">
                                        Lista maestra de copias controladas de documentos
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </t>
</templates>
