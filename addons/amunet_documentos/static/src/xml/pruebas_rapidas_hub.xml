<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="amunet_documentos.PruebasRapidasHub">
        <div class="o_view_controller">
            <div class="container py-5">
                <h3 class="mb-1 fw-bold">Pruebas rápidas de diagnóstico</h3>
                <p class="text-muted mb-4">Selecciona la categoría que quieres consultar.</p>
                <div class="row g-4">

                    <div class="col-md-6">
                        <div class="card h-100 shadow-sm border-0 lm-card" t-on-click="abrirConRS">
                            <div class="card-body d-flex align-items-center gap-3 py-4 px-4">
                                <i class="fa fa-certificate fa-2x text-success"/>
                                <div>
                                    <h5 class="card-title mb-1">Con registro sanitario</h5>
                                    <p class="card-text text-muted small mb-0">
                                        Pruebas con registro Cofepris vigente
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card h-100 shadow-sm border-0 lm-card" t-on-click="abrirSinRS">
                            <div class="card-body d-flex align-items-center gap-3 py-4 px-4">
                                <i class="fa fa-flask fa-2x text-info"/>
                                <div>
                                    <h5 class="card-title mb-1">Sin registro sanitario</h5>
                                    <p class="card-text text-muted small mb-0">
                                        Pruebas en trámite o sin registro Cofepris
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </t>
</templates>
