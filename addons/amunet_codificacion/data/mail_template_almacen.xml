<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_nuevo_producto" model="mail.template">
            <field name="name">Codificación: nuevo insumo/producto registrado</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="subject">Nuevo insumo/producto registrado en el sistema</field>
            <field name="email_from">{{ (user.email_formatted or '') }}</field>
            <field name="body_html" type="html">
                <div style="font-family:Arial,sans-serif;font-size:13px;color:#222;">
                    <p>Estimado equipo de almacén,</p>
                    <p>Se ha ingresado un nuevo insumo/producto al sistema:</p>
                    <ul>
                        <li>Clave generada: <strong t-out="object.default_code or ''">MPCAR63</strong></li>
                        <li>Clasificación: <t t-out="object.amunet_clasificacion or ''">MP</t></li>
                        <li>Nombre/Analito: <t t-out="object.amunet_analito or object.name or ''">Producto</t></li>
                        <li>Fecha de registro: <t t-out="format_date(object.create_date) or ''">01/01/2026</t></li>
                    </ul>
                    <p>Atentamente,<br/>Sistema</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
