<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Vista lista (Mis controles de cambio) ────────────────── -->
    <record id="view_cc_general_mis_list" model="ir.ui.view">
        <field name="name">amunet.cc.general.mis.list</field>
        <field name="model">amunet.cc.general</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'borrador'"
                  decoration-warning="state == 'pendiente'"
                  decoration-success="state in ('aceptado', 'cerrado')"
                  decoration-muted="state == 'rechazado'">
                <field name="name" string="Folio"/>
                <field name="fecha_solicitud"/>
                <field name="nombre_documento" string="Documento / área afectada"/>
                <field name="tipo_display" string="Tipo de cambio"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'borrador'"
                       decoration-warning="state == 'pendiente'"
                       decoration-success="state in ('aceptado', 'cerrado')"
                       decoration-danger="state == 'rechazado'"/>
            </list>
        </field>
    </record>

    <!-- ── Vista formulario resumen (Mis controles de cambio) ────── -->
    <record id="view_cc_general_mis_form" model="ir.ui.view">
        <field name="name">amunet.cc.general.mis.form</field>
        <field name="model">amunet.cc.general</field>
        <field name="arch" type="xml">
            <form string="Mi control de cambios">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="borrador,pendiente,aceptado,cerrado"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Folio"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="fecha_solicitud" readonly="1"/>
                            <field name="solicitante_id" readonly="1"/>
                            <field name="departamento" readonly="1"/>
                        </group>
                        <group>
                            <field name="nombre_documento" readonly="1"/>
                            <field name="tipo_display" string="Tipo de cambio" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Descripción del cambio"/>
                    <field name="estado_actual" readonly="1" string="Estado actual"/>
                    <field name="estado_propuesto" readonly="1" string="Cambio propuesto"/>
                    <field name="justificacion" readonly="1"/>
                    <separator string="Autorización"/>
                    <group>
                        <group>
                            <field name="reviso_id" readonly="1"/>
                            <field name="firma_reviso_id" readonly="1" invisible="not firma_reviso_id"/>
                        </group>
                        <group>
                            <field name="aprobo_id" readonly="1"/>
                            <field name="firma_aprobo_id" readonly="1" invisible="not firma_aprobo_id"/>
                            <field name="motivo_rechazo" readonly="1" invisible="state != 'rechazado'"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Vista lista (Pendientes de mi firma) ─────────────────── -->
    <record id="view_cc_general_por_firmar_list" model="ir.ui.view">
        <field name="name">amunet.cc.general.por.firmar.list</field>
        <field name="model">amunet.cc.general</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="fecha_solicitud"/>
                <field name="solicitante_id"/>
                <field name="accion_pendiente_usuario" string="Lo que debes hacer"
                       decoration-danger="accion_pendiente_usuario"/>
            </list>
        </field>
    </record>

    <!-- ── Vista lista ─────────────────────────────────────────── -->
    <record id="view_cc_general_list" model="ir.ui.view">
        <field name="name">amunet.cc.general.list</field>
        <field name="model">amunet.cc.general</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'borrador'"
                  decoration-warning="state == 'pendiente'"
                  decoration-success="state in ('aceptado', 'cerrado')"
                  decoration-muted="state == 'rechazado'">
                <field name="name"/>
                <field name="fecha_solicitud"/>
                <field name="solicitante_id"/>
                <field name="departamento"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'borrador'"
                       decoration-warning="state == 'pendiente'"
                       decoration-success="state in ('aceptado', 'cerrado')"
                       decoration-danger="state == 'rechazado'"/>
            </list>
        </field>
    </record>

    <!-- ── Vista formulario ────────────────────────────────────── -->
    <record id="view_cc_general_form" model="ir.ui.view">
        <field name="name">amunet.cc.general.form</field>
        <field name="model">amunet.cc.general</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_enviar" string="Enviar para autorización"
                            type="object" class="btn-primary" icon="fa-paper-plane"
                            invisible="state != 'borrador'"
                            confirm="¿El registro está completo y listo para enviarse?"/>
                    <button name="action_descartar" string="Eliminar borrador"
                            type="object" class="btn-danger" icon="fa-trash"
                            invisible="state != 'borrador'"
                            confirm="¿Segura que quieres eliminar este borrador?"/>
                    <button name="action_aceptar" string="Autorizar"
                            type="object" class="btn-success" icon="fa-check"
                            invisible="state != 'pendiente'"
                            groups="amunet_cc_general.group_cc_general_manager"/>
                    <button name="action_rechazar" string="Rechazar"
                            type="object" class="btn-danger" icon="fa-times"
                            invisible="state != 'pendiente'"
                            groups="amunet_cc_general.group_cc_general_manager"/>
                    <button name="action_cerrar" string="Cerrar"
                            type="object" class="btn-secondary" icon="fa-flag-checkered"
                            invisible="state != 'aceptado'"
                            groups="amunet_cc_general.group_cc_general_manager"
                            confirm="¿Confirmas que la implementación está completa y deseas cerrar este control de cambios?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="borrador,pendiente,aceptado,cerrado"/>
                </header>
                <sheet>
                    <field name="is_manager" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="Folio" invisible="not id"/>
                        <h1 invisible="not id"><field name="name" readonly="1"/></h1>
                    </div>

                    <!-- Encabezado -->
                    <group>
                        <group>
                            <field name="fecha_solicitud"
                                   readonly="state not in ('borrador',)"/>
                            <field name="solicitante_id"
                                   readonly="firma_solicitante_id or state not in ('borrador',)"
                                   options="{'no_create': True}"/>
                            <field name="firma_solicitante_id" readonly="1"
                                   invisible="not firma_solicitante_id"/>
                            <field name="fecha_solicitante" readonly="1"
                                   invisible="not fecha_solicitante"/>
                            <button name="action_firmar_solicitante" type="object"
                                    string="Firmar" icon="fa-pencil-square-o" class="btn-primary"
                                    invisible="not solicitante_id or firma_solicitante_id or state not in ('borrador',)"/>
                        </group>
                        <group>
                            <field name="departamento"
                                   readonly="state not in ('borrador',)"/>
                        </group>
                    </group>

                    <!-- ── Sección 1: Tipo y descripción ────────── -->
                    <separator string="1. Tipo y descripción del cambio"/>
                    <group>
                        <field name="nombre_documento" readonly="state not in ('borrador',)"
                               placeholder="Ej. PNODC-003, Cámara de refrigeración #2..."/>
                    </group>
                    <group string="Tipo de cambio (selecciona los que apliquen)">
                        <group>
                            <field name="tipo_procedimiento" string="Instrucciones" readonly="state not in ('borrador',)"/>
                            <field name="tipo_formula"       readonly="state not in ('borrador',)"/>
                            <field name="tipo_proveedor"     readonly="state not in ('borrador',)"/>
                            <field name="tipo_instalacion"   readonly="state not in ('borrador',)"/>
                        </group>
                        <group>
                            <field name="tipo_equipo"    readonly="state not in ('borrador',)"/>
                            <field name="tipo_manual"    readonly="state not in ('borrador',)"/>
                            <field name="tipo_formato"   readonly="state not in ('borrador',)"/>
                            <field name="tipo_otro"      readonly="state not in ('borrador',)"/>
                            <field name="tipo_otro_desc" readonly="state not in ('borrador',)"
                                   invisible="not tipo_otro"
                                   placeholder="Especifica..."/>
                        </group>
                    </group>
                    <separator string=""/>
                    <label for="estado_actual" string="Estado actual (¿cómo está ahora?)"/>
                    <field name="estado_actual"    readonly="state not in ('borrador',)"
                           placeholder="Describe la situación actual del documento, área o proceso. Ej. El procedimiento PNODC-003 versión 1.0 no incluye el paso de verificación de vigencia antes de imprimir."
                           rows="4"/>
                    <label for="estado_propuesto" string="Descripción del cambio (¿qué se va a modificar exactamente?)"/>
                    <field name="estado_propuesto" readonly="state not in ('borrador',)"
                           placeholder="Describe qué quedará diferente tras el cambio. Ej. El procedimiento PNODC-003 versión 2.0 incluirá un paso de verificación de vigencia antes de cualquier impresión."
                           rows="4"/>
                    <label for="justificacion" string="Justificación (¿qué lo origina? Regulación, auditoría, incidente, mejora...)"/>
                    <field name="justificacion"    readonly="state not in ('borrador',)"
                           placeholder="Explica la razón o el origen del cambio. Ej. En la auditoría interna de junio 2026 se detectó que personal imprimía documentos sin verificar vigencia, generando riesgo de uso de versiones obsoletas."
                           rows="5"/>

                    <!-- ── Sección 2: Autorización del cambio ────── -->
                    <separator string="2. Autorización del cambio"/>
                    <group>
                        <group string="Revisó (Aseguramiento de Calidad)">
                            <field name="reviso_id"
                                   readonly="firma_reviso_id or state not in ('borrador', 'pendiente')"
                                   options="{'no_create': True}"/>
                            <field name="firma_reviso_id" readonly="1" invisible="not firma_reviso_id"/>
                            <field name="fecha_reviso"    readonly="1" invisible="not fecha_reviso"/>
                            <field name="vb_reviso"       readonly="1" invisible="not vb_reviso"/>
                            <button name="action_firmar_reviso" type="object"
                                    string="Firmar" icon="fa-pencil-square-o" class="btn-primary"
                                    invisible="not reviso_id or firma_reviso_id or state != 'pendiente'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Aprobó (Gerencia / Dirección)">
                            <field name="aprobo_id"
                                   readonly="firma_aprobo_id or state not in ('borrador', 'pendiente')"
                                   options="{'no_create': True}"/>
                            <field name="firma_aprobo_id" readonly="1" invisible="not firma_aprobo_id"/>
                            <field name="fecha_aprobo"    readonly="1" invisible="not fecha_aprobo"/>
                            <field name="vb_aprobo"       readonly="1" invisible="not vb_aprobo"/>
                        </group>
                        <group string="Motivo del rechazo" invisible="state != 'rechazado'">
                            <field name="motivo_rechazo" nolabel="1" readonly="1"/>
                        </group>
                    </group>

                    <!-- ── Sección 3: Plan de implementación ─────── -->
                    <separator string="3. Plan de implementación"
                               invisible="state not in ('aceptado', 'cerrado')"/>
                    <group invisible="state not in ('aceptado', 'cerrado')">
                        <group>
                            <field name="fecha_propuesta"
                                   readonly="state not in ('aceptado',)"/>
                        </group>
                        <group>
                            <field name="lote_aplicacion"
                                   readonly="state not in ('aceptado',)"
                                   placeholder="Ej. Lote piloto o fecha específica"/>
                        </group>
                    </group>

                    <!-- ── Implementación y seguimiento ──────────── -->
                    <separator string="Implementación y seguimiento"
                               invisible="state not in ('aceptado', 'cerrado')"/>
                    <field name="actividades_ids"
                           invisible="state not in ('aceptado', 'cerrado')"
                           readonly="state not in ('aceptado',)">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="actividad"      string="Actividad"
                                   placeholder="Describe la actividad..."/>
                            <field name="responsable_id" string="Responsable"
                                   options="{'no_create': True}"/>
                            <field name="estado_enterado" widget="badge" readonly="1"
                                   decoration-success="estado_enterado == 'enterado'"
                                   decoration-danger="estado_enterado == 'pendiente'"
                                   invisible="not responsable_id"/>
                            <button name="action_firmar_enterado" type="object"
                                    string="Firmar enterado" icon="fa-check-circle-o"
                                    invisible="firma_enterado_id or not responsable_id"/>
                            <field name="recursos" string="Recursos necesarios"
                                   placeholder="Ej. Materiales, equipo, personal de apoyo..."
                                   optional="show"/>
                            <field name="fecha_inicio"   string="Fecha de inicio"/>
                            <field name="fecha_termino"  string="Fecha de término"/>
                            <field name="verifico_id" string="Verifica"
                                   options="{'no_create': True}"/>
                            <button name="action_firmar_verificacion" type="object"
                                    string="Verificar" icon="fa-pencil-square-o"
                                    invisible="firma_verifico_id"/>
                            <field name="fecha_verificacion" string="Fecha verificación"
                                   readonly="1" optional="show"/>
                        </list>
                    </field>

                    <!-- ── Verificación y cierre ─────────────────── -->
                    <separator string="4. Verificación y cierre"
                               invisible="state not in ('aceptado', 'cerrado')"/>
                    <group invisible="state not in ('aceptado', 'cerrado')">
                        <group>
                            <field name="fecha_implementacion"
                                   readonly="not is_manager or state not in ('aceptado',)"/>
                            <field name="responsable_cierre_id"
                                   readonly="not is_manager or state not in ('aceptado',)"
                                   options="{'no_create': True}"/>
                            <field name="nueva_version"
                                   readonly="not is_manager or state not in ('aceptado',)"
                                   placeholder="Ej. Versión 2.0"/>
                        </group>
                    </group>
                    <label for="resultados_verificacion"
                           invisible="state not in ('aceptado', 'cerrado')"/>
                    <field name="resultados_verificacion"
                           invisible="state not in ('aceptado', 'cerrado')"
                           readonly="not is_manager or state not in ('aceptado',)"
                           placeholder="Ej. Se revisó el procedimiento actualizado a la nueva versión. El personal confirmó que recibió capacitación. Se verificó que los formatos anteriores fueron reemplazados en los puntos de uso." rows="4"/>
                    <label for="evidencia_anexa"
                           invisible="state not in ('aceptado', 'cerrado')"/>
                    <field name="evidencia_anexa"
                           invisible="state not in ('aceptado', 'cerrado')"
                           readonly="not is_manager or state not in ('aceptado',)"
                           placeholder="Ej. Captura de pantalla, enlace al registro actualizado en Odoo, o descripción de lo verificado."/>

                    <!-- ── Firmas de cierre ──────────────────────── -->
                    <separator string="Firmas de cierre"
                               invisible="state not in ('aceptado', 'cerrado')"/>
                    <group invisible="state not in ('aceptado', 'cerrado')">
                        <group string="Realizó el control de cambios">
                            <field name="cierre_realizo_id"
                                   readonly="not is_manager or firma_cierre_realizo_id or state not in ('aceptado',)"
                                   options="{'no_create': True}"/>
                            <field name="firma_cierre_realizo_id" readonly="1" invisible="not firma_cierre_realizo_id"/>
                            <field name="fecha_cierre_realizo"    readonly="1" invisible="not fecha_cierre_realizo"/>
                            <button name="action_firmar_cierre_realizo" type="object"
                                    string="Firmar" icon="fa-pencil-square-o" class="btn-primary"
                                    invisible="not cierre_realizo_id or firma_cierre_realizo_id or state not in ('aceptado',)"/>
                        </group>
                        <group string="Revisó la aplicación">
                            <field name="cierre_reviso_id"
                                   readonly="not is_manager or firma_cierre_reviso_id or state not in ('aceptado',)"
                                   options="{'no_create': True}"/>
                            <field name="firma_cierre_reviso_id" readonly="1" invisible="not firma_cierre_reviso_id"/>
                            <field name="fecha_cierre_reviso"    readonly="1" invisible="not fecha_cierre_reviso"/>
                            <button name="action_firmar_cierre_reviso" type="object"
                                    string="Firmar" icon="fa-pencil-square-o" class="btn-primary"
                                    invisible="not cierre_reviso_id or firma_cierre_reviso_id or state not in ('aceptado',)"/>
                        </group>
                    </group>
                    <group invisible="state not in ('aceptado', 'cerrado')">
                        <group string="Aprobó la aplicación del cambio">
                            <field name="cierre_aprobo_id"
                                   readonly="not is_manager or firma_cierre_aprobo_id or state not in ('aceptado',)"
                                   options="{'no_create': True}"/>
                            <field name="firma_cierre_aprobo_id" readonly="1" invisible="not firma_cierre_aprobo_id"/>
                            <field name="fecha_cierre_aprobo"    readonly="1" invisible="not fecha_cierre_aprobo"/>
                            <button name="action_firmar_cierre_aprobo" type="object"
                                    string="Firmar" icon="fa-pencil-square-o" class="btn-primary"
                                    invisible="not cierre_aprobo_id or firma_cierre_aprobo_id or state not in ('aceptado',)"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Acciones ─────────────────────────────────────────────── -->
    <record id="action_cc_general" model="ir.actions.act_window">
        <field name="name">Control de cambios general</field>
        <field name="res_model">amunet.cc.general</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay registros de control de cambios todavía.
            </p>
        </field>
    </record>

    <record id="action_cc_general_mis" model="ir.actions.act_window">
        <field name="name">Mis controles de cambio</field>
        <field name="res_model">amunet.cc.general</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(ref('view_cc_general_mis_list'), 'list'), (ref('view_cc_general_mis_form'), 'form')]"/>
        <field name="domain">[('solicitante_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aún no has creado ningún control de cambios.
            </p>
        </field>
    </record>

    <record id="action_cc_general_por_firmar" model="ir.actions.act_window">
        <field name="name">Pendientes de mi firma</field>
        <field name="res_model">amunet.cc.general</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_cc_general_por_firmar_list"/>
        <field name="domain">[('pendientes_para_ids', 'in', [uid])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tienes controles de cambio pendientes de tu firma.
            </p>
        </field>
    </record>
</odoo>
