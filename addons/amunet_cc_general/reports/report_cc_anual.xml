<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Acción de reporte ──────────────────────────────────────── -->
    <record id="action_report_cc_anual" model="ir.actions.report">
        <field name="name">Registro Anual de Controles de Cambio</field>
        <field name="model">amunet.cc.general</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">amunet_cc_general.report_cc_anual_template</field>
        <field name="report_file">amunet_cc_general.report_cc_anual_template</field>
        <field name="binding_model_id" search="[('model','=','amunet.cc.general')]"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- ── Plantilla QWeb ────────────────────────────────────────── -->
    <template id="report_cc_anual_template">
        <t t-call="web.html_container">
            <t t-foreach="docs_grouped_by_year" t-as="year_group">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- Encabezado -->
                        <div class="row mb-4">
                            <div class="col-12 text-center">
                                <h3 class="mt-0">Registro Anual de Controles de Cambio</h3>
                                <h4 class="text-muted">Año <t t-esc="year_group['year']"/></h4>
                                <p class="small">ISO 13485:2016 § 4.2.4 — Control de Cambios Documentales</p>
                            </div>
                        </div>

                        <!-- Tabla por mes -->
                        <t t-foreach="year_group['months']" t-as="mes">
                            <t t-if="mes['records']">
                                <h5 class="mt-3 mb-1 border-bottom pb-1">
                                    <t t-esc="mes['nombre']"/>
                                    <span class="text-muted small"> (<t t-esc="len(mes['records'])"/> registro(s))</span>
                                </h5>
                                <table class="table table-sm table-bordered" style="font-size:10px;">
                                    <thead class="table-secondary">
                                        <tr>
                                            <th style="width:8%">Folio</th>
                                            <th style="width:10%">Fecha</th>
                                            <th style="width:14%">Tipo</th>
                                            <th style="width:28%">Asunto</th>
                                            <th style="width:15%">Solicitante</th>
                                            <th style="width:13%">Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="mes['records']" t-as="cc">
                                            <tr>
                                                <td><t t-esc="cc.name"/></td>
                                                <td><t t-esc="cc.fecha_solicitud.strftime('%d/%m/%Y') if cc.fecha_solicitud else ''"/></td>
                                                <td><t t-esc="dict(cc._fields['tipo_cambio'].selection).get(cc.tipo_cambio, cc.tipo_cambio or '')"/></td>
                                                <td><t t-esc="cc.nombre_documento or ''"/></td>
                                                <td><t t-esc="cc.solicitante_id.name if cc.solicitante_id else ''"/></td>
                                                <td><t t-esc="dict(cc._fields['state'].selection).get(cc.state, cc.state)"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                        </t>

                        <!-- Totales -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <p class="small text-muted">
                                    Total del año: <strong><t t-esc="year_group['total']"/></strong> control(es) de cambio registrado(s).
                                </p>
                            </div>
                        </div>

                        <!-- Pie de firma -->
                        <div class="row mt-4">
                            <div class="col-4 text-center">
                                <p style="border-top:1px solid #333; padding-top:4px; font-size:10px;">
                                    Elaboró
                                </p>
                            </div>
                            <div class="col-4 text-center">
                                <p style="border-top:1px solid #333; padding-top:4px; font-size:10px;">
                                    Revisó
                                </p>
                            </div>
                            <div class="col-4 text-center">
                                <p style="border-top:1px solid #333; padding-top:4px; font-size:10px;">
                                    Autorizó
                                </p>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
