<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="amunet_cc_general.AuditoriasHub">
    <div class="o_action o_amunet_mis_pendientes">

        <div class="o_amunet_dash_section_title">Auditorías internas</div>

        <div class="o_amunet_dash_cards o_amunet_dash_cards_hub">

            <!-- Convocatorias -->
            <div t-if="state.isManager" class="o_amunet_hub_card o_amunet_hub_card_lg"
                 t-on-click="() => this.abrirAccionXml('amunet_auditores.action_convocatoria')">
                <i class="fa fa-bullhorn fa-2x mb-2" style="color:#0d6efd"/>
                <span class="o_amunet_hub_label">Convocatorias</span>
                <t t-if="!state.loading">
                    <span t-attf-class="o_amunet_hub_badge {{ state.convocatorias > 0 ? 'badge-active' : 'badge-empty' }}">
                        <t t-esc="state.convocatorias"/> activa<t t-if="state.convocatorias != 1">s</t>
                    </span>
                </t>
                <t t-else="">
                    <span class="o_amunet_hub_badge badge-empty">&#8212;</span>
                </t>
            </div>

            <!-- Planes de Auditoría -->
            <div class="o_amunet_hub_card o_amunet_hub_card_lg"
                 t-on-click="() => this.abrirAccionXml('amunet_plan_auditorias.action_plan_auditoria')">
                <i class="fa fa-search fa-2x mb-2" style="color:#6f42c1"/>
                <span class="o_amunet_hub_label">Planes de Auditoría</span>
                <t t-if="!state.loading">
                    <span t-attf-class="o_amunet_hub_badge {{ state.planes > 0 ? 'badge-active' : 'badge-empty' }}">
                        <t t-esc="state.planes"/> en curso
                    </span>
                </t>
                <t t-else="">
                    <span class="o_amunet_hub_badge badge-empty">&#8212;</span>
                </t>
            </div>

            <!-- Actas de Auditoría -->
            <div class="o_amunet_hub_card o_amunet_hub_card_lg"
                 t-on-click="() => this.abrirAccionXml('amunet_acta_auditoria.action_acta_auditoria')">
                <i class="fa fa-file-text-o fa-2x mb-2" style="color:#2f855a"/>
                <span class="o_amunet_hub_label">Apertura y Cierre</span>
                <t t-if="!state.loading">
                    <span t-attf-class="o_amunet_hub_badge {{ state.actas > 0 ? 'badge-active' : 'badge-empty' }}">
                        <t t-esc="state.actas"/> en proceso
                    </span>
                </t>
                <t t-else="">
                    <span class="o_amunet_hub_badge badge-empty">&#8212;</span>
                </t>
            </div>

            <!-- Listas de Verificación -->
            <div class="o_amunet_hub_card o_amunet_hub_card_lg"
                 t-on-click="() => this.abrirAccionXml('amunet_lista_verificacion.action_lista_verificacion')">
                <i class="fa fa-check-square-o fa-2x mb-2" style="color:#b7791f"/>
                <span class="o_amunet_hub_label">Lista de Verificación</span>
                <t t-if="!state.loading">
                    <span t-attf-class="o_amunet_hub_badge {{ state.listas > 0 ? 'badge-active' : 'badge-empty' }}">
                        <t t-esc="state.listas"/> en proceso
                    </span>
                </t>
                <t t-else="">
                    <span class="o_amunet_hub_badge badge-empty">&#8212;</span>
                </t>
            </div>

            <!-- Informes de Auditoría -->
            <div class="o_amunet_hub_card o_amunet_hub_card_lg"
                 t-on-click="() => this.abrirAccionXml('amunet_informe_auditoria.action_informe_auditoria')">
                <i class="fa fa-file-pdf-o fa-2x mb-2" style="color:#c53030"/>
                <span class="o_amunet_hub_label">Informes de Auditoría</span>
                <t t-if="!state.loading">
                    <span t-attf-class="o_amunet_hub_badge {{ state.informes > 0 ? 'badge-active' : 'badge-empty' }}">
                        <t t-esc="state.informes"/> en borrador
                    </span>
                </t>
                <t t-else="">
                    <span class="o_amunet_hub_badge badge-empty">&#8212;</span>
                </t>
            </div>

        </div>

    </div>
</t>
</templates>
