<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cc_rechazo_wizard_form" model="ir.ui.view">
        <field name="name">amunet.cc.rechazo.wizard.form</field>
        <field name="model">amunet.cc.rechazo.wizard</field>
        <field name="arch" type="xml">
            <form string="Rechazar control de cambios">
                <sheet>
                    <group>
                        <field name="cc_id" invisible="1"/>
                        <field name="motivo" string="Motivo del rechazo"
                               placeholder="Describe el motivo por el que se rechaza este control de cambios..."
                               rows="4"/>
                        <field name="password" string="Contraseña / PIN"
                               password="True"
                               placeholder="Tu contraseña de Odoo o PIN de firma"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirmar" string="Confirmar rechazo"
                            type="object" class="btn-danger"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cc_rechazo_wizard" model="ir.actions.act_window">
        <field name="name">Rechazar control de cambios</field>
        <field name="res_model">amunet.cc.rechazo.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
