<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_production_plan_form" model="ir.ui.view">
        <field name="name">amunet.production.plan.form</field>
        <field name="model">amunet.production.plan</field>
        <field name="arch" type="xml">
            <form string="Plan de produccion">
                <header>
                    <button name="action_compute" type="object" string="Calcular plan"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_create_mos" type="object" string="Crear ordenes en borrador"
                            class="btn-primary" invisible="state != 'computed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,computed,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_shortages" type="object" class="oe_stat_button"
                                icon="fa-exclamation-triangle" invisible="shortage_count == 0">
                            <field name="shortage_count" widget="statinfo" string="Faltantes MP"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="De donde sale la demanda">
                            <field name="demand_source"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Que quiero cubrir">
                            <field name="horizon_days"/>
                            <field name="safety_days"/>
                            <field name="stock_basis"/>
                            <field name="mp_basis"/>
                            <field name="only_with_bom"/>
                            <field name="categ_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group col="4" string="Resumen">
                        <field name="line_count" string="Productos con demanda"/>
                        <field name="to_produce_count" string="A producir"/>
                        <field name="to_buy_count" string="A comprar"/>
                        <field name="blocked_count" string="Bloqueados por MP"/>
                        <field name="pending_qc_count" string="Con stock sin liberar"/>
                        <field name="shortage_count" string="Materias primas faltantes"/>
                    </group>
                    <notebook>
                        <page string="Plan por producto" name="lines">
                            <field name="line_ids" readonly="1">
                                <list decoration-danger="status in ('blocked','nosource')"
                                      decoration-warning="status == 'partial'"
                                      decoration-info="status == 'buy'"
                                      decoration-success="status == 'ok'">
                                    <field name="product_id"/>
                                    <field name="supply_mode" string="Origen"/>
                                    <field name="categ_id" optional="hide"/>
                                    <field name="qty_history" string="Vendido"/>
                                    <field name="qty_daily" string="Diario" optional="hide"/>
                                    <field name="qty_need" string="Necesidad"/>
                                    <field name="qty_on_hand" string="Disponible"/>
                                    <field name="qty_free" string="Existencia total" optional="hide"/>
                                    <field name="qty_released" string="Liberado" optional="hide"/>
                                    <field name="qty_pending_qc" string="Sin liberar"/>
                                    <field name="qty_wip" string="En produccion"/>
                                    <field name="qty_suggested" string="Sugerido"/>
                                    <field name="mp_coverage" string="Cobertura MP %" widget="progressbar"/>
                                    <field name="qty_to_produce" string="A producir" sum="Total"/>
                                    <field name="qty_to_buy" string="A comprar" sum="Total"/>
                                    <field name="blocking_note" string="Nota"/>
                                    <field name="status"/>
                                    <field name="production_id" optional="show"/>
                                    <field name="bom_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Faltantes de materia prima" name="shortages">
                            <field name="shortage_ids" readonly="1">
                                <list>
                                    <field name="product_id"/>
                                    <field name="qty_required"/>
                                    <field name="qty_available"/>
                                    <field name="qty_missing" sum="Total faltante"/>
                                    <field name="seller_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_production_plan_list" model="ir.ui.view">
        <field name="name">amunet.production.plan.list</field>
        <field name="model">amunet.production.plan</field>
        <field name="arch" type="xml">
            <list string="Planes de produccion">
                <field name="name"/>
                <field name="demand_source"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="horizon_days"/>
                <field name="line_count"/>
                <field name="to_produce_count"/>
                <field name="to_buy_count"/>
                <field name="blocked_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_production_plan_shortage_list" model="ir.ui.view">
        <field name="name">amunet.production.plan.shortage.list</field>
        <field name="model">amunet.production.plan.shortage</field>
        <field name="arch" type="xml">
            <list string="Faltantes de materia prima">
                <field name="plan_id"/>
                <field name="product_id"/>
                <field name="qty_required"/>
                <field name="qty_available"/>
                <field name="qty_missing" sum="Total"/>
                <field name="seller_id"/>
            </list>
        </field>
    </record>

    <record id="action_production_plan" model="ir.actions.act_window">
        <field name="name">Plan de produccion sugerido</field>
        <field name="res_model">amunet.production.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea un plan</p>
            <p>Elige de donde leer la demanda, cuantos dias quieres cubrir y presiona
               <b>Calcular plan</b>. El sistema resta lo que ya tienes en almacen y lo que
               ya esta en produccion, explota la lista de materiales y te dice cuanto se
               puede producir de verdad con la materia prima disponible.</p>
        </field>
    </record>

    <record id="action_production_plan_shortage" model="ir.actions.act_window">
        <field name="name">Faltantes de materia prima</field>
        <field name="res_model">amunet.production.plan.shortage</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
