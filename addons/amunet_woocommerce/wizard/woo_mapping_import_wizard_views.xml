<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_woo_mapping_import_wizard_form" model="ir.ui.view">
        <field name="name">amunet.woo.mapping.import.wizard.form</field>
        <field name="model">amunet.woo.mapping.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar mapeo de SKU Woo - Odoo">
                <group invisible="state != 'draft'">
                    <div class="alert alert-info" role="alert">
                        Columnas esperadas: <b>woo_id, woo_sku, titulo, piezas,
                        odoo_default_code, odoo_track, odoo_use_exp, confianza,
                        metodo, justificacion</b>.<br/>
                        El producto Odoo se busca por <b>default_code</b> exacto
                        (nunca se inventan coincidencias) y el mapeo se actualiza
                        por <b>ID Woo</b>: reimportar el mismo archivo no duplica
                        registros. La columna <b>piezas</b> se importa como
                        inventario disponible observado; no se usa como
                        equivalencia de caja. Los productos Odoo no encontrados
                        se conservan como vínculos pendientes.
                    </div>
                    <group>
                        <field name="company_id"
                               groups="base.group_multi_company"/>
                        <field name="backend_id"/>
                        <field name="snapshot_date"/>
                        <field name="data_file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>
                </group>
                <group invisible="state != 'done'">
                    <group>
                        <field name="created_count"/>
                        <field name="updated_count"/>
                        <field name="not_found_count"/>
                        <field name="error_count"/>
                    </group>
                    <group string="Detalle">
                        <field name="report" nolabel="1" readonly="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_import" type="object"
                            string="Importar" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_back" type="object"
                            string="Nueva importación"
                            invisible="state != 'done'"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_woo_mapping_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar mapeo CSV (Woo - Odoo)</field>
        <field name="res_model">amunet.woo.mapping.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
