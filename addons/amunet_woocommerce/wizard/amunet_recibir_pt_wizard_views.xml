<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_amunet_recibir_pt_wizard_form" model="ir.ui.view">
        <field name="name">amunet.recibir.pt.wizard.form</field>
        <field name="model">amunet.recibir.pt.wizard</field>
        <field name="arch" type="xml">
            <form string="Recibir entrega de Producción">
                <group>
                    <group>
                        <field name="entrega_id" invisible="1"/>
                        <field name="production_id"/>
                        <field name="lot_id"/>
                    </group>
                    <group>
                        <field name="qty_entregada"/>
                        <field name="qty_contada"/>
                    </group>
                </group>
                <div class="text-muted">
                    Cuenta el material y escribe lo que de verdad estás recibiendo.
                    Si no coincide con lo que entregó Producción, cierra esta
                    ventana y usa <b>Rechazar entrega</b>: el material regresa
                    completo y ellos vuelven a entregar.
                </div>
                <footer>
                    <button name="action_confirmar" type="object"
                            string="Recibir e ingresar a existencias"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
