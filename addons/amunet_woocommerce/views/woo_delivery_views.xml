<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_woo_delivery_list" model="ir.ui.view">
        <field name="name">amunet.woo.delivery.list</field>
        <field name="model">amunet.woo.delivery</field>
        <field name="arch" type="xml">
            <list string="Entregas de material"
                  decoration-danger="sin_liberacion and not authorized_by"
                  decoration-warning="sin_liberacion and authorized_by"
                  decoration-success="state == 'recibida'"
                  decoration-muted="state in ('rechazada', 'cancelada')">
                <field name="delivered_date"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="lot_number"/>
                <field name="tipo"/>
                <field name="quantity_delivered"/>
                <field name="quantity_received"/>
                <field name="delivered_by"/>
                <field name="received_by" optional="show"/>
                <field name="sin_liberacion" string="SIN liberación"
                       widget="boolean_toggle" readonly="1"/>
                <field name="authorized_by" string="Autorizó" optional="show"/>
                <field name="vendible" widget="boolean_toggle" readonly="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'por_recibir'"
                       decoration-success="state == 'recibida'"
                       decoration-danger="state == 'rechazada'"/>
                <field name="company_id" optional="hide"
                       groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_woo_delivery_form" model="ir.ui.view">
        <field name="name">amunet.woo.delivery.form</field>
        <field name="model">amunet.woo.delivery</field>
        <field name="arch" type="xml">
            <form string="Entrega de material">
                <header>
                    <button name="action_recibir" type="object"
                            string="Confirmar recepción" class="btn-primary"
                            invisible="state != 'por_recibir'"
                            groups="amunet_woocommerce.group_woo_revisor"/>
                    <button name="action_rechazar" type="object"
                            string="Rechazar entrega" class="btn-warning"
                            confirm="¿Rechazar completa esta entrega para aclararla?"
                            invisible="state != 'por_recibir'"
                            groups="amunet_woocommerce.group_woo_revisor"/>
                    <button name="action_autorizar" type="object"
                            string="Autorizar venta sin liberación"
                            class="btn-danger"
                            confirm="Vas a autorizar que se venda material SIN la liberación de Calidad (liberación bajo concesión). Quedará registrado con tu nombre. ¿Continuar?"
                            invisible="not sin_liberacion or authorized_by"
                            groups="amunet_woocommerce.group_woo_autoriza_concesion"/>
                    <button name="action_cancelar" type="object"
                            string="Cancelar" class="btn-secondary"
                            confirm="¿Cancelar esta entrega?"
                            invisible="state in ('recibida', 'cancelada')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="por_recibir,recibida"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert"
                         invisible="not sin_liberacion or authorized_by">
                        <b>SIN LIBERACIÓN DE CALIDAD.</b>
                        Este material se puede recibir físicamente, pero
                        <b>NO es vendible</b> ni se publica a la tienda
                        mientras Calidad no libere el lote o alguien con
                        facultad (PM/Calidad) lo autorice expresamente.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not sin_liberacion or not authorized_by">
                        <b>VENDIBLE BAJO CONCESIÓN.</b>
                        El lote NO está liberado por Calidad. Se autorizó su
                        venta bajo la responsabilidad de
                        <field name="authorized_by" readonly="1"
                               class="oe_inline"/>
                        el
                        <field name="authorized_date" readonly="1"
                               class="oe_inline"/>.
                        Calidad debe regularizarlo (ISO 13485 8.3).
                    </div>
                    <div class="oe_title">
                        <h1><field name="display_label" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Origen (orden de fabricación)">
                            <field name="production_id"
                                   readonly="state != 'por_recibir'"/>
                            <field name="product_id" readonly="1"/>
                            <field name="lot_id" readonly="1"/>
                            <field name="lot_number" readonly="1"/>
                            <field name="expiration_month" readonly="1"/>
                            <field name="expiration_year" readonly="1"/>
                        </group>
                        <group string="Entrega (Acondicionado)">
                            <field name="tipo"
                                   readonly="state != 'por_recibir'"/>
                            <field name="quantity_delivered"
                                   readonly="state != 'por_recibir'"/>
                            <field name="delivered_by"/>
                            <field name="delivered_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Recepción (almacén de venta)">
                            <field name="quantity_received"
                                   string="Piezas que contaste"
                                   readonly="state != 'por_recibir'"/>
                            <field name="received_by"/>
                            <field name="received_date"/>
                            <field name="reception_id" readonly="1"/>
                        </group>
                        <group string="Calidad">
                            <field name="sin_liberacion" readonly="1"/>
                            <field name="vendible" readonly="1"/>
                            <field name="authorized_by" readonly="1"
                                   invisible="not authorized_by"/>
                            <field name="authorized_date" readonly="1"
                                   invisible="not authorized_by"/>
                            <field name="authorization_note"
                                   placeholder="Motivo de la autorización..."
                                   invisible="not sin_liberacion"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="rejection_reason"
                           placeholder="Motivo del rechazo..."
                           invisible="state != 'rechazada' and not rejection_reason"/>
                    <field name="notes" placeholder="Notas de la entrega..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_woo_delivery_search" model="ir.ui.view">
        <field name="name">amunet.woo.delivery.search</field>
        <field name="model">amunet.woo.delivery</field>
        <field name="arch" type="xml">
            <search string="Entregas de material">
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="lot_number"/>
                <field name="delivered_by"/>
                <filter name="por_recibir" string="Por recibir"
                        domain="[('state', '=', 'por_recibir')]"/>
                <filter name="recibida" string="Recibidas"
                        domain="[('state', '=', 'recibida')]"/>
                <filter name="rechazada" string="Rechazadas"
                        domain="[('state', '=', 'rechazada')]"/>
                <separator/>
                <filter name="sin_liberacion" string="SIN liberación de Calidad"
                        domain="[('sin_liberacion', '=', True)]"/>
                <filter name="retenido" string="Retenido (no vendible)"
                        domain="[('vendible', '=', False)]"/>
                <filter name="concesion" string="Vendible bajo concesión"
                        domain="[('sin_liberacion', '=', True),
                                 ('authorized_by', '!=', False)]"/>
                <separator/>
                <filter name="group_state" string="Estado"
                        context="{'group_by': 'state'}"/>
                <filter name="group_product" string="Producto"
                        context="{'group_by': 'product_id'}"/>
                <filter name="group_delivered_by" string="Quien entregó"
                        context="{'group_by': 'delivered_by'}"/>
            </search>
        </field>
    </record>

    <record id="action_woo_delivery" model="ir.actions.act_window">
        <field name="name">Entregas de material</field>
        <field name="res_model">amunet.woo.delivery</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_por_recibir': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay entregas de material.</p>
            <p>Acondicionado registra la entrega desde la orden de fabricación
               (completa o parcial) y el almacén de venta cuenta y confirma lo
               que recibió.</p>
        </field>
    </record>

    <menuitem id="menu_woo_delivery"
              name="Entregas de material"
              parent="menu_amunet_woo_root"
              action="action_woo_delivery"
              sequence="11"/>

    <!-- Botones de Acondicionado en la orden de fabricación -->
    <record id="view_mrp_production_form_woo_entrega" model="ir.ui.view">
        <field name="name">mrp.production.form.woo.entrega</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_amunet_entrega_completa" type="object"
                        string="Entrega completa" class="btn-primary"
                        groups="amunet_woocommerce.group_woo_acondicionado"/>
                <button name="action_amunet_entrega_parcial" type="object"
                        string="Entrega parcial" class="btn-secondary"
                        groups="amunet_woocommerce.group_woo_acondicionado"/>
            </xpath>
        </field>
    </record>

</odoo>
