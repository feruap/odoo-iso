<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_woo_backend_list" model="ir.ui.view">
        <field name="name">amunet.woo.backend.list</field>
        <field name="model">amunet.woo.backend</field>
        <field name="arch" type="xml">
            <list string="Tiendas WooCommerce">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="environment"/>
                <field name="store_url"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-danger="state == 'error'"/>
                <field name="auto_sync"/>
                <field name="last_sync_date"/>
            </list>
        </field>
    </record>

    <record id="view_woo_backend_form" model="ir.ui.view">
        <field name="name">amunet.woo.backend.form</field>
        <field name="model">amunet.woo.backend</field>
        <field name="arch" type="xml">
            <form string="Tienda WooCommerce">
                <header>
                    <button name="action_test_connection" type="object"
                            string="Probar conexion" class="btn-primary"
                            groups="amunet_woocommerce.group_woo_manager"/>
                    <button name="action_import_products" type="object"
                            string="Importar catalogo Woo"
                            invisible="state != 'connected'"
                            groups="amunet_woocommerce.group_woo_manager"/>
                    <button name="action_sync_stock" type="object"
                            string="Publicar existencias ahora"
                            invisible="state != 'connected'"
                            confirm="Se publicaran las existencias de Odoo en WooCommerce. ¿Continuar?"
                            groups="amunet_woocommerce.group_woo_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_mappings" type="object"
                                class="oe_stat_button" icon="fa-exchange">
                            <field name="mapping_count" widget="statinfo" string="Mapeos"/>
                        </button>
                        <button name="action_view_logs" type="object"
                                class="oe_stat_button" icon="fa-history">
                            <field name="log_count" widget="statinfo" string="Bitacora"/>
                        </button>
                    </div>
                    <group>
                        <group string="Tienda">
                            <field name="name"/>
                            <field name="environment"/>
                            <field name="store_url" placeholder="https://tst.amunet.com.mx"/>
                            <field name="active"/>
                        </group>
                        <group string="Credenciales API REST"
                               groups="amunet_woocommerce.group_woo_manager">
                            <field name="consumer_key" password="True"/>
                            <field name="consumer_secret" password="True"/>
                            <field name="connection_message"/>
                        </group>
                    </group>
                    <group>
                        <group string="Inventario">
                            <field name="warehouse_id"/>
                            <field name="stock_field"/>
                        </group>
                        <group string="Sincronizacion">
                            <field name="auto_sync"/>
                            <field name="last_sync_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_woo_backend" model="ir.actions.act_window">
        <field name="name">Tiendas WooCommerce</field>
        <field name="res_model">amunet.woo.backend</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Conecta una tienda WooCommerce</p>
            <p>Captura la URL y las llaves de la API REST (Ajustes &gt; Avanzado &gt; API REST en WooCommerce).</p>
        </field>
    </record>
</odoo>
