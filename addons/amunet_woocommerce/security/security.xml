<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_woo_user" model="res.groups">
        <field name="name">WooCommerce / Consulta</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">
            Puede consultar tiendas conectadas, mapeos de productos y bitacora de sincronizacion.
        </field>
    </record>

    <record id="group_woo_manager" model="res.groups">
        <field name="name">WooCommerce / Responsable</field>
        <field name="implied_ids" eval="[(4, ref('amunet_woocommerce.group_woo_user'))]"/>
        <field name="comment">
            Administra la conexion con WooCommerce, credenciales y ejecuta sincronizaciones.
        </field>
    </record>
</odoo>
