<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ======================================================== -->
        <!-- Grupos: Consulta < Revisor < Administrador               -->
        <!-- ======================================================== -->

        <record id="group_woo_consulta" model="res.groups">
            <field name="name">WooCommerce / Consulta</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Solo lectura: consulta mapeos, snapshots, perfiles de proceso
                largo, tiendas y bitácora. No puede editar nada del módulo.
            </field>
        </record>

        <record id="group_woo_revisor" model="res.groups">
            <field name="name">WooCommerce / Revisor</field>
            <field name="implied_ids" eval="[(4, ref('amunet_woocommerce.group_woo_consulta'))]"/>
            <field name="comment">
                Lectura y edición de la relación/confirmación del mapeo
                (producto Odoo, estado, confianza, método, notas y
                clasificación). No puede
                editar backend, logs, snapshots ni configuración larga.
            </field>
        </record>

        <record id="group_woo_admin" model="res.groups">
            <field name="name">WooCommerce / Administrador</field>
            <field name="implied_ids" eval="[(4, ref('amunet_woocommerce.group_woo_revisor'))]"/>
            <field name="comment">
                Configuración de tiendas y credenciales, importación CSV,
                sincronización GET, carga de snapshots y perfiles de proceso
                largo.
            </field>
        </record>

        <!-- Grupo restringido: SOLO quien se asigne puede ver/mover el
             marcador "Línea larga" (Tipo de Fabricación). Por decisión de
             Mery, la membresía se controla a mano (solo Mery). -->
        <record id="group_linea_larga_editor" model="res.groups">
            <field name="name">WooCommerce / Editor Línea larga</field>
            <field name="comment">
                Único que puede ver y mover el marcador "Línea larga" que
                define el Tipo de Fabricación. Membresía restringida (Mery).
            </field>
        </record>

        <!-- ======================================================== -->
        <!-- Reglas multiempresa (globales)                            -->
        <!-- ======================================================== -->

        <record id="rule_woo_backend_company" model="ir.rule">
            <field name="name">Woo tiendas: multiempresa</field>
            <field name="model_id" ref="model_amunet_woo_backend"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_woo_product_mapping_company" model="ir.rule">
            <field name="name">Woo mapeos: multiempresa</field>
            <field name="model_id" ref="model_amunet_woo_product_mapping"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_woo_stock_snapshot_company" model="ir.rule">
            <field name="name">Woo snapshots: multiempresa</field>
            <field name="model_id" ref="model_amunet_woo_stock_snapshot"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_woo_long_process_company" model="ir.rule">
            <field name="name">Woo procesos largos: multiempresa</field>
            <field name="model_id" ref="model_amunet_woo_long_process"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_woo_sync_log_company" model="ir.rule">
            <field name="name">Woo bitácora: multiempresa</field>
            <field name="model_id" ref="model_amunet_woo_sync_log"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_woo_reception_company" model="ir.rule">
            <field name="name">Woo recepciones para venta: multiempresa</field>
            <field name="model_id" ref="model_amunet_woo_reception"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
