<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Enlace automatico Odoo <-> tienda de productos nuevos: lee el
             catalogo Woo y confirma solo los mapeos de SKU exacto y unico que
             nadie ha revisado. Parametro amunet_woocommerce.auto_mapeo=off lo apaga. -->
        <record id="cron_woo_auto_mapeo" model="ir.cron">
            <field name="name">Amunet Woo: enlazar productos nuevos (SKU exacto)</field>
            <field name="model_id" ref="amunet_woocommerce.model_amunet_woo_backend"/>
            <field name="state">code</field>
            <field name="code">model._cron_amunet_auto_mapeo()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
