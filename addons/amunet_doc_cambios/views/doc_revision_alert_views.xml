<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_doc_revision_alert_list" model="ir.ui.view">
        <field name="name">amunet.doc.revision.alert.list</field>
        <field name="model">amunet.doc.revision.alert</field>
        <field name="arch" type="xml">
            <list string="Alertas (legacy)">
                <field name="name"/>
                <field name="production_name"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_doc_revision_alert_form" model="ir.ui.view">
        <field name="name">amunet.doc.revision.alert.form</field>
        <field name="model">amunet.doc.revision.alert</field>
        <field name="arch" type="xml">
            <form string="Alerta legacy">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="production_name" readonly="1"/>
                        <field name="state"/>
                    </group>
                    <field name="summary" readonly="1" widget="html"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_doc_revision_alert" model="ir.actions.act_window">
        <field name="name">Alertas legacy</field>
        <field name="res_model">amunet.doc.revision.alert</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
