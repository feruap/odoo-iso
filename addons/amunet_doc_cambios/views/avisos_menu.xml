<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción: abrir wizard para crear nuevo aviso -->
    <record id="action_nuevo_aviso" model="ir.actions.act_window">
        <field name="name">Nuevo aviso</field>
        <field name="res_model">amunet.reporte.cambio.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Acción: lista de todos los avisos (solo Diana / supervisor) -->
    <record id="action_avisos_lista" model="ir.actions.act_window">
        <field name="name">Avisos enviados</field>
        <field name="res_model">amunet.aviso.produccion</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú padre: Avisos (visible a Calidad + Alondra + Alma) -->
    <record id="menu_avisos_root" model="ir.ui.menu">
        <field name="name">Avisos</field>
        <field name="parent_id" ref="mrp.menu_mrp_root"/>
        <field name="sequence">30</field>
        <field name="action" ref="action_nuevo_aviso"/>
        <field name="group_ids" eval="[
            (4, ref('amunet_quality.group_quality_user')),
            (4, ref('amunet_quality.group_quality_supervisor')),
            (4, ref('amunet_quality.group_quality_manager')),
            (4, ref('amunet_doc_cambios.group_aviso_produccion_user')),
        ]"/>
    </record>

    <!-- Submenú: Ver todos los avisos (solo Diana / Supervisor QC) -->
    <record id="menu_avisos_todos" model="ir.ui.menu">
        <field name="name">Avisos enviados</field>
        <field name="parent_id" ref="menu_avisos_root"/>
        <field name="sequence">20</field>
        <field name="action" ref="action_avisos_lista"/>
        <field name="group_ids" eval="[
            (4, ref('amunet_quality.group_quality_supervisor')),
            (4, ref('amunet_quality.group_quality_manager')),
        ]"/>
    </record>
</odoo>
