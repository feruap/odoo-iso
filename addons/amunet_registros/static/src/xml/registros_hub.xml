<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Hub propio de Registros de formatos -->
    <t t-name="amunet_registros.RegistrosHub">
        <div class="o_view_controller">
            <div class="container py-5">
                <h3 class="mb-1 fw-bold">Registros de formatos</h3>
                <p class="text-muted mb-4">Selecciona el registro que quieres capturar o consultar.</p>
                <div class="row g-4">

                    <div class="col-12">
                        <h6 class="text-uppercase text-muted fw-semibold mb-2" style="letter-spacing:.05em">
                            Indumentaria — PNOGE-007
                        </h6>
                    </div>

                    <div class="col-md-6">
                        <div class="card h-100 shadow-sm border-0 lm-card"
                             t-on-click="() => this.openAction('amunet_registros.action_entrega_vest')">
                            <div class="card-body d-flex align-items-center gap-3 py-4 px-4">
                                <i class="fa fa-tshirt fa-2x" style="color:#0d6efd"/>
                                <div>
                                    <h5 class="card-title mb-1">Entrega de indumentaria</h5>
                                    <p class="card-text text-muted small mb-0">
                                        F-GE-007/001 — Registro de entrega de bata y zapatos por persona
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card h-100 shadow-sm border-0 lm-card"
                             t-on-click="() => this.openAction('amunet_registros.action_revision_vest')">
                            <div class="card-body d-flex align-items-center gap-3 py-4 px-4">
                                <i class="fa fa-check-square-o fa-2x" style="color:#198754"/>
                                <div>
                                    <h5 class="card-title mb-1">Revisión de indumentaria</h5>
                                    <p class="card-text text-muted small mb-0">
                                        F-GE-007/002 — Supervisión de indumentaria por turno
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </t>

    <!-- Agrega tarjeta "Registros de formatos" al hub principal de Lista maestra -->
    <t t-name="amunet_documentos.ListaMaestraHub"
       t-inherit="amunet_documentos.ListaMaestraHub"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('row')]" position="inside">
            <div class="col-md-6">
                <div class="card h-100 shadow-sm border-0 lm-card"
                     t-on-click="() => this.openAction('amunet_registros.action_registros_hub')">
                    <div class="card-body d-flex align-items-center gap-3 py-4 px-4">
                        <i class="fa fa-folder-open-o fa-2x" style="color:#fd7e14"/>
                        <div>
                            <h5 class="card-title mb-1">Registros de formatos</h5>
                            <p class="card-text text-muted small mb-0">
                                Captura digital de formatos del sistema de calidad
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </t>

</templates>
