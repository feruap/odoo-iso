<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
          Respaldo: cierra sesiones olvidadas aunque nadie vuelva a tocar la
          tablet (fin de turno, tablet apagada). Sin esto, una sesion abierta
          dejaria que alguien mas firmara a nombre de quien se fue.
        -->
        <record id="cron_cerrar_sesiones_kiosco" model="ir.cron">
            <field name="name">Kiosco soluciones: cerrar sesiones inactivas</field>
            <field name="model_id" ref="model_amunet_kiosco_sesion"/>
            <field name="state">code</field>
            <field name="code">model._cron_cerrar_inactivas()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
