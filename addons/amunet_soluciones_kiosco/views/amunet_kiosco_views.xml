<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ Captura de PIN ============ -->
    <record id="view_kiosco_pin_wizard_form" model="ir.ui.view">
        <field name="name">amunet.kiosco.pin.wizard.form</field>
        <field name="model">amunet.kiosco.pin.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="production_id" invisible="1"/>
                <field name="accion" invisible="1"/>
                <div class="text-center mb-3">
                    <h2><field name="titulo" readonly="1" nolabel="1"/></h2>
                    <div class="text-muted" invisible="not operador_actual_id">
                        Elaboracion abierta por
                        <b><field name="operador_actual_id" readonly="1" nolabel="1"/></b>
                    </div>
                </div>
                <group>
                    <field name="pin" password="True" nolabel="1"
                           placeholder="Escribe tu PIN"
                           class="text-center" style="font-size:2rem;"/>
                </group>
                <div class="text-muted text-center">
                    Tu PIN dice quien eres. Lo que quede en el expediente lleva
                    tu nombre, no el de la tablet.
                </div>
                <footer>
                    <button name="action_confirmar" type="object"
                            string="Confirmar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============ Sesiones de kiosco (consulta) ============ -->
    <record id="view_kiosco_sesion_list" model="ir.ui.view">
        <field name="name">amunet.kiosco.sesion.list</field>
        <field name="model">amunet.kiosco.sesion</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'activa'">
                <field name="production_id"/>
                <field name="operador_id" widget="many2one_avatar_user"/>
                <field name="dispositivo_uid" string="Tablet"/>
                <field name="inicio"/>
                <field name="ultima_actividad"/>
                <field name="fin" optional="show"/>
                <field name="motivo_cierre" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'activa'"/>
            </list>
        </field>
    </record>

    <record id="view_kiosco_sesion_search" model="ir.ui.view">
        <field name="name">amunet.kiosco.sesion.search</field>
        <field name="model">amunet.kiosco.sesion</field>
        <field name="arch" type="xml">
            <search>
                <field name="production_id"/>
                <field name="operador_id"/>
                <filter name="f_activas" string="Activas"
                        domain="[('state','=','activa')]"/>
                <filter name="g_operador" string="Quien elabora"
                        context="{'group_by':'operador_id'}"/>
                <filter name="g_estado" string="Estado"
                        context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_kiosco_sesiones" model="ir.actions.act_window">
        <field name="name">Sesiones de kiosco</field>
        <field name="res_model">amunet.kiosco.sesion</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_kiosco_sesion_search"/>
    </record>

    <!-- ============ Pantalla de inicio de la tablet ============ -->
    <!-- La tablet es un dispositivo de piso, no un escritorio: debe abrir
         directo en el trabajo. Se asigna como accion de inicio del usuario
         (Preferencias > Accion inicial), NO como menu, para no alterar la
         navegacion de nadie mas.
         Se dejo el dominio en route_type porque la regla de registro ya filtra
         igual: si algun dia cambia la regla, esto no abre de mas. -->

    <!-- ============ Lista de soluciones ============
         La accion "Soluciones" existia desde el inicio pero nunca se le colgo
         un menu: era inalcanzable. Alondra reportaba "no veo ninguna orden" y
         tenia razon, no habia puerta. Se agrega el menu y una lista propia,
         porque la lista generica de fabricacion no muestra ni el lote de
         solucion, ni el pH, ni el estado de supervision.
    -->
    <record id="view_mrp_production_solucion_list" model="ir.ui.view">
        <field name="name">mrp.production.solucion.list</field>
        <field name="model">mrp.production</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <list string="Soluciones" default_order="amunet_supervision_state desc, date_start desc">
                <field name="name" string="Orden"/>
                <field name="product_id" string="Solucion"/>
                <field name="solution_lot_id" string="Lote"/>
                <field name="product_qty" string="Cantidad" sum="Total"/>
                <field name="product_uom_id" string="Unidad"/>
                <field name="amunet_ph_final" string="pH final"/>
                <field name="solution_expiration_date" string="Caduca"/>
                <field name="amunet_solucion_terminada" string="Terminada" widget="boolean_toggle" readonly="1"/>
                <field name="amunet_supervisor_id" string="Supervisor" optional="show"/>
                <field name="amunet_supervision_state" string="Supervision" widget="badge"
                       decoration-warning="amunet_supervision_state == 'requested'"
                       decoration-success="amunet_supervision_state == 'done'"/>
                <field name="state" string="Estado" widget="badge"/>
                <field name="amunet_is_supervisor" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_mrp_production_solucion_search" model="ir.ui.view">
        <field name="name">mrp.production.solucion.search</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Orden"/>
                <field name="product_id" string="Solucion"/>
                <field name="solution_lot_id" string="Lote"/>
                <filter name="f_mi_supervision" string="Pendientes de mi supervision"
                        domain="[('amunet_supervision_state','=','requested'),
                                 ('amunet_supervisor_id','=',uid)]"/>
                <filter name="f_por_supervisar" string="Esperando supervision"
                        domain="[('amunet_supervision_state','=','requested')]"/>
                <filter name="f_abiertas" string="Abiertas"
                        domain="[('state','in',('draft','confirmed','progress','to_close'))]"/>
                <filter name="f_terminadas" string="Elaboracion completa"
                        domain="[('state','in',('to_close','done'))]"/>
                <filter name="f_sin_ph" string="Sin pH capturado"
                        domain="[('amunet_ph_final','=',0)]"/>
                <filter name="g_producto" string="Solucion"
                        context="{'group_by':'product_id'}"/>
                <filter name="g_estado" string="Estado"
                        context="{'group_by':'state'}"/>
                <filter name="g_superv" string="Supervision"
                        context="{'group_by':'amunet_supervision_state'}"/>
            </search>
        </field>
    </record>

    <record id="action_kiosco_ordenes" model="ir.actions.act_window">
        <field name="name">Soluciones</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('route_type','=','solution')]</field>
        <field name="search_view_id" ref="view_mrp_production_solucion_search"/>
        <field name="context">{'default_route_type': 'solution', 'search_default_f_abiertas': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aqui se elaboran las soluciones</p>
        </field>
    </record>

    <!-- ============ Botones en la orden de solucion ============ -->
    <record id="view_mrp_production_kiosco" model="ir.ui.view">
        <field name="name">mrp.production.form.kiosco</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="kiosco_es_dispositivo" invisible="1"/>
                <!--
                    Todo lo que menciona kiosco_operador_id lleva el mismo
                    groups= que el campo. Si no, para un usuario de almacen el
                    campo desaparece pero la condicion que lo nombra se queda,
                    y la vista truena por referirse a algo que no existe.
                -->
                <field name="kiosco_operador_id" invisible="1"
                       groups="amunet_production.group_solution_maker,amunet_soluciones_kiosco.group_kiosco_soluciones"/>
                <button name="action_kiosco_iniciar" type="object"
                        string="Iniciar elaboracion (PIN)" class="btn-primary"
                        groups="amunet_production.group_solution_maker,amunet_soluciones_kiosco.group_kiosco_soluciones"
                        invisible="not kiosco_es_dispositivo or not amunet_is_solution_product or kiosco_operador_id"/>
                <button name="action_kiosco_supervision" type="object"
                        string="Enviar a supervision (PIN)" class="btn-primary"
                        groups="amunet_production.group_solution_maker,amunet_soluciones_kiosco.group_kiosco_soluciones"
                        invisible="not kiosco_es_dispositivo or not amunet_is_solution_product or not kiosco_operador_id"/>
                <button name="action_kiosco_analisis" type="object"
                        string="Solicitar analisis (PIN)"
                        invisible="not kiosco_es_dispositivo or not amunet_is_solution_product"/>
                <button name="action_kiosco_producir" type="object"
                        string="Producir (PIN)"
                        invisible="not kiosco_es_dispositivo or not amunet_is_solution_product"/>
            </xpath>
            <!-- Quien esta trabajando, SIEMPRE visible en la tablet -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info text-center mb-0"
                     role="status"
                     groups="amunet_production.group_solution_maker,amunet_soluciones_kiosco.group_kiosco_soluciones"
                     invisible="not kiosco_es_dispositivo or not kiosco_operador_id">
                    <h3 class="mb-0">
                        Trabajando: <field name="kiosco_operador_id" readonly="1" nolabel="1"/>
                    </h3>
                    <small>La sesion se cierra sola tras 10 minutos sin actividad.</small>
                </div>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_kiosco_sesiones"
              name="Sesiones de kiosco"
              parent="mrp.menu_mrp_manufacturing"
              action="action_kiosco_sesiones"
              groups="amunet_production.group_solution_maker"
              sequence="90"/>

    <!-- La tablet NO elige linea de produccion: solo hace soluciones.
         A nivel de datos ya estaba bloqueado (la regla de registro filtra por
         route_type), pero el desplegable seguia ofreciendo las 4 lineas y al
         guardar fallaba con AccessError. No se debe ofrecer lo que se va a
         rechazar: confunde y parece un hueco.
         Se hereda de la vista de amunet_process_inspection, que es la que
         declara el campo; la vista base de mrp NO lo tiene. -->
    <!-- QUIEN FABRICA no se cambia a mano en el kiosco.
         El Responsable de una orden de solucion es la persona que la elabora,
         y en la tableta esa persona se identifica con su PIN: el flujo del
         kiosco lo escribe solo (_amunet_set_responsable_solucion, que va en
         sudo, asi que un readonly en la vista no lo estorba).
         Sin esto, con la orden en borrador el campo quedaba editable desde la
         tableta y cualquiera podia poner el nombre de otra persona como quien
         fabrico la solucion. En un registro regulado eso no puede depender de
         la buena fe: si el PIN es la firma, el campo no se toca a mano.
         Pedido por Mery, 09-sep-2026. -->
    <!-- En el KIOSCO solo existen las versiones con PIN.
         Los botones normales del flujo de soluciones no piden firma: quien
         entra con su propia cuenta ya esta identificado por la sesion. Pero en
         una tableta compartida eso deja un hueco: se puede enviar a
         supervision, pedir analisis o producir SIN firmar, saltandose justo lo
         que el PIN protege.
         Se ocultan en el dispositivo de kiosco. Ahi quedan solo los cuatro
         botones (PIN), que hacen lo mismo pero dejando constancia de quien fue.
         Pedido por Mery, 09-sep-2026. -->
    <record id="view_mrp_production_kiosco_sin_botones_normales" model="ir.ui.view">
        <field name="name">mrp.production.form.kiosco.sin.botones.normales</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="amunet_production.view_mrp_production_form_amunet_inherit"/>
        <field name="arch" type="xml">
            <button name="action_amunet_request_supervision" position="attributes">
                <attribute name="invisible">kiosco_es_dispositivo or not amunet_is_solution_product or amunet_supervision_state != 'none' or state not in ('confirmed','progress','to_close') or not amunet_solucion_terminada</attribute>
            </button>
            <!-- Odoo 19 trae CINCO botones button_mark_done en este formulario.
                 Tanto <button name=...> como un xpath simple localizan UN solo
                 nodo, asi que hay que parchear los cinco por posicion. Los que
                 quedaban sin tapar producian desde la tablet sin pedir PIN, y
                 el expediente salia a nombre de la tablet. Detectado 14-sep-2026.

                 Se usa add + separator para SUMAR la condicion a la nativa:
                 reemplazarla rompia la logica de Odoo para fabricacion normal.

                 La defensa real esta en el modelo (button_mark_done); esto solo
                 evita que el boton se ofrezca. -->
            <xpath expr="(//button[@name='button_mark_done'])[1]" position="attributes">
                <attribute name="invisible" add="kiosco_es_dispositivo" separator=" or "/>
            </xpath>
            <xpath expr="(//button[@name='button_mark_done'])[2]" position="attributes">
                <attribute name="invisible" add="kiosco_es_dispositivo" separator=" or "/>
            </xpath>
            <xpath expr="(//button[@name='button_mark_done'])[3]" position="attributes">
                <attribute name="invisible" add="kiosco_es_dispositivo" separator=" or "/>
            </xpath>
            <xpath expr="(//button[@name='button_mark_done'])[4]" position="attributes">
                <attribute name="invisible" add="kiosco_es_dispositivo" separator=" or "/>
            </xpath>
            <xpath expr="(//button[@name='button_mark_done'])[5]" position="attributes">
                <attribute name="invisible" add="kiosco_es_dispositivo" separator=" or "/>
            </xpath>
            <button name="action_request_analysis" position="attributes">
                <attribute name="invisible">kiosco_es_dispositivo or state not in ('to_close','done') or amunet_sys_req_qc == False or amunet_es_desarrollo or (quality_analysis_status in ('requested', 'approved') and amunet_pt_qty_sin_analizar &lt;= 0)</attribute>
            </button>
        </field>
    </record>

    <record id="view_mrp_production_kiosco_responsable" model="ir.ui.view">
        <field name="name">mrp.production.form.kiosco.responsable</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="amunet_production.view_mrp_production_form_amunet_inherit"/>
        <field name="arch" type="xml">
            <field name="user_id" position="attributes">
                <attribute name="readonly">kiosco_es_dispositivo or amunet_user_is_warehouse or (state != 'draft' and not amunet_user_is_mery)</attribute>
            </field>
        </field>
    </record>

    <record id="view_mrp_production_kiosco_ruta" model="ir.ui.view">
        <field name="name">mrp.production.form.kiosco.ruta</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="amunet_process_inspection.view_mrp_production_form_inspection"/>
        <field name="arch" type="xml">
            <field name="route_type" position="attributes">
                <attribute name="readonly">kiosco_es_dispositivo</attribute>
                <!-- force_save: en Odoo, el valor de un campo READONLY no se
                     envia al guardar. El onchange del producto SI ponia
                     'solution' al elegir una solucion, pero como aqui el campo
                     esta bloqueado para el dispositivo, ese valor se descartaba
                     y la orden quedaba con el default 'short'. Resultado: la
                     tableta creaba la orden en LINEA CORTA y despues no la veia
                     (la regla de registro filtra por route_type).
                     Con force_save el operador sigue SIN poder cambiar la
                     linea (que era la intencion) pero el valor que calcula
                     el sistema si se conserva.
                     Reportado por Mery, 09-sep-2026: "al hacer una nueva la
                     manda a linea corta". Solo pasaba al crear desde el menu de
                     Fabricacion; desde el kiosco no, porque ahi el contexto ya
                     trae default_route_type=solution. -->
                <attribute name="force_save">1</attribute>
            </field>
        </field>
    </record>


    <!-- El menu que faltaba. Cuelga de Produccion > Operaciones, junto a
         "Ordenes de fabricacion", y solo lo ven los fabricantes de soluciones
         y quien administre produccion. -->
    <menuitem id="menu_soluciones_ordenes"
              name="Soluciones"
              parent="mrp.menu_mrp_manufacturing"
              action="action_kiosco_ordenes"
              groups="amunet_production.group_solution_maker"
              sequence="5"/>

</odoo>
