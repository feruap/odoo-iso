<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════ LISTA MAESTRA ════════════ -->
    <record id="view_copia_controlada_list" model="ir.ui.view">
        <field name="name">amunet.copia.controlada.list</field>
        <field name="model">amunet.copia.controlada</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'recibida'"
                  decoration-warning="state == 'pendiente'">
                <field name="clave"/>
                <field name="no_analisis" string="No. Análisis"/>
                <field name="producto_id" string="Producto"/>
                <field name="lote" string="Lote"/>
                <field name="dictamen" string="Dictamen"
                    decoration-success="dictamen == 'pass'"
                    decoration-danger="dictamen == 'fail'"
                    decoration-muted="dictamen == 'not_applicable'"/>
                <field name="fecha_autorizacion" string="Autorizado"/>
                <field name="fecha_generacion" string="Emitida"/>
                <field name="receptor_id" string="Para"/>
                <field name="firma_receptor_id" string="Firmado por" optional="show"/>
                <field name="fecha_firma_recepcion" string="Fecha firma" optional="show"/>
                <field name="state" widget="badge"
                    decoration-warning="state == 'pendiente'"
                    decoration-success="state == 'recibida'"/>
            </list>
        </field>
    </record>

    <!-- ════════════ FORMULARIO ════════════ -->
    <record id="view_copia_controlada_form" model="ir.ui.view">
        <field name="name">amunet.copia.controlada.form</field>
        <field name="model">amunet.copia.controlada</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                        statusbar_visible="pendiente,recibida"/>
                </header>
                <sheet>
                    <!-- Banner cuando está pendiente de firma -->
                    <div class="alert alert-warning mb-4" role="alert"
                         invisible="state != 'pendiente'">
                        <i class="fa fa-clock-o me-2"/>
                        Esta copia controlada está pendiente de tu firma de recepción.
                    </div>

                    <div class="oe_title">
                        <h1><field name="clave" readonly="1"/></h1>
                    </div>

                    <!-- Datos del certificado -->
                    <group string="Datos del Análisis">
                        <group>
                            <field name="check_id" readonly="1"/>
                            <field name="no_analisis" readonly="1"/>
                            <field name="producto_id" readonly="1"/>
                            <field name="lote" readonly="1"/>
                        </group>
                        <group>
                            <field name="dictamen" readonly="1"
                                decoration-success="dictamen == 'pass'"
                                decoration-danger="dictamen == 'fail'"/>
                            <field name="fecha_autorizacion" readonly="1"/>
                            <field name="fecha_generacion" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Distribución"/>
                    <group>
                        <group>
                            <field name="receptor_id"/>
                        </group>
                        <group>
                            <field name="observaciones" colspan="2"/>
                        </group>
                    </group>

                    <!-- Firma de recepción -->
                    <separator string="Acuse de Recepción"/>
                    <group>
                        <group string="Firma del responsable de Documentación">
                            <field name="firma_receptor_id" readonly="1"/>
                            <field name="fecha_firma_recepcion" readonly="1"/>
                            <field name="puede_firmar" invisible="1"/>
                            <button name="action_firmar_recepcion" type="object"
                                string="Firmar recepción con PIN"
                                icon="fa-pen"
                                class="btn-primary btn-sm"
                                invisible="not puede_firmar"/>
                            <div invisible="firma_receptor_id" class="text-muted small">
                                Pendiente de firma
                            </div>
                        </group>
                    </group>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ════════════ BÚSQUEDA ════════════ -->
    <record id="search_copia_controlada" model="ir.ui.view">
        <field name="name">amunet.copia.controlada.search</field>
        <field name="model">amunet.copia.controlada</field>
        <field name="arch" type="xml">
            <search>
                <field name="clave"/>
                <field name="no_analisis"/>
                <field name="producto_id"/>
                <field name="lote"/>
                <separator/>
                <filter name="pendiente" string="Pendientes de firma"
                    domain="[('state','=','pendiente')]"/>
                <filter name="recibida" string="Recibidas"
                    domain="[('state','=','recibida')]"/>
                <separator/>
                <filter name="aprobados" string="Análisis aprobados"
                    domain="[('dictamen','=','pass')]"/>
                <filter name="rechazados" string="Análisis rechazados"
                    domain="[('dictamen','=','fail')]"/>
                <separator/>
                <filter name="group_dictamen" string="Dictamen"
                    context="{'group_by': 'dictamen'}"/>
                <filter name="group_producto" string="Producto"
                    context="{'group_by': 'producto_id'}"/>
                <filter name="group_mes" string="Mes de emisión"
                    context="{'group_by': 'fecha_generacion:month'}"/>
            </search>
        </field>
    </record>

    <!-- ════════════ ACCIÓN ════════════ -->
    <record id="action_copia_controlada" model="ir.actions.act_window">
        <field name="name">Lista Maestra de Copias Controladas</field>
        <field name="res_model">amunet.copia.controlada</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_pendiente": 1}</field>
        <field name="search_view_id" ref="search_copia_controlada"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Las copias controladas aparecen aquí automáticamente cuando
                Calidad finaliza un análisis.
            </p>
        </field>
    </record>

</odoo>
