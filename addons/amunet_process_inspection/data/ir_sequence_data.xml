<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Secuencia INP/MMAA/NNN con consecutivo reseteado cada mes.
            use_date_range=True + date_ranges mensuales (se crearan
            automaticamente al primer create de cada mes).
        -->
        <record id="seq_amunet_process_inspection" model="ir.sequence">
            <field name="name">Inspeccion de proceso</field>
            <field name="code">amunet.process.inspection</field>
            <field name="prefix">INP/%(month)s%(y)s/</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
