<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Pestana nueva 'Inspecciones de proceso' en el formulario de
        mrp.production + boton smartbutton arriba.
    -->
    <record id="view_mrp_production_form_inspection" model="ir.ui.view">
        <field name="name">mrp.production.form.process.inspection</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- Smart button para ver inspecciones rapido -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_process_inspections"
                        type="object" class="oe_stat_button"
                        icon="fa-check-square-o"
                        invisible="process_inspection_count == 0">
                    <field name="process_inspection_count"
                           string="Controles" widget="statinfo"/>
                </button>
            </xpath>

            <!--
                Mostrar el tipo de linea (route_type) y el flag de
                aprobacion del preflight en la cabecera.
            -->
            <xpath expr="//field[@name='product_id']" position="before">
                <field name="route_type"
                       readonly="state != 'draft'"/>
                <field name="preflight_approved" readonly="1"
                       widget="boolean_toggle"
                       invisible="state != 'draft'"
                       help="True si existe un preflight aprobado para esta orden. Requisito DURO para confirmar."/>
            </xpath>

            <!--
                Gate visual del preflight:
                Cuando route_type es 'short' o 'long' y todavia no se
                aprobo el preflight, ocultar los botones que SI tienen
                funcion (Confirmar, Asignar, Planificar) para que el
                usuario solo pueda Validar piloto o Cancelar.

                NOTA: action_start, do_unreserve, button_unplan y
                button_mark_done NO se tocan aqui. Su visibilidad la
                controla amunet_production (los dos primeros se ocultan
                siempre porque cada workorder tiene su propio inicio;
                button_unplan y button_mark_done se controlan via campo
                amunet_can_produce y por reglas nativas).
            -->
            <xpath expr="//button[@name='action_confirm']" position="attributes">
                <attribute name="invisible">state != 'draft' or amunet_is_solution_product or (not preflight_approved and route_type in ('short','long'))</attribute>
            </xpath>
            <xpath expr="//button[@name='action_assign']" position="attributes">
                <attribute name="invisible">state in ('draft','done','cancel') or not reserve_visible or (not preflight_approved and route_type in ('short','long'))</attribute>
            </xpath>
            <xpath expr="//button[@name='button_plan']" position="attributes">
                <attribute name="invisible">state not in ('confirmed','progress','to_close') or not workorder_ids or is_planned or (not preflight_approved and route_type in ('short','long'))</attribute>
                <attribute name="groups">amunet_production.group_production_supervisor</attribute>
            </xpath>
            <xpath expr="//button[@name='button_unplan']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Pestana al final del notebook: dos bloques SEPARADOS.
                 Una Supervision NO es una inspeccion. -->
            <xpath expr="//notebook" position="inside">
                <page string="Controles en proceso"
                      name="process_inspections">
                    <separator string="Inspecciones en proceso (las firma Calidad)"/>
                    <field name="inspection_qc_ids" nolabel="1" readonly="1">
                        <list decoration-info="state == 'draft'"
                              decoration-success="state == 'signed' and result == 'conforme'"
                              decoration-warning="state == 'signed' and result == 'conforme_con_retiros'"
                              decoration-danger="state == 'signed' and result == 'detener'">
                            <field name="name"/>
                            <field name="workorder_id" string="Actividad"/>
                            <field name="workcenter_id"/>
                            <field name="inspection_date"/>
                            <field name="inspector_id"/>
                            <field name="qty_inspected"/>
                            <field name="qty_removed"/>
                            <field name="result"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                    <separator string="Supervisiones (las firma el Supervisor de Produccion)"/>
                    <field name="inspection_sup_ids" nolabel="1" readonly="1">
                        <list decoration-info="state == 'draft'"
                              decoration-success="state == 'signed' and result == 'conforme'"
                              decoration-warning="state == 'signed' and result == 'conforme_con_retiros'"
                              decoration-danger="state == 'signed' and result == 'detener'">
                            <field name="name"/>
                            <field name="workorder_id" string="Actividad"/>
                            <field name="workcenter_id"/>
                            <field name="inspection_date"/>
                            <field name="inspector_id"/>
                            <field name="qty_inspected"/>
                            <field name="qty_removed"/>
                            <field name="result"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
