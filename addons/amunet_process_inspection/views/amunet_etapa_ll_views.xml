<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Etapa de linea larga en la ficha del producto -->
    <record id="view_product_template_etapa_ll" model="ir.ui.view">
        <field name="name">product.template.form.amunet.etapa.ll</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="amunet_production.view_product_template_form_amunet_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amunet_req_quality_control']" position="after">
                <field name="amunet_etapa_ll"/>
            </xpath>
        </field>
    </record>
    <!-- La caducidad de un vial la manda el granel, no el teclado -->
    <record id="view_mrp_production_caducidad_vial" model="ir.ui.view">
        <field name="name">mrp.production.form.amunet.caducidad.vial</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="amunet_production.view_mrp_production_form_amunet_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amunet_expiration_text']" position="before">
                <field name="amunet_es_llenado_vial" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='amunet_expiration_text']" position="attributes">
                <attribute name="readonly">amunet_es_llenado_vial or (amunet_is_solution_product and not amunet_es_desarrollo)</attribute>
                <attribute name="help">En el Llenado de Viales la caducidad se toma del lote de solucion a granel que se envasa: la del vial nunca puede ser mas larga que la del contenido.</attribute>
            </xpath>
        </field>
    </record>
</odoo>
