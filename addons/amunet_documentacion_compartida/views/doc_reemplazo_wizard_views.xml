<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_doc_reemplazo_wizard_form" model="ir.ui.view">
        <field name="name">amunet.doc.reemplazo.wizard.form</field>
        <field name="model">amunet.doc.reemplazo.wizard</field>
        <field name="arch" type="xml">
            <form string="Reemplazar PDF">
                <sheet>
                    <div class="alert alert-warning d-flex align-items-center gap-2" role="alert">
                        <i class="fa fa-exclamation-triangle fa-lg"/>
                        <div>
                            Estás a punto de reemplazar el PDF de
                            <strong><field name="doc_name" readonly="1" nolabel="1"/></strong>.<br/>
                            La revisión anterior se borrará y se notificará a Calidad
                            para que revisen los cambios.
                        </div>
                    </div>
                    <group>
                        <field name="nuevo_archivo" widget="binary"
                               filename="nuevo_filename"
                               options="{'accept': '.pdf'}"
                               string="Nuevo PDF"/>
                        <field name="nuevo_filename" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirmar" type="object"
                            string="Confirmar y notificar a Calidad"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
