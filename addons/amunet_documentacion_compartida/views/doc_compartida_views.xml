        <field name="domain">[('categoria', '=', 'equipos')]</field>
        <field name="context">{'default_categoria': 'equipos'}</field>
        <field name="view_id" ref="view_doc_compartida_list"/>
    </record>

    <!-- Acción general -->
    <record id="action_doc_compartida_all" model="ir.actions.act_window">
        <field name="name">Documentación Compartida</field>
        <field name="res_model">amunet.doc.compartida</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_doc_compartida_list"/>
    </record>

    <!-- ── ACCIONES: SUBMATRICES LFIA ───────────────────────── -->
    <record id="action_lfia_sangre" model="ir.actions.act_window">
