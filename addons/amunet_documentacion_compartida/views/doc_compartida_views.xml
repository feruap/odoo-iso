<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── VISTA LISTA ──────────────────────────────────────── -->
    <record id="view_doc_compartida_list" model="ir.ui.view">
        <field name="name">amunet.doc.compartida.list</field>
        <field name="model">amunet.doc.compartida</field>
        <field name="arch" type="xml">
            <list string="Documentos"
                  decoration-success="state == 'aprobado'"
                  decoration-info="state == 'por_aprobar'"
                  decoration-warning="state == 'pendiente'">

                <!-- Auxiliares para condiciones -->
                <field name="obs_requeridas"    column_invisible="1"/>
                <field name="es_responsable"    column_invisible="1"/>
                <field name="soy_revisor_activo" column_invisible="1"/>
                <field name="pdf_descargable"   column_invisible="1"/>

                <!-- ── PDF: visible solo si el usuario puede descargar ── -->
                <field name="manual_file" string="PDF"
                       filename="manual_filename" widget="binary"
                       readonly="1" optional="show"
                       invisible="not pdf_descargable"/>
                <button name="action_reemplazar_pdf" type="object"
                        string="🔄"
                        title="Reemplazar PDF"
                        class="btn-sm btn-outline-secondary"
                        invisible="not manual_file or not es_responsable"
                        groups="amunet_documentacion_compartida.group_doc_validacion"/>
                <button name="action_eliminar_manual" type="object"
                        string="🗑️"
                        title="Eliminar manual"
                        class="btn-sm btn-outline-danger"
                        confirm="¿Eliminar este manual completo? Se borrará también su historial. Esta acción no se puede deshacer."
                        invisible="not es_responsable"
                        groups="amunet_documentacion_compartida.group_doc_validacion"/>
                <field name="manual_filename" column_invisible="1"/>

                <!-- ── FECHA PROGRAMADA (solo Jorge puede editar) ── -->
                <field name="fecha_programada" string="Fecha programada"
                       readonly="not es_responsable" optional="show"/>

                <!-- ── TOMAR REVISIÓN ── -->
                <button name="action_tomar_revision" type="object"
                        string="▶ Tomar revisión"
                        class="btn-sm btn-outline-primary"
                        invisible="soy_revisor_activo or state == 'aprobado'"
                        groups="amunet_documentacion_compartida.group_doc_revisor,amunet_documentacion_compartida.group_doc_validacion"/>

                <!-- Auxiliares para condición de bloqueo cruzado y revisión cerrada -->
                <field name="observaciones"    column_invisible="1"/>
                <field name="revision_cerrada" column_invisible="1"/>

                <!-- ── REVISIÓN CALIDAD ──
                     Cada criterio tiene dos botones 📝:
                     - Sin confirm: revisión activa (revision_cerrada = False)
                     - Con confirm: revisión cerrada, alerta antes de cambiar -->

                <!-- Precauciones -->
                <field name="rev_materiales" string="Precauciones"
                       widget="badge"
                       decoration-success="rev_materiales == 'ok'"
                       decoration-danger="rev_materiales == 'fail'"
                       readonly="1" optional="show"/>
                <button name="action_marcar_materiales" type="object"
                        string="📝" title="Marcar Precauciones"
                        invisible="revision_cerrada or (rev_materiales != 'fail' and
                                   (rev_volumenes == 'fail' or rev_tiempos == 'fail' or rev_interpretacion == 'fail' or rev_adicional == 'fail') and
                                   not observaciones)"
                        class="btn-link btn-sm p-0"
                        groups="amunet_documentacion_compartida.group_doc_revisor,amunet_documentacion_compartida.group_doc_validacion"/>
                <button name="action_marcar_materiales" type="object"
                        string="📝" title="Marcar Precauciones"
                        confirm="Esta revisión ya fue cerrada. ¿Deseas modificar el criterio Precauciones?"
                        invisible="not revision_cerrada"
                        class="btn-link btn-sm p-0"
                        groups="amunet_documentacion_compartida.group_doc_revisor,amunet_documentacion_compartida.group_doc_validacion"/>

                <!-- Volúmenes de reactivos -->
                <field name="rev_volumenes" string="Vol. de reactivos"
                       widget="badge"
                       decoration-success="rev_volumenes == 'ok'"
                       decoration-danger="rev_volumenes == 'fail'"
                       readonly="1" optional="show"/>
                <button name="action_marcar_volumenes" type="object"
                        string="📝" title="Marcar Vol. de reactivos"
                        invisible="revision_cerrada or (rev_volumenes != 'fail' and
                                   (rev_materiales == 'fail' or rev_tiempos == 'fail' or rev_interpretacion == 'fail' or rev_adicional == 'fail') and
                                   not observaciones)"
                        class="btn-link btn-sm p-0"
                        groups="amunet_documentacion_compartida.group_doc_revisor,amunet_documentacion_compartida.group_doc_validacion"/>
                <button name="action_marcar_volumenes" type="object"
                        string="📝" title="Marcar Vol. de reactivos"
                        confirm="Esta revisión ya fue cerrada. ¿Deseas modificar el criterio Volúmenes?"
                        invisible="not revision_cerrada"
                        class="btn-link btn-sm p-0"
                        groups="amunet_documentacion_compartida.group_doc_revisor,amunet_documentacion_compartida.group_doc_validacion"/>

                <!-- Tiempos de interpretación -->
                <field name="rev_tiempos" string="Tiempos de interpret."
                       widget="badge"
                       decoration-success="rev_tiempos == 'ok'"
                       decoration-danger="rev_tiempos == 'fail'"
                       readonly="1" optional="show"/>
                <button name="action_marcar_tiempos" type="object"
                        string="📝" title="Marcar Tiempos"
                        invisible="revision_cerrada or (rev_tiempos != 'fail' and
                                   (rev_materiales == 'fail' or rev_volumenes == 'fail' or rev_interpretacion == 'fail' or rev_adicional == 'fail') and
                                   not observaciones)"
                        class="btn-link btn-sm p-0"
                        groups="amunet_documentacion_compartida.group_doc_revisor,amunet_documentacion_compartida.group_doc_validacion"/>
                <button name="action_marcar_tiempos" type="object"
                        string="📝" title="Marcar Tiempos"
                        confirm="Esta revisión ya fue cerrada. ¿Deseas modificar el criterio Tiempos?"
                        invisible="not revision_cerrada"
                        class="btn-link btn-sm p-0"
                        groups="amunet_documentacion_compartida.group_doc_revisor,amunet_documentacion_compartida.group_doc_validacion"/>

                <!-- Interpretación -->
                <field name="rev_interpretacion" string="Interpretación"
                       widget="badge"
                       decoration-success="rev_interpretacion == 'ok'"
                       decoration-danger="rev_interpretacion == 'fail'"
                       readonly="1" optional="show"/>
                <button name="action_marcar_interpretacion" type="object"
                        string="📝" title="Marcar Interpretación"
                        invisible="revision_cerrada or (rev_interpretacion != 'fail' and
                                   (rev_materiales == 'fail' or rev_volumenes == 'fail' or rev_tiempos == 'fail' or rev_adicional == 'fail') and
                                   not observaciones)"
                        class="btn-link btn-sm p-0"
                        groups="amunet_documentacion_compartida.group_doc_revisor,amunet_documentacion_compartida.group_doc_validacion"/>
                <button name="action_marcar_interpretacion" type="object"
                        string="📝" title="Marcar Interpretación"
                        confirm="Esta revisión ya fue cerrada. ¿Deseas modificar el criterio Interpretación?"
                        invisible="not revision_cerrada"
                        class="btn-link btn-sm p-0"
                        groups="amunet_documentacion_compartida.group_doc_revisor,amunet_documentacion_compartida.group_doc_validacion"/>

                <!-- Adicional -->
                <field name="rev_adicional" string="Adicional"
                       widget="badge"
                       decoration-success="rev_adicional == 'ok'"
                       decoration-danger="rev_adicional == 'fail'"
                       readonly="1" optional="show"/>
                <button name="action_marcar_adicional" type="object"
                        string="📝" title="Marcar Adicional"
                        invisible="revision_cerrada or (rev_adicional != 'fail' and
                                   (rev_materiales == 'fail' or rev_volumenes == 'fail' or rev_tiempos == 'fail' or rev_interpretacion == 'fail') and
                                   not observaciones)"
                        class="btn-link btn-sm p-0"
                        groups="amunet_documentacion_compartida.group_doc_revisor,amunet_documentacion_compartida.group_doc_validacion"/>
                <button name="action_marcar_adicional" type="object"
                        string="📝" title="Marcar Adicional"
                        confirm="Esta revisión ya fue cerrada. ¿Deseas modificar el criterio Adicional?"
                        invisible="not revision_cerrada"
                        class="btn-link btn-sm p-0"
                        groups="amunet_documentacion_compartida.group_doc_revisor,amunet_documentacion_compartida.group_doc_validacion"/>

                <!-- ── ESTATUS ── -->
                <field name="state" string="Estatus"
                       widget="badge"
                       decoration-success="state == 'aprobado'"
                       decoration-info="state == 'por_aprobar'"
                       decoration-warning="state == 'pendiente'"
                       optional="show"/>

                <!-- ── REVISADO POR ── -->
                <field name="revisado_display" string="Revisado por"
                       readonly="1" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ── VISTA FORMULARIO ─────────────────────────────────── -->
    <record id="view_doc_compartida_form" model="ir.ui.view">
        <field name="name">amunet.doc.compartida.form</field>
        <field name="model">amunet.doc.compartida</field>
        <field name="arch" type="xml">
            <form string="Manual">
                <header>
                    <!-- Tomar revisión (solo cuando pendiente y no soy el activo) -->
                    <button name="action_tomar_revision" type="object"
                            string="▶ Tomar revisión"
                            class="btn-primary"
                            invisible="soy_revisor_activo or state == 'aprobado'"
                            groups="amunet_documentacion_compartida.group_doc_revisor,amunet_documentacion_compartida.group_doc_validacion"/>
                    <!-- Aprobar y FIRMAR: solo Diana (Supervisor QC) -->
                    <button name="action_abrir_firma" type="object"
                            string="✍️ Aprobar y firmar"
                            class="btn-primary"
                            invisible="state == 'aprobado' or not revision_completa"
                            groups="amunet_quality.group_quality_supervisor"/>
                    <!-- Reabrir revisión (solo cuando ya está aprobado) -->
                    <button name="action_reabrir_revision" type="object"
                            string="🔄 Reabrir revisión"
                            class="btn-warning"
                            invisible="state != 'aprobado'"
                            groups="amunet_documentacion_compartida.group_doc_revisor,amunet_documentacion_compartida.group_doc_validacion"/>
                    <!-- Actualizar en sistema (cuando aprobado) — solo Diana/Supervisor QC -->
                    <button name="action_actualizar_en_sistema" type="object"
                            string="📤 Actualizar en sistema"
                            class="btn-success"
                            invisible="state != 'aprobado'"
                            groups="amunet_quality.group_quality_supervisor"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pendiente,por_aprobar,aprobado"/>
                </header>
                <sheet>
                    <!-- Auxiliares -->
                    <field name="obs_requeridas"    invisible="1"/>
                    <field name="es_responsable"    invisible="1"/>
                    <field name="es_calidad"        invisible="1"/>
                    <field name="pdf_descargable"   invisible="1"/>
                    <field name="revision_completa" invisible="1"/>
                    <field name="soy_revisor_activo" invisible="1"/>
                    <field name="historial_count"   invisible="1"/>

                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_historial" type="object"
                                class="oe_stat_button" icon="fa-history"
                                invisible="historial_count == 0">
                            <field name="historial_count" string="Revisiones"
                                   widget="statinfo"/>
                        </button>
                        <button name="action_ver_registro_cambios" type="object"
                                class="oe_stat_button" icon="fa-list-alt"
                                invisible="not es_responsable">
                            <span class="o_stat_text">Registro</span>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del manual…"
                                   readonly="not es_responsable"/>
                        </h1>
                    </div>

                    <!-- ── Aviso: otro analista tiene el cerrojo ── -->
                    <div class="alert alert-info d-flex align-items-center gap-2"
                         role="alert"
                         invisible="not revisor_activo_id or soy_revisor_activo or state == 'aprobado'">
                        <i class="fa fa-lock fa-lg"/>
                        <span>
                            <field name="revisor_activo_id" readonly="1" nolabel="1" class="fw-bold"/>
                            está revisando este manual. Haz clic en "Tomar revisión" para
                            continuar tú (el otro analista perderá el acceso).
                        </span>
                    </div>

                    <!-- ── Aviso: tú tienes el cerrojo ── -->
                    <div class="alert alert-success d-flex align-items-center gap-2"
                         role="alert"
                         invisible="not soy_revisor_activo or state == 'aprobado'">
                        <i class="fa fa-check-circle fa-lg"/>
                        <span>Tienes la revisión activa. Puedes marcar los criterios.</span>
                    </div>

                    <!-- ── Aviso: obs pendiente ── -->
                    <div class="alert alert-warning d-flex align-items-center gap-2"
                         role="alert"
                         invisible="not obs_requeridas or observaciones">
                        <i class="fa fa-exclamation-triangle fa-lg"/>
                        <span>
                            Hay un criterio marcado como ✗ Incorrecto.
                            Escribe la observación antes de continuar con los demás.
                        </span>
                    </div>

                    <!-- ── Archivo y fecha ── -->
                    <group string="Archivo">
                        <group>
                            <field name="carpeta_id" readonly="1"/>
                            <field name="fecha_programada"
                                   readonly="not es_responsable"
                                   widget="date"
                                   string="Fecha programada"/>
                        </group>
                        <group>
                            <!-- Un solo campo: editable si es responsable, readonly si no.
                                 Oculto solo si no hay archivo Y no es responsable. -->
                            <field name="manual_file" string="PDF"
                                   filename="manual_filename" widget="binary"
                                   options="{'accept': '.pdf'}"
                                   readonly="not es_responsable"
                                   invisible="not es_responsable and (not pdf_descargable or not manual_file)"/>
                            <field name="manual_filename" invisible="1"/>
                            <!-- Reemplazar: solo Jorge cuando ya hay archivo cargado -->
                            <button name="action_reemplazar_pdf" type="object"
                                    string="🔄 Reemplazar PDF"
                                    class="btn btn-outline-secondary btn-sm mt-1"
                                    invisible="not manual_file or not es_responsable"
                                    groups="amunet_documentacion_compartida.group_doc_validacion"/>
                        </group>
                    </group>

                    <!-- ── Revisión Calidad ── -->
                    <group string="Revisión Calidad">
                        <group>
                            <field name="rev_materiales" string="Precauciones" widget="radio"
                                   readonly="1"/>
                            <field name="rev_volumenes" widget="radio"
                                   readonly="1"/>
                            <field name="rev_tiempos" widget="radio"
                                   readonly="1"/>
                            <field name="rev_adicional" widget="radio"
                                   readonly="1"/>
                        </group>
                        <group>
                            <field name="state" readonly="1" widget="badge"
                                   decoration-success="state == 'aprobado'"
                                   decoration-info="state == 'por_aprobar'"
                                   decoration-warning="state == 'pendiente'"
                                   string="Resultado"/>
                            <field name="revisor_activo_id" readonly="1" string="Revisor activo"/>
                            <field name="revisado_por_id"   readonly="1" string="Cerró revisión"/>
                            <field name="fecha_revision"    readonly="1" string="Fecha y hora"/>
                            <field name="firmante_id" readonly="1" string="Aprobado y firmado por"
                                   invisible="state != 'aprobado'"/>
                            <field name="fecha_firma" readonly="1" string="Fecha de firma"
                                   invisible="state != 'aprobado'"/>
                        </group>
                    </group>

                    <!-- ── Observaciones ── -->
                    <group string="Observaciones">
                        <field name="observaciones"
                               nolabel="1"
                               placeholder="Describe qué debe corregirse…"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── VISTA BÚSQUEDA ───────────────────────────────────── -->
    <record id="view_doc_compartida_search" model="ir.ui.view">
        <field name="name">amunet.doc.compartida.search</field>
        <field name="model">amunet.doc.compartida</field>
        <field name="arch" type="xml">
            <search string="Buscar manuales">
                <field name="name" string="Manual"/>
                <filter name="aprobado" string="Aprobados"
                        domain="[('state','=','aprobado')]"/>
                <filter name="pendiente" string="Pendientes"
                        domain="[('state','=','pendiente')]"/>
                <filter name="con_observaciones" string="Con observaciones"
                        domain="[('obs_requeridas','=',True)]"/>
                <filter name="group_state" string="Por estatus"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ── ACCIÓN SERVIDOR: Borrar PDF (aparece en menú Acciones) ── -->
    <record id="action_server_borrar_pdf" model="ir.actions.server">
        <field name="name">Borrar PDF</field>
        <field name="model_id" ref="model_amunet_doc_compartida"/>
        <field name="binding_model_id" ref="model_amunet_doc_compartida"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('amunet_documentacion_compartida.group_doc_validacion'))]"/>
        <field name="state">code</field>
        <field name="code">
for rec in records:
    if rec.manual_file:
        rec.write({'manual_file': False, 'manual_filename': False})
        rec.message_post(
            body='&#x1F5D1;&#xFE0F; PDF eliminado por &lt;b&gt;%s&lt;/b&gt;.' % env.user.name,
            message_type='notification',
            subtype_xmlid='mail.mt_note',
        )
        </field>
    </record>

    <!-- ── ACCIÓN GENERAL ────────────────────────────────────── -->
    <record id="action_doc_compartida_all" model="ir.actions.act_window">
        <field name="name">Documentación Técnica</field>
        <field name="res_model">amunet.doc.compartida</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_doc_compartida_list"/>
    </record>

</odoo>
