<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── VISTA LISTA ──────────────────────────────────────── -->
    <record id="view_doc_compartida_list" model="ir.ui.view">
        <field name="name">amunet.doc.compartida.list</field>
        <field name="model">amunet.doc.compartida</field>
        <field name="arch" type="xml">
            <list string="Documentos"
                  decoration-success="state == 'aprobado'"
                  decoration-warning="state == 'pendiente'"
                  editable="bottom">

                <!-- Campo auxiliar para readonly condicional -->
                <field name="obs_requeridas" column_invisible="1"/>

                <!-- ── MANUAL ── -->
                <field name="name" string="Manual" optional="show"/>
                <field name="manual_file" string="CARGAR DOCX"
                       filename="manual_filename" widget="binary" optional="show"/>
                <field name="manual_filename" column_invisible="1"/>

                <!-- ── REVISIÓN CALIDAD ── -->
                <field name="rev_materiales" string="Materiales"
                       decoration-success="rev_materiales == 'ok'"
                       decoration-danger="rev_materiales == 'fail'"
                       optional="show"/>
                <field name="rev_volumenes" string="Vol. de reactivos"
                       decoration-success="rev_volumenes == 'ok'"
                       decoration-danger="rev_volumenes == 'fail'"
                       optional="show"/>
                <field name="rev_tiempos" string="Tiempos de interpret."
                       decoration-success="rev_tiempos == 'ok'"
                       decoration-danger="rev_tiempos == 'fail'"
                       optional="show"/>

                <!-- ── OBSERVACIONES ── -->
                <field name="observaciones" string="Observaciones"
                       readonly="not obs_requeridas"
                       optional="show"/>

                <!-- ── ESTATUS ── -->
                <field name="state" string="Estatus"
                       widget="badge"
                       decoration-success="state == 'aprobado'"
                       decoration-warning="state == 'pendiente'"
                       optional="show"/>

                <!-- ── REVISADO POR ── -->
                <field name="revisado_display" string="Revisado por"
                       readonly="1" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ── VISTA FORMULARIO ─────────────────────────────────── -->
    <record id="view_doc_compartida_form" model="ir.ui.view">
        <field name="name">amunet.doc.compartida.form</field>
        <field name="model">amunet.doc.compartida</field>
        <field name="arch" type="xml">
            <form string="Manual">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pendiente,aprobado"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del manual…"/>
                        </h1>
                    </div>

                    <!-- ── Sección: Manual ── -->
                    <group string="Manual">
                        <group>
                            <field name="carpeta_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="manual_file" string="CARGAR DOCX"
                                   filename="manual_filename" widget="binary"/>
                            <field name="manual_filename" invisible="1"/>
                        </group>
                    </group>

                    <!-- ── Sección: Revisión Calidad ── -->
                    <group string="Revisión Calidad">
                        <group>
                            <field name="rev_materiales" widget="radio"/>
                            <field name="rev_volumenes" widget="radio"/>
                            <field name="rev_tiempos" widget="radio"/>
                        </group>
                        <group>
                            <field name="state" readonly="1" widget="badge"
                                   decoration-success="state == 'aprobado'"
                                   decoration-warning="state == 'pendiente'"
                                   string="Resultado"/>
                            <field name="revisado_por_id" readonly="1" string="Revisor (Calidad)"/>
                            <field name="fecha_revision" readonly="1" string="Fecha y hora"/>
                        </group>
                    </group>

                    <!-- ── Sección: Observaciones ── -->
                    <group string="Observaciones">
                        <field name="obs_requeridas" invisible="1"/>
                        <field name="observaciones"
                               nolabel="1"
                               placeholder="Ninguna"
                               readonly="not obs_requeridas"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── VISTA BÚSQUEDA ───────────────────────────────────── -->
    <record id="view_doc_compartida_search" model="ir.ui.view">
        <field name="name">amunet.doc.compartida.search</field>
        <field name="model">amunet.doc.compartida</field>
        <field name="arch" type="xml">
            <search string="Buscar manuales">
                <field name="name" string="Manual"/>
                <filter name="aprobado" string="Aprobados"
                        domain="[('state','=','aprobado')]"/>
                <filter name="pendiente" string="Pendientes"
                        domain="[('state','=','pendiente')]"/>
                <filter name="con_observaciones" string="Con observaciones"
                        domain="[('obs_requeridas','=',True)]"/>
                <filter name="group_state" string="Por estatus"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ── ACCIÓN GENERAL ────────────────────────────────────── -->
    <record id="action_doc_compartida_all" model="ir.actions.act_window">
        <field name="name">Documentación Compartida</field>
        <field name="res_model">amunet.doc.compartida</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_doc_compartida_list"/>
    </record>

</odoo>
