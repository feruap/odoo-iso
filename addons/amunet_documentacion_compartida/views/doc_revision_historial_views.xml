<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_doc_revision_historial_list" model="ir.ui.view">
        <field name="name">amunet.doc.revision.historial.list</field>
        <field name="model">amunet.doc.revision.historial</field>
        <field name="arch" type="xml">
            <list string="Historial de revisiones"
                  create="0" edit="0" delete="0"
                  decoration-success="accion == 'cierre'"
                  decoration-warning="accion == 'reapertura'">
                <field name="fecha" string="Fecha"/>
                <field name="usuario_id" string="Usuario"/>
                <field name="accion" string="Acción" widget="badge"
                       decoration-success="accion == 'cierre'"
                       decoration-warning="accion == 'reapertura'"/>
            </list>
        </field>
    </record>

</odoo>
