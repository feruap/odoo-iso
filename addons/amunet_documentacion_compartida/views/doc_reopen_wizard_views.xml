<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_doc_reopen_wizard_form" model="ir.ui.view">
        <field name="name">amunet.doc.reopen.wizard.form</field>
        <field name="model">amunet.doc.reopen.wizard</field>
        <field name="arch" type="xml">
            <form string="Reabrir revisión">
                <sheet>
                    <div class="alert alert-warning d-flex align-items-center gap-2" role="alert">
                        <i class="fa fa-exclamation-triangle fa-lg"/>
                        <div>
                            Este manual ya fue <strong>APROBADO</strong>.
                            Estás a punto de cambiar su estatus y reiniciar la revisión.<br/>
                            Cerrado por: <field name="cerrado_por_id" readonly="1" nolabel="1" class="fw-bold"/>
                            el <field name="cerrado_en" readonly="1" nolabel="1"/>.<br/><br/>
                            Al confirmar, se notificará a todos los usuarios de Calidad y Validación
                            quién realizó la reapertura.
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirmar" type="object"
                            string="Aceptar y continuar"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
