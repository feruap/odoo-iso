<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_doc_revision_wizard_form" model="ir.ui.view">
        <field name="name">amunet.doc.revision.wizard.form</field>
        <field name="model">amunet.doc.revision.wizard</field>
        <field name="arch" type="xml">
            <form string="Marcar resultado">
                <sheet>
                    <group>
                        <field name="campo_label" string="Criterio" readonly="1"/>
                        <field name="valor_actual" string="Resultado actual"
                               widget="badge"
                               decoration-success="valor_actual == 'ok'"
                               decoration-danger="valor_actual == 'fail'"
                               readonly="1"
                               invisible="not valor_actual"/>
                        <field name="nuevo_valor" string="Resultado" widget="radio"/>
                        <field name="observacion" string="Motivo (obligatorio)"
                               placeholder="Describe qué debe corregirse…"
                               invisible="nuevo_valor != 'fail'"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirmar" type="object"
                            string="Confirmar"
                            class="btn-primary"/>
                    <button special="cancel"
                            string="Cancelar"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
