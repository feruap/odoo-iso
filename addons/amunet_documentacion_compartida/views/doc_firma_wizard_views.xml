<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_doc_firma_wizard_form" model="ir.ui.view">
        <field name="name">amunet.doc.firma.wizard.form</field>
        <field name="model">amunet.doc.firma.wizard</field>
        <field name="arch" type="xml">
            <form string="Aprobar y firmar">
                <group>
                    <field name="doc_id" invisible="1"/>
                    <field name="doc_name" readonly="1"/>
                    <field name="password" password="True"
                           placeholder="Ingresa tu PIN o contraseña de firma"/>
                </group>
                <p class="text-muted">
                    Al firmar, apruebas formalmente este manual (ISO 13485 / CFR 21 Part 11).
                    Quedan registrados tu nombre, fecha y hora.
                </p>
                <footer>
                    <button name="action_firmar" type="object" string="Aprobar y firmar"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
