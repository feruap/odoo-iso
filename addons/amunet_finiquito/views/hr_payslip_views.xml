<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hace editable el campo Estructura en el recibo (borrador) para poder elegir Finiquito -->
    <record id="hr_payslip_form_struct_editable" model="ir.ui.view">
        <field name="name">hr.payslip.form.struct.editable</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='struct_id']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
