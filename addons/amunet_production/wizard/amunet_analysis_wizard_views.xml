<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amunet_analysis_wizard_form" model="ir.ui.view">
        <field name="name">amunet.production.analysis.wizard.form</field>
        <field name="model">amunet.production.analysis.wizard</field>
        <field name="arch" type="xml">
            <form string="Solicitar análisis de producto terminado">
                <alert message="Elige el alcance. Si mandas a analizar solo una parte del lote, indica únicamente esas piezas: el total del lote se va acumulando y el último parcial queda como el total. El análisis completo sí pide el total fabricado." type="info"/>

                <sheet>
                    <group>
                        <group>
                            <field name="production_id" invisible="1"/>
                            <field name="product_id"/>
                            <field name="lote_producido"/>
                            <field name="product_qty"/>
                            <field name="amunet_expiration_text"/>
                        </group>
                        <group string="Alcance">
                            <field name="tipo_analisis" widget="radio"/>
                            <field name="qty_ya_analizada"
                                   invisible="qty_ya_analizada == 0"/>
                            <field name="qty_fabricada"
                                   invisible="tipo_analisis != 'completo'"
                                   required="tipo_analisis == 'completo'"/>
                            <field name="qty_analizada"
                                   invisible="tipo_analisis != 'parcial'"
                                   required="tipo_analisis == 'parcial'"/>
                            <field name="qty_acumulada"
                                   invisible="tipo_analisis != 'parcial'"/>
                        </group>
                    </group>
                </sheet>

                <footer>
                    <button string="Solicitar análisis" name="action_confirm_analysis" type="object" class="btn-success"/>
                    <button string="Cancelar / Regresar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_amunet_analysis_wizard" model="ir.actions.act_window">
        <field name="name">Solicitar análisis de producto terminado</field>
        <field name="res_model">amunet.production.analysis.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
