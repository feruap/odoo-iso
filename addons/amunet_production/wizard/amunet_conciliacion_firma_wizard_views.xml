<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amunet_conciliacion_firma_wizard_form" model="ir.ui.view">
        <field name="name">amunet.conciliacion.firma.wizard.form</field>
        <field name="model">amunet.conciliacion.firma.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar conciliación">
                <div class="alert alert-warning" role="alert">
                    <b>Al confirmar, estas cantidades se descuentan del inventario.</b><br/>
                    No se puede deshacer. Revisa que sean las cantidades reales.
                </div>
                <field name="production_id" invisible="1"/>
                <field name="resumen_html" readonly="1" nolabel="1"/>
                <group>
                    <field name="pin" password="True"
                           placeholder="Tu PIN de firma o tu contraseña"/>
                </group>
                <footer>
                    <button name="action_confirmar" string="Confirmar y descontar"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
