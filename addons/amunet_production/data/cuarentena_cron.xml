<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Genera el analisis de los lotes que ya cumplieron su reposo en
             Control de calidad. Diario: la cuarentena se mide en dias, no en
             horas, asi que revisar mas seguido no adelanta nada. -->
        <record id="cron_amunet_analisis_post_cuarentena" model="ir.cron">
            <field name="name">Cuarentena: generar analisis de lotes que cumplieron</field>
            <field name="model_id" ref="stock.model_stock_lot"/>
            <field name="state">code</field>
            <field name="code">model._cron_amunet_analisis_post_cuarentena()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
