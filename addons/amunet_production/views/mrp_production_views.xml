<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherit mrp.production form view -->
        <record id="view_mrp_production_form_amunet_inherit" model="ir.ui.view">
            <field name="name">mrp.production.form.amunet.inherit</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">

                <!-- Botones de accion en header -->
                <xpath expr="//header" position="inside">
                    <!--
                        Botones del FLUJO DE SURTIDO. Aparecen aqui en
                        la MO (no solo en el workorder) para que el
                        almacenista pueda surtir sin moverse de pantalla.
                        Cada uno delega en el workorder de Surtido (AMP)
                        de esta MO via wrappers de mrp.production.
                    -->
                    <button name="action_amunet_mo_start_supply" string="Iniciar Surtido" type="object" class="oe_highlight"
                            invisible="state not in ('confirmed','progress','to_close') or not amunet_supply_workorder_id or amunet_supply_state != 'pending' or not is_planned"
                            groups="amunet_material_request.group_material_warehouse,amunet_material_request.group_material_manager"/>
                    <button name="action_amunet_mo_confirm_supply" string="Confirmar Surtido" type="object" class="oe_highlight"
                            invisible="not amunet_supply_workorder_id or amunet_supply_state != 'in_progress'"
                            groups="amunet_material_request.group_material_warehouse,amunet_material_request.group_material_manager"/>
                    <button name="action_amunet_mo_receive_supply" string="Recibir / Aceptar entrega" type="object" class="oe_highlight"
                            invisible="not amunet_supply_workorder_id or amunet_supply_state != 'awaiting_reception'"
                            groups="amunet_production.group_production_supervisor"/>

                    <!--
                        'Confirmar analisis' aparece solo cuando la
                        MO esta TERMINADA (to_close o done) y el
                        producto requiere analisis de QC. Es el
                        momento de mandar muestra al laboratorio.
                    -->
                    <button name="action_request_analysis" string="Solicitar análisis" type="object" class="oe_highlight"
                            invisible="state not in ('to_close','done') or amunet_sys_req_qc == False or quality_analysis_status in ('requested', 'approved')"
                            groups="amunet_production.group_production_supervisor"/>
                    <button name="%(amunet_production.action_report_production_zebra_label)d" string="Imprimir Etiqueta" type="action" class="oe_highlight" invisible="not amunet_all_ingredients_valid or amunet_user_is_warehouse"/>
                    <!--
                        'Producir' es el ultimo paso: marca la MO como
                        hecha. Visible solo cuando todas las workorders
                        estan concluidas (done o cancel). Llama al
                        metodo nativo button_mark_done.
                    -->
                    <!-- Botones del flujo de conciliación de materiales -->
                    <button name="action_initiate_reconciliation"
                            string="Iniciar conciliación"
                            type="object" class="oe_highlight"
                            invisible="reconciliation_state != 'pending' or not amunet_has_supplied_moves or state not in ('confirmed','progress','to_close','done') or not amunet_all_workorders_done"
                            groups="amunet_production.group_production_operator,amunet_production.group_production_supervisor"/>
                    <button name="action_validate_reconciliation"
                            string="Validar conciliación"
                            type="object" class="oe_highlight"
                            invisible="reconciliation_state != 'initiated'"
                            groups="amunet_production.group_production_supervisor"/>
                    <button name="action_complete_reconciliation"
                            string="Confirmar devolución recibida"
                            type="object" class="btn-success"
                            invisible="reconciliation_state != 'validated'"
                            groups="amunet_material_request.group_material_warehouse,amunet_material_request.group_material_manager"/>

                    <button name="button_mark_done" string="Producir" type="object" class="oe_highlight" invisible="not amunet_can_produce"/>
                    <field name="amunet_can_produce" invisible="1"/>
                    <field name="amunet_has_supplied_moves" invisible="1"/>
                    <field name="amunet_all_workorders_done" invisible="1"/>
                    <field name="reconciliation_state" invisible="1"/>
                    <field name="reconciliation_has_surplus" invisible="1"/>
                    <field name="amunet_supply_workorder_id" invisible="1"/>
                    <field name="amunet_user_is_warehouse" invisible="1"/>
                    <field name="amunet_supply_state" widget="badge"
                           invisible="not amunet_supply_workorder_id"
                           decoration-info="amunet_supply_state == 'in_progress'"
                           decoration-warning="amunet_supply_state == 'awaiting_reception'"
                           decoration-success="amunet_supply_state == 'received'"/>
                </xpath>

                <!-- Ocultar botones nativos no requeridos -->
                <xpath expr="//button[@name='action_confirm']" position="attributes">
                    <attribute name="invisible">state != 'draft' or amunet_is_solution_product</attribute>
                </xpath>
                <xpath expr="//button[@name='action_start']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@name='do_unreserve']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@name='button_unplan']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!-- Cancelar MOs: SOLO Calidad/Responsable Sanitario (Mery y Fernando).
                     Nadie de produccion (operador/supervisor) ni almacen puede cancelar. -->
                <xpath expr="//button[@name='action_cancel']" position="attributes">
                    <attribute name="invisible">not id or state in ('done', 'cancel')</attribute>
                    <attribute name="groups">amunet_quality.group_quality_sanitary</attribute>
                </xpath>


                <!--
                    Lote: ocultar label en los mismos estados que el
                    campo (incluido 'draft') para que no quede el
                    label huerfano sin valor abajo.
                -->
                <xpath expr="//label[@for='lot_producing_ids']" position="attributes">
                    <attribute name="string">Lote producido</attribute>
                    <attribute name="invisible">state in ('draft', 'cancel') or product_tracking in ('none', False) or (state == 'done' and product_tracking == 'serial' and product_qty &gt; 1)</attribute>
                </xpath>
                <!-- Div contenedor del campo nativo: Oculto en borrador porque no existe lote físico aún -->
                <xpath expr="//div[field[@name='lot_producing_ids']]" position="attributes">
                    <attribute name="invisible">state in ('draft', 'cancel') or product_tracking in ('none', False) or (state == 'done' and product_tracking == 'serial' and product_qty &gt; 1)</attribute>
                </xpath>

                <!--
                    Campo solution_lot_id retirado por completo de la
                    UI. Sigue existiendo en el modelo por
                    compatibilidad (heredado del flujo de Soluciones)
                    pero no se muestra a ningun usuario.
                -->
                <xpath expr="//div[field[@name='lot_producing_ids']]" position="after">
                    <field name="solution_lot_id" invisible="1"/>
                </xpath>

                <!-- Ocultar botón nativo de generar lote en borrador (todas las variantes) -->
                <xpath expr="//button[@name='action_generate_serial'][1]" position="attributes">
                    <attribute name="invisible">state in ('draft', 'cancel') or product_tracking in ('none', 'lot', False) or lot_producing_ids</attribute>
                </xpath>
                <xpath expr="//button[@name='action_generate_serial'][2]" position="attributes">
                    <attribute name="invisible">state in ('draft', 'cancel') or product_tracking in ('none', 'lot', False) or not lot_producing_ids or product_qty == 1</attribute>
                </xpath>
                <xpath expr="//button[@name='action_generate_serial'][3]" position="attributes">
                    <attribute name="invisible">state in ('draft', 'cancel') or product_tracking in ('none', 'serial', False) or lot_producing_ids</attribute>
                </xpath>

                <!-- Campos adicionales debajo del bloque de BoM -->
                <xpath expr="//div[@name='bom_div']" position="after">
                    <label for="quality_ph_initial" string="Control de pH" invisible="quality_ph_initial == 0.0"/>
                    <div class="o_row" invisible="quality_ph_initial == 0.0">
                        Inicial: <field name="quality_ph_initial" readonly="1" force_save="1" style="width:50px"/>
                        | Rango: <field name="amunet_sys_ph_range" readonly="1"/>
                        <!-- pH Final editable y visible solo cuando todos los ingredientes esten validados -->
                        <span invisible="not amunet_all_ingredients_valid">
                            | Final: <field name="quality_ph_final" readonly="0"/>
                        </span>
                    </div>

                    <label for="amunet_expiration_text" string="Caducidad (YYYY-MM)"/>
                    <div class="o_row">
                        <field name="amunet_expiration_text"
                               placeholder="2026-05"
                               force_save="1"/>
                        <field name="solution_expiration_date" invisible="1"/>
                    </div>
                    <field name="quality_analysis_status" readonly="1" force_save="1" decoration-info="quality_analysis_status == 'requested'" decoration-success="quality_analysis_status == 'approved'" decoration-danger="quality_analysis_status == 'rejected'"/>
                    <field name="amunet_all_ingredients_valid" invisible="1"/>
                    <field name="amunet_sys_req_qc" invisible="1"/>
                </xpath>

                <!-- Ocultar pestana Miscelaneo nativa -->
                <xpath expr="//page[@name='miscellaneous']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- Permitir fabricar productos con BoM: soluciones y pruebas rapidas ruta corta. -->
                <xpath expr="//field[@name='product_id']" position="attributes">
                    <attribute name="domain">[('bom_ids', '!=', False)]</attribute>
                </xpath>

                <!-- Categoria del producto seleccionado (solo lectura) -->
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="amunet_product_categ_id" string="Categoria" readonly="1"/>
                    <field name="amunet_is_solution_product" invisible="1"/>
                </xpath>
                <!-- Fecha programada: reemplazar campo nativo por display DD.MM.AA editable -->
                <xpath expr="//div[@name='date_start']/field[@name='date_start']" position="replace">
                    <field name="date_start" invisible="1"/>
                    <field name="amunet_scheduled_date_display"
                           placeholder="DD.MM.AA"
                           force_save="1"/>
                </xpath>

                <!-- TABLA DE INGREDIENTES orden: producto | por consumir | lote | cant.utilizada | disolucion | valido -->

                <!--
                    1. Insertar Lote, Cantidad surtida y el flag
                    invisible que controla si el usuario puede editar
                    consumo. Va DESPUES de la columna visible 'Por
                    consumir'.
                -->
                <xpath expr="//field[@name='move_raw_ids']/list/field[@name='product_uom_qty'][@widget='mrp_should_consume']" position="after">
                    <field name="amunet_user_can_edit_consume" column_invisible="True"/>
                    <field name="amunet_lot_id"
                        domain="[('product_id', '=', product_id)]"
                        context="{'default_product_id': product_id}"
                        options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                        string="Lote"
                        readonly="(parent.amunet_supply_workorder_id and parent.amunet_supply_state != 'in_progress') or parent.state in ('done','cancel')"
                        optional="show"/>
                    <!--
                        Cantidad surtida: editable solo durante el surtido
                        activo (in_progress). Bloqueada antes y despues.
                    -->
                    <field name="amunet_qty_supplied"
                        string="Cantidad surtida"
                        readonly="(parent.amunet_supply_workorder_id and parent.amunet_supply_state != 'in_progress') or parent.state in ('done','cancel')"
                        optional="show"/>
                    <!--
                        Cantidad Utilizada: refleja amunet_qty_used, que se
                        captura SOLO en la conciliacion. Queda vacio (0.00)
                        durante el surtido. Siempre readonly. Sustituye a la
                        columna nativa 'quantity' (que se autollena con lo
                        reservado).
                    -->
                    <field name="amunet_qty_used"
                        string="Cantidad Utilizada"
                        readonly="1"
                        optional="show"/>
                </xpath>

                <!--
                    2. Quitar widget 'mrp_should_consume' (muestra solo
                    la cantidad teorica) y bloquear edicion al almacen
                    en la columna 'Por consumir'.
                -->
                <xpath expr="//field[@name='move_raw_ids']/list/field[@name='product_uom_qty'][@widget='mrp_should_consume']" position="attributes">
                    <attribute name="widget"/>
                    <attribute name="readonly">not amunet_user_can_edit_consume or (parent.state != 'draft' and ((parent.state not in ('confirmed', 'progress', 'to_close') and not parent.is_planned) or (parent.is_locked and state != 'draft')))</attribute>
                </xpath>

                <!-- 2. Renombrar Cantidad Utilizada, asegurar visibilidad
                     y bloquear edicion al almacen. -->
                <xpath expr="//field[@name='move_raw_ids']/list/field[@name='quantity']" position="attributes">
                    <!-- Ocultar la columna nativa 'quantity' (se autollena con
                         lo reservado al planificar). La "Cantidad Utilizada"
                         visible ahora viene de amunet_qty_used, vacia hasta la
                         conciliacion. -->
                    <attribute name="column_invisible">True</attribute>
                    <attribute name="readonly">1</attribute>
                </xpath>

                <!--
                    Disolucion y Valido: columnas especificas del flujo
                    de Soluciones (linea larga). Se ocultan en linea
                    corta usando column_invisible con la flag del
                    producto padre.
                -->
                <xpath expr="//field[@name='move_raw_ids']/list/field[@name='quantity']" position="after">
                    <field name="amunet_dissolution"
                        widget="boolean_toggle"
                        string="Disolucion"
                        column_invisible="not parent.amunet_is_solution_product"/>
                    <field name="amunet_is_valid"
                        widget="boolean"
                        readonly="1"
                        string="Valido"
                        decoration-success="amunet_is_valid == True"
                        decoration-danger="amunet_is_valid == False"
                        column_invisible="not parent.amunet_is_solution_product"/>
                </xpath>

                <!-- Ocultar badge de disponibilidad nativo -->
                <xpath expr="//field[@name='move_raw_ids']/list/field[@name='forecast_availability']" position="attributes">
                    <attribute name="column_invisible">True</attribute>
                </xpath>

                <!--
                    Columna "Detalles" (action_show_details) de componentes:
                    solo la ven almacen y administradores (Mery, Fernando).
                    Produccion pura NO la ve.
                -->
                <xpath expr="//field[@name='move_raw_ids']/list/button[@name='action_show_details'][not(@class)]" position="attributes">
                    <attribute name="invisible">not show_details_visible or has_tracking == 'none' or not parent.amunet_user_can_see_supply_details</attribute>
                </xpath>
                <xpath expr="//field[@name='move_raw_ids']/list/button[@name='action_show_details'][@class='o_optional_button btn']" position="attributes">
                    <attribute name="invisible">has_tracking != 'none' or not show_details_visible or not parent.amunet_user_can_see_supply_details</attribute>
                </xpath>

                <!-- Pestaña de Conciliación de materiales -->
                <xpath expr="//page[@name='miscellaneous']" position="after">
                    <page string="Conciliación de materiales" name="reconciliation"
                          invisible="not amunet_has_supplied_moves">
                        <group>
                            <group string="Estado">
                                <field name="reconciliation_state" widget="badge"
                                       decoration-secondary="reconciliation_state == 'pending'"
                                       decoration-info="reconciliation_state == 'initiated'"
                                       decoration-warning="reconciliation_state == 'validated'"
                                       decoration-success="reconciliation_state == 'completed'"/>
                                <field name="reconciliation_initiated_by" readonly="1" invisible="not reconciliation_initiated_by"/>
                                <field name="reconciliation_initiated_date" readonly="1" invisible="not reconciliation_initiated_date"/>
                                <field name="reconciliation_validated_by" readonly="1" invisible="not reconciliation_validated_by"/>
                                <field name="reconciliation_validated_date" readonly="1" invisible="not reconciliation_validated_date"/>
                                <field name="reconciliation_completed_by" readonly="1" invisible="not reconciliation_completed_by"/>
                                <field name="reconciliation_completed_date" readonly="1" invisible="not reconciliation_completed_date"/>
                            </group>
                            <group string="Notas">
                                <field name="reconciliation_notes" nolabel="1"
                                       readonly="reconciliation_state in ('validated','completed')"
                                       placeholder="Observaciones de la conciliación..."/>
                            </group>
                        </group>
                        <field name="move_raw_ids" nolabel="1" readonly="0"
                               invisible="reconciliation_state == 'pending'">
                            <list string="Materiales" create="0" delete="0" no_open="1" editable="bottom">
                                <field name="product_id" readonly="1"/>
                                <field name="amunet_lot_id" readonly="1" optional="show"/>
                                <field name="product_uom" readonly="1" string="U.M." optional="show"/>
                                <field name="amunet_qty_supplied" readonly="1" string="Surtido"/>
                                <field name="amunet_qty_used" string="Utilizado"
                                       force_save="1"
                                       readonly="parent.reconciliation_state in ('validated','completed')"/>
                                <field name="amunet_qty_surplus" readonly="1" string="Sobrante"
                                       decoration-warning="amunet_qty_surplus &gt; 0"
                                       decoration-success="amunet_qty_surplus == 0"/>
                            </list>
                        </field>
                        <separator string="Material que devolverá Producción (lo que recibirá Almacén)"/>
                        <field name="amunet_return_move_ids" nolabel="1" readonly="1"
                               invisible="reconciliation_state == 'pending'">
                            <list string="Material a devolver" create="0" delete="0" edit="0" no_open="1">
                                <field name="product_id" string="Producto"/>
                                <field name="amunet_lot_id" string="Lote" optional="show"/>
                                <field name="amunet_qty_surplus" string="Cantidad a devolver"
                                       decoration-bf="1" decoration-warning="amunet_qty_surplus &gt; 0"/>
                                <field name="product_uom" string="U.M."/>
                            </list>
                        </field>
                    </page>
                </xpath>

                <!-- Responsable: solo Alma o Alondra -->
                <xpath expr="//field[@name='user_id']" position="attributes">
                    <attribute name="domain">[('login', 'in', ['s.produccion@amunet.com.mx', 'produccionsub@amunet.com.mx'])]</attribute>
                    <attribute name="readonly">amunet_user_is_warehouse</attribute>
                </xpath>

                <!-- Bloqueo completo para almacén: solo puede editar Lote y Cantidad surtida -->
                <xpath expr="//field[@name='product_id']" position="attributes">
                    <attribute name="readonly">amunet_user_is_warehouse or state != 'draft'</attribute>
                </xpath>
                <xpath expr="//field[@name='product_qty']" position="attributes">
                    <attribute name="readonly">amunet_user_is_warehouse</attribute>
                </xpath>
                <xpath expr="//field[@name='lot_producing_ids']" position="attributes">
                    <attribute name="readonly">amunet_user_is_warehouse</attribute>
                </xpath>
                <xpath expr="//div[@name='date_start']/field[@name='amunet_scheduled_date_display']" position="attributes">
                    <attribute name="readonly">amunet_user_is_warehouse</attribute>
                </xpath>
                <xpath expr="//field[@name='quality_ph_final']" position="attributes">
                    <attribute name="readonly">amunet_user_is_warehouse</attribute>
                </xpath>
                <xpath expr="//field[@name='amunet_expiration_text']" position="attributes">
                    <attribute name="readonly">amunet_user_is_warehouse</attribute>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
