<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_workorder_operator_search" model="ir.ui.view">
        <field name="name">mrp.workorder.operator.search</field>
        <field name="model">mrp.workorder</field>
        <field name="arch" type="xml">
            <search string="Mi trabajo de produccion">
                <field name="name"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="workcenter_id"/>
                <filter name="ready" string="Listas para iniciar" domain="[('state', '=', 'ready')]"/>
                <filter name="progress" string="En progreso" domain="[('state', '=', 'progress')]"/>
                <filter name="actionable" string="Accionables" domain="[('state', 'in', ('ready', 'progress'))]"/>
                <filter name="blocked" string="En espera" domain="[('state', '=', 'blocked')]"/>
                <filter name="supply_pending" string="Por surtir"
                        domain="[('amunet_is_supply_workorder', '=', True), ('amunet_supply_state', 'in', ('pending', 'in_progress'))]"/>
                <filter name="supply_reception" string="Por recibir"
                        domain="[('amunet_is_supply_workorder', '=', True), ('amunet_supply_state', '=', 'awaiting_reception')]"/>
                <separator/>
                <filter name="group_workcenter" string="Area" context="{'group_by': 'workcenter_id'}"/>
                <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_mrp_workorder_operator_kanban" model="ir.ui.view">
        <field name="name">mrp.workorder.operator.kanban</field>
        <field name="model">mrp.workorder</field>
        <field name="arch" type="xml">
            <kanban create="0" delete="0" group_create="0" class="o_kanban_mobile o_kanban_dashboard">
                <field name="name"/>
                <field name="state"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="workcenter_id"/>
                <field name="qty_remaining"/>
                <field name="qty_produced"/>
                <field name="is_user_working"/>
                <field name="amunet_operator_next_step"/>
                <field name="amunet_operator_material_status"/>
                <field name="amunet_operator_quality_status"/>
                <field name="amunet_operator_time_status"/>
                <field name="amunet_workqueue_priority"/>
                <field name="amunet_workqueue_owner"/>
                <field name="amunet_workqueue_next_step"/>
                <field name="amunet_workqueue_blocker"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-3">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="text-muted">
                                        <field name="production_id"/>
                                    </div>
                                </div>
                                <span class="badge text-bg-secondary">
                                    <field name="state"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body mt-2">
                                <div><strong>Producto:</strong> <field name="product_id"/></div>
                                <div><strong>Area:</strong> <field name="workcenter_id"/></div>
                                <div class="mt-2"><strong>Siguiente paso:</strong> <field name="amunet_operator_next_step"/></div>
                                <div><strong>Responsable:</strong> <field name="amunet_workqueue_owner"/></div>
                                <div><strong>Cola:</strong> <field name="amunet_workqueue_next_step"/></div>
                                <div t-if="record.amunet_workqueue_blocker.raw_value" class="text-danger">
                                    <strong>Pendiente:</strong> <field name="amunet_workqueue_blocker"/>
                                </div>
                                <div><strong>Materiales:</strong> <field name="amunet_operator_material_status"/></div>
                                <div><strong>Calidad:</strong> <field name="amunet_operator_quality_status"/></div>
                                <div><strong>Tiempo:</strong> <field name="amunet_operator_time_status"/></div>
                                <div class="mt-2">
                                    <strong>Cantidad:</strong>
                                    <field name="qty_produced"/> / <field name="qty_remaining"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-3 d-grid gap-2">
                                <button t-if="record.state.raw_value == 'ready'"
                                        name="action_amunet_operator_start"
                                        type="object"
                                        class="btn btn-primary btn-lg"
                                        string="Iniciar"/>
                                <button t-if="record.state.raw_value == 'progress'"
                                        name="action_amunet_operator_finish"
                                        type="object"
                                        class="btn btn-success btn-lg"
                                        string="Terminar"/>
                                <button name="action_amunet_open_production"
                                        type="object"
                                        class="btn btn-secondary"
                                        string="Ver orden"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_mrp_workorder_operator_list" model="ir.ui.view">
        <field name="name">mrp.workorder.operator.list</field>
        <field name="model">mrp.workorder</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0"
                  decoration-danger="amunet_workqueue_priority == 'blocked'"
                  decoration-warning="amunet_workqueue_priority == 'waiting'"
                  decoration-success="amunet_workqueue_priority == 'ready'"
                  decoration-info="amunet_workqueue_priority == 'progress'">
                <button name="action_amunet_operator_start" type="object" icon="fa-play" title="Iniciar" invisible="state != 'ready'"/>
                <button name="action_amunet_operator_finish" type="object" icon="fa-check" title="Terminar" invisible="state != 'progress'"/>
                <field name="name" string="Operacion"/>
                <field name="production_id" string="Orden de fabricacion"/>
                <field name="product_id" string="Producto"/>
                <field name="workcenter_id" string="Area"/>
                <field name="state" string="Estado"/>
                <field name="amunet_workqueue_priority" string="Prioridad" widget="badge"/>
                <field name="amunet_workqueue_owner" string="Responsable" widget="badge"/>
                <field name="amunet_workqueue_next_step" string="Siguiente paso"/>
                <field name="amunet_workqueue_blocker" string="Bloqueo / pendiente"/>
                <field name="amunet_operator_material_status"/>
                <field name="amunet_operator_quality_status"/>
                <field name="qty_remaining" string="Cantidad por producir"/>
                <field name="qty_produced" string="Cantidad realizada"/>
            </list>
        </field>
    </record>

    <record id="view_mrp_production_operator_form" model="ir.ui.view">
        <field name="name">mrp.production.operator.form</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <form string="Orden de fabricacion" create="0" delete="0" edit="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Orden" readonly="1"/>
                            <field name="product_id" string="Producto" readonly="1"/>
                            <field name="product_qty" string="Cantidad" readonly="1"/>
                            <field name="product_uom_id" string="Unidad" readonly="1"/>
                        </group>
                        <group>
                            <field name="origin" string="Origen" readonly="1"/>
                            <field name="date_start" string="Inicio programado" readonly="1"/>
                            <field name="date_finished" string="Fin programado" readonly="1"/>
                        </group>
                    </group>
                    <group string="Cola de trabajo">
                        <field name="amunet_workqueue_priority" readonly="1" widget="badge"/>
                        <field name="amunet_workqueue_owner" readonly="1" widget="badge"/>
                        <field name="amunet_workqueue_next_step" readonly="1"/>
                        <field name="amunet_workqueue_blocker" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Operaciones">
                            <field name="workorder_ids" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="name" string="Operacion"/>
                                    <field name="workcenter_id" string="Area"/>
                                    <field name="state" string="Estado"/>
                                    <field name="qty_remaining" string="Cantidad por producir"/>
                                    <field name="qty_produced" string="Cantidad realizada"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mrp_workorder_operator_form" model="ir.ui.view">
        <field name="name">mrp.workorder.operator.form</field>
        <field name="model">mrp.workorder</field>
        <field name="arch" type="xml">
            <form string="Trabajo de produccion" create="0" delete="0">
                <header>
                    <!-- Botones del flujo generico (no aplica a surtido AMP) -->
                    <button name="action_amunet_operator_start" string="Iniciar operacion" type="object" class="oe_highlight"
                            invisible="state != 'ready' or amunet_is_supply_workorder"/>
                    <button name="action_amunet_operator_finish" string="Terminar operacion" type="object" class="oe_highlight"
                            invisible="state != 'progress' or amunet_is_supply_workorder"/>

                    <!-- Botones del flujo de Surtido (workcenter AMP) -->
                    <button name="action_amunet_start_supply" string="Iniciar Surtido" type="object" class="oe_highlight"
                            invisible="not amunet_is_supply_workorder or amunet_supply_state != 'pending' or state != 'ready'"
                            groups="amunet_material_request.group_material_warehouse,amunet_material_request.group_material_manager"/>
                    <button name="action_amunet_confirm_supply" string="Confirmar Surtido" type="object" class="oe_highlight"
                            invisible="not amunet_is_supply_workorder or amunet_supply_state != 'in_progress'"
                            groups="amunet_material_request.group_material_warehouse,amunet_material_request.group_material_manager"/>
                    <button name="action_amunet_receive_supply" string="Recibir / Aceptar entrega" type="object" class="oe_highlight"
                            invisible="not amunet_is_supply_workorder or amunet_supply_state != 'awaiting_reception'"
                            groups="amunet_production.group_production_supervisor"/>

                    <button name="action_amunet_open_production" string="Ver orden" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="blocked,ready,progress,done"/>
                </header>
                <sheet>
                    <field name="amunet_is_supply_workorder" invisible="1"/>
                    <field name="amunet_supply_state" invisible="not amunet_is_supply_workorder" widget="badge"
                           decoration-info="amunet_supply_state == 'in_progress'"
                           decoration-warning="amunet_supply_state == 'awaiting_reception'"
                           decoration-success="amunet_supply_state == 'received'"/>
                    <group>
                        <group>
                            <field name="name" string="Operacion" readonly="1"/>
                            <field name="production_id" string="Orden de fabricacion" readonly="1"/>
                            <field name="product_id" string="Producto" readonly="1"/>
                            <field name="workcenter_id" string="Area" readonly="1"/>
                        </group>
                        <group>
                            <field name="amunet_operator_next_step" readonly="1"/>
                            <field name="amunet_workqueue_priority" readonly="1" widget="badge"/>
                            <field name="amunet_workqueue_owner" readonly="1" widget="badge"/>
                            <field name="amunet_workqueue_next_step" readonly="1"/>
                            <field name="amunet_workqueue_blocker" readonly="1"/>
                            <field name="amunet_operator_material_status" readonly="1"/>
                            <field name="amunet_operator_quality_status" readonly="1"/>
                            <field name="amunet_operator_time_status" readonly="1"/>
                        </group>
                    </group>
                    <group string="Cantidad y tiempo" invisible="amunet_is_supply_workorder">
                        <field name="qty_remaining" string="Cantidad por producir" readonly="1"/>
                        <field name="qty_produced" string="Cantidad realizada" readonly="1"/>
                        <field name="duration_expected" string="Duracion esperada" readonly="1"/>
                        <field name="duration" string="Tiempo real" readonly="1"/>
                    </group>
                    <group invisible="not amunet_is_supply_workorder">
                        <group string="Tiempo de surtido">
                            <field name="duration_expected" string="Duracion esperada" readonly="1"/>
                            <field name="duration" string="Tiempo real" readonly="1"/>
                        </group>
                        <group string="Trazabilidad del surtido">
                            <field name="amunet_supplied_by_id" readonly="1"/>
                            <field name="amunet_supplied_date" readonly="1"/>
                            <field name="amunet_received_by_id" readonly="1"/>
                            <field name="amunet_received_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook invisible="not amunet_is_supply_workorder">
                        <page string="Materiales a surtir" name="amunet_supply_moves">
                            <!--
                                Vista del almacenista durante el surtido:
                                solo ve Cantidad surtida + Lote. La columna
                                nativa 'quantity' (cantidad utilizada/consumida)
                                NO se muestra hasta la conciliacion final.
                            -->
                            <field name="amunet_supply_moves"
                                   readonly="amunet_supply_state in ('awaiting_reception','received') or state in ('done','cancel')">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="product_id" readonly="1"/>
                                    <field name="product_uom_qty" string="Cantidad solicitada" readonly="1"/>
                                    <field name="amunet_qty_supplied" string="Cantidad surtida"/>
                                    <field name="product_uom" string="UoM" readonly="1"/>
                                    <field name="move_line_ids" widget="one2many" mode="list" string="Lotes">
                                        <list editable="bottom">
                                            <field name="lot_id"/>
                                            <field name="quantity" string="Cantidad por lote"/>
                                        </list>
                                    </field>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_amunet_operator_workorders" model="ir.actions.act_window">
        <field name="name">Mi trabajo de produccion</field>
        <field name="res_model">mrp.workorder</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state', 'not in', ('done', 'cancel'))]</field>
        <field name="context">{}</field>
        <field name="search_view_id" ref="view_mrp_workorder_operator_search"/>
        <field name="view_id" ref="view_mrp_workorder_operator_kanban"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No hay operaciones abiertas para produccion.
            </p>
            <p>
                Cuando el supervisor confirme una orden, aqui apareceran las operaciones listas para iniciar,
                en progreso o en espera de materiales.
            </p>
        </field>
    </record>

    <record id="action_amunet_operator_workorders_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_mrp_workorder_operator_kanban"/>
        <field name="act_window_id" ref="action_amunet_operator_workorders"/>
    </record>

    <record id="action_amunet_operator_workorders_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_mrp_workorder_operator_list"/>
        <field name="act_window_id" ref="action_amunet_operator_workorders"/>
    </record>

    <record id="action_amunet_operator_workorders_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mrp_workorder_operator_form"/>
        <field name="act_window_id" ref="action_amunet_operator_workorders"/>
    </record>

    <record id="view_mrp_production_workqueue_search" model="ir.ui.view">
        <field name="name">mrp.production.amunet.workqueue.search</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <search string="Cola supervisor produccion">
                <field name="name"/>
                <field name="product_id"/>
                <filter name="draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <filter name="active" string="Abiertas" domain="[('state', 'in', ('confirmed', 'progress', 'to_close'))]"/>
                <filter name="supply_pending" string="Surtido pendiente"
                        domain="[('amunet_supply_state', 'in', ('pending', 'in_progress'))]"/>
                <filter name="supply_reception" string="Recibir surtido"
                        domain="[('amunet_supply_state', '=', 'awaiting_reception')]"/>
                <filter name="quality_pending" string="Calidad pendiente"
                        domain="[('quality_analysis_status', 'in', ('to_request', 'requested', 'rejected'))]"/>
                <filter name="reconciliation_pending" string="Conciliacion pendiente"
                        domain="[('reconciliation_state', 'in', ('pending', 'initiated', 'validated'))]"/>
                <separator/>
                <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_mrp_production_workqueue_list" model="ir.ui.view">
        <field name="name">mrp.production.amunet.workqueue.list</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0"
                  decoration-danger="amunet_workqueue_priority == 'blocked'"
                  decoration-warning="amunet_workqueue_priority == 'waiting'"
                  decoration-success="amunet_workqueue_priority == 'ready'"
                  decoration-info="amunet_workqueue_priority == 'progress'">
                <field name="name" string="Orden"/>
                <field name="product_id" string="Producto"/>
                <field name="product_qty" string="Cantidad"/>
                <field name="state" string="Estado MO" widget="badge"/>
                <field name="amunet_workqueue_priority" string="Prioridad" widget="badge"/>
                <field name="amunet_workqueue_owner" string="Responsable" widget="badge"/>
                <field name="amunet_workqueue_next_step" string="Siguiente paso"/>
                <field name="amunet_workqueue_blocker" string="Bloqueo / pendiente"/>
                <field name="amunet_supply_state" string="Surtido" widget="badge" optional="show"/>
                <field name="quality_analysis_status" string="Calidad" widget="badge" optional="show"/>
                <field name="reconciliation_state" string="Conciliacion" widget="badge" optional="show"/>
                <field name="date_start" string="Inicio programado" optional="hide"/>
            </list>
        </field>
    </record>

    <!--
        Vista de lista para el menu ESTANDAR "Ordenes de fabricacion"
        (mrp.mrp_production_action). Mismas columnas que la cola de
        supervisor, pero con creacion HABILITADA para que aparezca el
        boton "Nuevo". Las filas siguen sin edicion ni borrado en linea
        (edit/delete=0) por seguridad regulatoria; crear abre el
        formulario normal. La cola de supervisor (view_mrp_production_workqueue_list)
        no se toca: sigue siendo de solo lectura.
    -->
    <record id="view_mrp_production_amunet_main_list" model="ir.ui.view">
        <field name="name">mrp.production.amunet.main.list</field>
        <field name="model">mrp.production</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list delete="0" edit="0"
                  decoration-danger="amunet_workqueue_priority == 'blocked'"
                  decoration-warning="amunet_workqueue_priority == 'waiting'"
                  decoration-success="amunet_workqueue_priority == 'ready'"
                  decoration-info="amunet_workqueue_priority == 'progress'">
                <field name="name" string="Orden"/>
                <field name="product_id" string="Producto"/>
                <field name="product_qty" string="Cantidad"/>
                <field name="state" string="Estado MO" widget="badge"/>
                <field name="amunet_workqueue_priority" string="Prioridad" widget="badge"/>
                <field name="amunet_workqueue_owner" string="Responsable" widget="badge"/>
                <field name="amunet_workqueue_next_step" string="Siguiente paso"/>
                <field name="amunet_workqueue_blocker" string="Bloqueo / pendiente"/>
                <field name="amunet_supply_state" string="Surtido" widget="badge" optional="show"/>
                <field name="quality_analysis_status" string="Calidad" widget="badge" optional="show"/>
                <field name="reconciliation_state" string="Conciliacion" widget="badge" optional="show"/>
                <field name="date_start" string="Inicio programado" optional="hide"/>
            </list>
        </field>
    </record>

    <!--
        Apunta la accion estandar de Manufactura a la vista de arriba,
        para que "Ordenes de fabricacion" muestre estas columnas Y el
        boton "Nuevo". Sin esto, Odoo resolvia por defecto la vista de
        la cola de supervisor (solo lectura) y no se veia "Nuevo".
    -->
    <record id="mrp.mrp_production_action" model="ir.actions.act_window">
        <field name="view_id" ref="view_mrp_production_amunet_main_list"/>
    </record>

    <record id="action_amunet_production_supervisor_workqueue" model="ir.actions.act_window">
        <field name="name">Cola supervisor produccion</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'not in', ('done', 'cancel'))]</field>
        <field name="view_id" ref="view_mrp_production_workqueue_list"/>
        <field name="search_view_id" ref="view_mrp_production_workqueue_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No hay ordenes abiertas de produccion.
            </p>
            <p>
                Aqui se ve que area debe actuar: almacen, produccion, calidad,
                metrologia o supervisor.
            </p>
        </field>
    </record>

    <!--
        Inherit de la vista nativa de mrp.workorder: agrega los botones
        del flujo de Surtido (Iniciar / Confirmar / Recibir) + badge
        de estado + pestaña 'Materiales a surtir'. Asi el supervisor de
        produccion que entre via 'MO -> Ordenes de trabajo' ve lo mismo
        que el almacenista en 'Mi trabajo'.
    -->
    <record id="view_mrp_workorder_form_amunet_supply_inherit" model="ir.ui.view">
        <field name="name">mrp.workorder.form.amunet.supply.inherit</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_amunet_start_supply" string="Iniciar Surtido" type="object" class="oe_highlight"
                        invisible="not amunet_is_supply_workorder or amunet_supply_state != 'pending' or state != 'ready'"
                        groups="amunet_material_request.group_material_warehouse,amunet_material_request.group_material_manager"/>
                <button name="action_amunet_confirm_supply" string="Confirmar Surtido" type="object" class="oe_highlight"
                        invisible="not amunet_is_supply_workorder or amunet_supply_state != 'in_progress'"
                        groups="amunet_material_request.group_material_warehouse,amunet_material_request.group_material_manager"/>
                <button name="action_amunet_receive_supply" string="Recibir / Aceptar entrega" type="object" class="oe_highlight"
                        invisible="not amunet_is_supply_workorder or amunet_supply_state != 'awaiting_reception'"
                        groups="amunet_production.group_production_supervisor"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <field name="amunet_is_supply_workorder" invisible="1"/>
                <group invisible="not amunet_is_supply_workorder">
                    <group string="Estado del surtido">
                        <field name="amunet_supply_state" widget="badge"
                               decoration-info="amunet_supply_state == 'in_progress'"
                               decoration-warning="amunet_supply_state == 'awaiting_reception'"
                               decoration-success="amunet_supply_state == 'received'"/>
                    </group>
                    <group string="Trazabilidad del surtido">
                        <field name="amunet_supplied_by_id" readonly="1"/>
                        <field name="amunet_supplied_date" readonly="1"/>
                        <field name="amunet_received_by_id" readonly="1"/>
                        <field name="amunet_received_date" readonly="1"/>
                    </group>
                </group>
            </xpath>

            <!--
                Ocultar la pestaña nativa 'Componentes' en TODOS los
                workorders. Es la vista tecnica filtrada por
                bom_line.operation_id; en el flujo Amunet es redundante
                porque la pestaña 'Materiales a surtir' ya muestra el
                listado completo y editable.
            -->
            <xpath expr="//notebook/page[@name='components']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Materiales a surtir" name="amunet_supply_moves"
                      invisible="not amunet_is_supply_workorder">
                    <field name="amunet_supply_moves"
                           readonly="amunet_supply_state in ('awaiting_reception','received') or state in ('done','cancel')">
                        <list editable="bottom" create="0" delete="0">
                            <field name="product_id" readonly="1"/>
                            <field name="product_uom_qty" string="Cantidad solicitada" readonly="1"/>
                            <field name="amunet_qty_supplied" string="Cantidad surtida"/>
                            <field name="product_uom" string="UoM" readonly="1"/>
                            <field name="move_line_ids" widget="one2many" mode="list" string="Lotes">
                                <list editable="bottom">
                                    <field name="lot_id"/>
                                    <field name="quantity" string="Cantidad por lote"/>
                                </list>
                            </field>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

