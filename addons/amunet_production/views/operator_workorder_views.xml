    <!--
        Menu y accion para que el ALMACEN haga surtido sin entrar al
        modulo de Produccion. Vive bajo Inventario -> Operaciones.
        Filtra los workorders de Surtido (workcenter.code='AMP') que
        estan pendientes de surtido, en surtido o esperando recepcion.
    -->
    <!--
        Lista de MOs pendientes/en surtido. Cuando el almacenista da
        click en una fila se abre directamente el FORMULARIO DEL MO
        (no del workorder) para que pueda surtir sin moverse.
    -->
    <record id="view_mrp_production_supply_warehouse_list" model="ir.ui.view">
        <field name="name">mrp.production.supply.warehouse.list</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0"
                  decoration-success="amunet_supply_state == 'received'"
                  decoration-info="amunet_supply_state == 'in_progress'"
                  decoration-warning="amunet_supply_state == 'awaiting_reception'">
                <field name="name" string="Orden de fabricacion"/>
                <field name="product_id" string="Producto"/>
                <field name="product_qty" string="Cantidad a producir"/>
                <field name="state" string="Estado MO"/>
                <field name="amunet_supply_state" string="Estado del surtido"
                       widget="badge"
                       decoration-info="amunet_supply_state == 'in_progress'"
                       decoration-warning="amunet_supply_state == 'awaiting_reception'"
                       decoration-success="amunet_supply_state == 'received'"/>
                <field name="origin" string="Origen"/>
            </list>
        </field>
    </record>

    <record id="action_amunet_warehouse_supply_workorders" model="ir.actions.act_window">
        <field name="name">Surtido de produccion</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('amunet_supply_workorder_id', '!=', False), ('amunet_supply_state', 'in', ('pending', 'in_progress', 'awaiting_reception')), ('state', 'in', ('confirmed', 'progress', 'to_close'))]</field>
        <field name="view_id" ref="view_mrp_production_supply_warehouse_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No hay ordenes pendientes de surtir.
            </p>
            <p>
                Cuando produccion confirme una orden, aqui apareceran las ordenes
                que necesitan ser surtidas desde almacen.
            </p>
        </field>
    </record>

    <record id="action_amunet_warehouse_supply_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_mrp_production_supply_warehouse_list"/>
        <field name="act_window_id" ref="action_amunet_warehouse_supply_workorders"/>
    </record>

