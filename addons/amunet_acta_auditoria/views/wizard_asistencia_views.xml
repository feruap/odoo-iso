<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_asistencia_wizard_form" model="ir.ui.view">
        <field name="name">amunet.acta.asistencia.wizard.form</field>
        <field name="model">amunet.acta.asistencia.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar asistencia">
                <field name="acta_id" invisible="1"/>
                <field name="seccion" invisible="1"/>
                <group>
                    <field name="usuario_nombre" readonly="1"/>
                    <field name="password" string="PIN / Contraseña"
                        password="True"
                        placeholder="Tu PIN o contraseña de Odoo"
                        autofocus="autofocus"/>
                </group>
                <footer>
                    <button name="action_confirmar" type="object"
                        string="Confirmar asistencia" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
