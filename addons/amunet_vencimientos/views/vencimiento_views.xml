<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Lista ── -->
    <record id="view_vencimiento_list" model="ir.ui.view">
        <field name="name">amunet.vencimiento.list</field>
        <field name="model">amunet.vencimiento</field>
        <field name="arch" type="xml">
            <list string="Vigencias" decoration-danger="estado == 'vencido'"
                  decoration-warning="estado == 'por_vencer'"
                  decoration-success="estado == 'vigente'">
                <field name="name"/>
                <field name="numero"/>
                <field name="tipo"/>
                <field name="titular" optional="show"/>
                <field name="fecha_vencimiento"/>
                <field name="dias_restantes" string="Días restantes"/>
                <field name="estado" widget="badge"
                       decoration-danger="estado == 'vencido'"
                       decoration-warning="estado == 'por_vencer'"
                       decoration-success="estado == 'vigente'"/>
                <field name="aviso_prorroga" widget="badge" optional="show"
                       decoration-danger="aviso_prorroga in ('urgente','vencido')"
                       decoration-warning="aviso_prorroga == 'enviar'"
                       decoration-info="aviso_prorroga == 'iniciar'"
                       decoration-muted="aviso_prorroga == 'vigente'"/>
            </list>
        </field>
    </record>

    <!-- ── Formulario ── -->
    <record id="view_vencimiento_form" model="ir.ui.view">
        <field name="name">amunet.vencimiento.form</field>
        <field name="model">amunet.vencimiento</field>
        <field name="arch" type="xml">
            <form string="Vigencia">
                <header>
                    <field name="estado" widget="statusbar"
                           statusbar_visible="vigente,por_vencer,vencido"/>
                    <field name="aviso_prorroga" widget="badge"
                           decoration-danger="aviso_prorroga in ('urgente','vencido')"
                           decoration-warning="aviso_prorroga == 'enviar'"
                           decoration-info="aviso_prorroga == 'iniciar'"
                           invisible="aviso_prorroga == 'vigente'"/>
                    <button name="action_enviar_alerta_manual"
                            string="Enviar alerta ahora"
                            type="object"
                            class="btn-warning"
                            icon="fa-envelope"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre del documento"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="tipo"/>
                            <field name="numero"/>
                            <field name="titular"/>
                        </group>
                        <group>
                            <field name="fecha_emision"/>
                            <field name="fecha_vencimiento"/>
                            <field name="dias_restantes"/>
                        </group>
                    </group>
                    <group string="Documento">
                        <field name="archivo" filename="archivo_filename" widget="binary"/>
                        <field name="archivo_filename" invisible="1"/>
                    </group>
                    <group string="Notas">
                        <field name="notas" nolabel="1"/>
                    </group>
                    <div class="alert alert-warning mb-3"
                         invisible="aviso_prorroga != 'checklist'"
                         style="border-left:4px solid #8e44ad;background:#faf5ff;">
                        <h5 style="color:#8e44ad;margin-bottom:8px;">
                            📋 Documentos a preparar para la prórroga
                        </h5>
                        <p style="margin-bottom:6px;"><strong>1) Documentos básicos obligatorios</strong></p>
                        <ul style="margin-bottom:10px;">
                            <li>Formato de solicitud de prórroga completado</li>
                            <li>Comprobante de pago de derechos gubernamentales (original)</li>
                            <li>Documento de identidad del representante legal (RUPA o carta poder)</li>
                            <li>Copia simple del registro sanitario vigente y sus modificaciones</li>
                        </ul>
                        <p style="margin-bottom:6px;"><strong>2) Documentos técnicos esenciales</strong></p>
                        <ul style="margin-bottom:10px;">
                            <li>Informe de tecnovigilancia (últimos 5 años)</li>
                            <li>Certificado de Análisis del fabricante (con membrete y firma del responsable sanitario)</li>
                            <li>Certificado de Buenas Prácticas de Fabricación (GMP / BPF)</li>
                        </ul>
                        <p style="margin-bottom:6px;"><strong>3) Si el dispositivo es importado</strong></p>
                        <ul style="margin-bottom:10px;">
                            <li>Certificado de Libre Venta (emitido en el último año)</li>
                            <li>Carta de representación (si aplica)</li>
                            <li>Proyecto de etiquetado e instructivos de uso</li>
                        </ul>
                        <p style="margin-bottom:0;font-size:12px;color:#6b46c1;">
                            ⚠️ Documentos en otro idioma requieren traducción al español.
                            Documentos extranjeros requieren apostilla o legalización.
                        </p>
                    </div>

                    <notebook>
                        <page string="Alertas enviadas" name="alertas">
                            <field name="alerta_ids" readonly="1">
                                <list>
                                    <field name="fecha_envio"/>
                                    <field name="dias_antes" string="Días antes del vencimiento"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Busqueda -->
    <record id="view_vencimiento_search" model="ir.ui.view">
        <field name="name">amunet.vencimiento.search</field>
        <field name="model">amunet.vencimiento</field>
        <field name="arch" type="xml">
            <search string="Buscar vigencias">
                <field name="name" string="Nombre"/>
                <field name="numero" string="Numero"/>
                <filter string="Vencidos" name="vencidos"
                        domain="[('estado','=','vencido')]"/>
                <filter string="Por vencer" name="por_vencer"
                        domain="[('estado','=','por_vencer')]"/>
                <filter string="Vigentes" name="vigentes"
                        domain="[('estado','=','vigente')]"/>
                <filter string="Tipo" name="by_tipo"
                        context="{'group_by': 'tipo'}"/>
            </search>
        </field>
    </record>

    <!-- ── Acciones ── -->
    <record id="action_vencimientos" model="ir.actions.act_window">
        <field name="name">Por vencer</field>
        <field name="res_model">amunet.vencimiento</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_por_vencer': 1}</field>
    </record>

    <record id="action_vencimientos_vencidos" model="ir.actions.act_window">
        <field name="name">Vencidos</field>
        <field name="res_model">amunet.vencimiento</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('estado','=','vencido')]</field>
    </record>

    <record id="action_vencimientos_todos" model="ir.actions.act_window">
        <field name="name">Todos los registros</field>
        <field name="res_model">amunet.vencimiento</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ── Hub ── -->
    <record id="action_vencimientos_hub" model="ir.actions.client">
        <field name="name">Vigencias</field>
        <field name="tag">amunet_vencimientos_hub</field>
    </record>

</odoo>
