<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vencimiento_firma_wizard_form" model="ir.ui.view">
        <field name="name">amunet.vencimiento.firma.wizard.form</field>
        <field name="model">amunet.vencimiento.firma.wizard</field>
        <field name="arch" type="xml">
            <form string="Modificar vigencia con firma">
                <field name="vencimiento_id" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    Los campos vienen con lo que hay hoy. Cambia lo que haga
                    falta, anota la razón y fírmalo con tu PIN: en el expediente
                    del registro queda asentado qué cambió, de qué a qué, quién
                    lo hizo y por qué.
                </div>
                <group>
                    <group string="Datos del documento">
                        <field name="name"/>
                        <field name="numero"/>
                        <field name="tipo"/>
                        <field name="titular"/>
                    </group>
                    <group string="Vigencia">
                        <field name="fecha_emision"/>
                        <field name="fecha_vencimiento"/>
                    </group>
                </group>
                <group>
                    <field name="notas"/>
                    <field name="archivo" filename="archivo_filename" widget="binary"/>
                    <field name="archivo_filename" invisible="1"/>
                </group>
                <group>
                    <field name="motivo" placeholder="Por ejemplo: prórroga autorizada por COFEPRIS, oficio 1234/2026 del 20.09.26"/>
                    <field name="password" password="True"/>
                </group>
                <footer>
                    <button name="action_confirmar" type="object"
                            string="Firmar y guardar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
