<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_aviso_recepciones" model="ir.cron">
        <field name="cron_name">Almacen: aviso de recepciones 8:30</field>
        <field name="ir_actions_server_id" ref="action_aviso_recepciones"/>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- 14:30 UTC = 08:30 en Puebla (Mexico es UTC-6 fijo, sin horario de verano) -->
        <field name="nextcall" eval="(DateTime.now().replace(hour=14, minute=30, second=0, microsecond=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
        <field name="priority">5</field>
    </record>
</odoo>
