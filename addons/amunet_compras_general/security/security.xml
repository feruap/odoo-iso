<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- OJO: deliberadamente NO se usa purchase.group_purchase_manager.
             Ese grupo hoy incluye a almacen.mp, supalmacen y
             verif-odoo-almacen, y almacen no debe ver montos nunca. -->
        <record id="group_compras_monto" model="res.groups">
            <field name="name">Compras / Ve montos de compra general</field>
            <field name="comment">Puede ver el importe de las solicitudes de compra general. Membresia nombrada.</field>
        </record>

        <!-- Quien captura en que va el pago de una orden de compra. No es
             contabilidad: la contabilidad de Amunet vive fuera de Odoo.
             Implica group_compras_monto porque no tiene sentido anotar un
             pago sin poder ver el importe. -->
        <record id="group_compras_pagos" model="res.groups">
            <field name="name">Compras / Captura de pagos</field>
            <field name="comment">Puede capturar estado de pago, fecha y referencia en la orden de compra. Membresia nombrada.</field>
            <field name="implied_ids" eval="[(4, ref('amunet_compras_general.group_compras_monto'))]"/>
        </record>

        <!-- Quien da el visto bueno de una compra (la segunda firma, la de
             Direccion). Existia solo como el id de Telegram dentro del bot;
             al abrir la puerta del tablero hace falta decirlo en Odoo.
             Membresia nombrada, abajo, con noupdate="0" para que NO se
             pierda en las actualizaciones: eso ya paso con
             group_compras_pagos, que quedo sin un solo usuario en
             produccion y dejo el campo bloqueado para todos. -->
        <record id="group_autoriza_compra" model="res.groups">
            <field name="name">Compras / Da el visto bueno</field>
            <field name="comment">Puede autorizar o rechazar una compra desde el tablero, igual que con los botones de Telegram. Membresia nombrada.</field>
        </record>
    </data>
    <data noupdate="0">
        <function model="res.users" name="write">
            <function model="res.users" name="search">
                <value eval="[('login', '=', 'fernando.ruiz@amunet.com.mx')]"/>
            </function>
            <value eval="{'group_ids': [(4, ref('amunet_compras_general.group_autoriza_compra'))]}"/>
        </function>
    </data>
    <!-- noupdate="0": se re-aplica en cada update para que los usuarios
         autorizados siempre tengan el acceso, incluso en produccion.
         RRHH NO va en esta lista: decision de Mery del 22-sep-2026.
         Si alguien la vuelve a agregar, preguntarle a ella primero. -->
    <data noupdate="0">
        <function model="res.users" name="write">
            <function model="res.users" name="search">
                <value eval="[('login', 'in', ['fernando.ruiz@amunet.com.mx', 'desarrollo@amunet.com.mx'])]"/>
            </function>
            <value eval="{'group_ids': [(4, ref('amunet_compras_general.group_compras_monto'))]}"/>
        </function>
    </data>
</odoo>
