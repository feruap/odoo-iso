<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_material_request_form_pago" model="ir.ui.view">
        <field name="name">amunet.material.request.form.pago</field>
        <field name="model">amunet.material.request</field>
        <field name="inherit_id" ref="amunet_material_request.view_amunet_material_request_form"/>
        <field name="arch" type="xml">
            <field name="amunet_proveedor_factura" position="before">
                <field name="amunet_forma_pago"/>
            </field>
            <field name="amunet_datos_bancarios" position="after">
                <field name="amunet_banco" invisible="amunet_forma_pago != 'transferencia'"/>
                <field name="amunet_clabe" placeholder="18 digitos" invisible="amunet_forma_pago != 'transferencia'"/>
                <field name="amunet_titular" invisible="amunet_forma_pago != 'transferencia'"/>
                <field name="amunet_referencia_pago" invisible="amunet_forma_pago != 'transferencia'"/>
                <field name="amunet_concepto_pago" invisible="amunet_forma_pago != 'transferencia'"/>
                <field name="amunet_autorizacion_estado" readonly="1" invisible="amunet_autorizacion_estado == 'na'"/>
                <field name="amunet_autorizacion_fecha" readonly="1" invisible="not amunet_autorizacion_fecha"/>
                <field name="amunet_currency_id" invisible="1"/>
                <field name="amunet_monto" groups="amunet_compras_general.group_compras_monto"/>
                <field name="amunet_monto_visible" readonly="1" invisible="not amunet_monto_visible" groups="!amunet_compras_general.group_compras_monto"/>
            </field>
        </field>
    </record>
</odoo>
