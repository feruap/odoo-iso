<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1": la secuencia se crea UNA vez. Sin esto, cada -u del
         modulo reescribia number_next=1 y reiniciaba el folio (duplicados). -->
    <data noupdate="1">
    <record id="seq_apertura_cierre_prov" model="ir.sequence">
        <field name="name">Apertura/Cierre Auditoría Proveedores</field>
        <field name="code">amunet.apertura.cierre.prov</field>
        <field name="prefix">AC-PROV-%(year)s-</field>
        <field name="padding">3</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>
    </data>
</odoo>
