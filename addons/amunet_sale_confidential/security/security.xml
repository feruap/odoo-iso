<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="group_sale_confidential" model="res.groups">
            <field name="name">Amunet / Ventas confidencial</field>
            <field name="comment">Unico grupo autorizado a consultar pedidos de venta y datos comerciales. Los importes siguen reservados al grupo "Amunet / Ver precios".</field>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <!-- El menu Ventas deja de existir para quien no este en el grupo -->
        <record id="sale.sale_menu_root" model="ir.ui.menu">
            <field name="group_ids" eval="[(6, 0, [ref('group_sale_confidential')])]"/>
        </record>

    </data>
</odoo>
