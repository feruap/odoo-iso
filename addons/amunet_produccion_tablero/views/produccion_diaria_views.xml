<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_produccion_diaria_graph" model="ir.ui.view">
        <field name="name">amunet.produccion.diaria.graph</field>
        <field name="model">amunet.produccion.diaria</field>
        <field name="arch" type="xml">
            <graph string="Plan vs real" type="bar" stacked="0" sample="1">
                <field name="fecha" interval="day"/>
                <field name="tipo"/>
                <field name="piezas" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_produccion_diaria_pivot" model="ir.ui.view">
        <field name="name">amunet.produccion.diaria.pivot</field>
        <field name="model">amunet.produccion.diaria</field>
        <field name="arch" type="xml">
            <pivot string="Plan vs real" sample="1">
                <field name="fecha" interval="day" type="row"/>
                <field name="tipo" type="col"/>
                <field name="piezas" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_produccion_diaria_list" model="ir.ui.view">
        <field name="name">amunet.produccion.diaria.list</field>
        <field name="model">amunet.produccion.diaria</field>
        <field name="arch" type="xml">
            <list string="Plan vs real" create="0" edit="0" delete="0">
                <field name="fecha"/>
                <field name="tipo"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="piezas" sum="Total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_produccion_diaria_search" model="ir.ui.view">
        <field name="name">amunet.produccion.diaria.search</field>
        <field name="model">amunet.produccion.diaria</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="production_id"/>
                <field name="categ_id"/>
                <filter name="f_plan" string="Planeado" domain="[('tipo', '=', 'plan')]"/>
                <filter name="f_real" string="Real" domain="[('tipo', '=', 'real')]"/>
                <separator/>
                <filter name="f_fecha" string="Fecha" date="fecha"/>
                <group>
                    <filter name="g_dia" string="Día" context="{'group_by': 'fecha:day'}"/>
                    <filter name="g_tipo" string="Tipo" context="{'group_by': 'tipo'}"/>
                    <filter name="g_producto" string="Producto" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_produccion_diaria" model="ir.actions.act_window">
        <field name="name">Plan vs real diario (piezas)</field>
        <field name="res_model">amunet.produccion.diaria</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'search_default_f_fecha': 1}</field>
        <field name="help" type="html">
            <p>Piezas de producto terminado: lo planeado (fecha fin programada de la orden,
            congelada antes de iniciar) contra lo realmente terminado cada día.</p>
        </field>
    </record>

    <menuitem id="menu_produccion_diaria"
              name="Plan vs real diario"
              parent="mrp.menu_mrp_reporting"
              action="action_produccion_diaria"
              groups="mrp.group_mrp_user"
              sequence="5"/>
</odoo>
