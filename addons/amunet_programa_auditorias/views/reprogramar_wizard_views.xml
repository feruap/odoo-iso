<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_reprogramar_wizard_form" model="ir.ui.view">
        <field name="name">amunet.programa.reprogramar.wizard.form</field>
        <field name="model">amunet.programa.reprogramar.wizard</field>
        <field name="arch" type="xml">
            <form string="Reprogramar programa">
                <sheet>
                    <field name="programa_id" invisible="1"/>
                    <group>
                        <field name="motivo" nolabel="1" rows="5"
                            placeholder="Describe brevemente por qué se necesita reprogramar..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirmar" type="object"
                        string="Confirmar reprogramación" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
