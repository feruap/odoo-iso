<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menú raíz desactivado: el acceso es por el hub del dashboard -->
    <record id="menu_desviaciones_bajo_docs" model="ir.ui.menu">
        <field name="name">Desviaciones / NC</field>
        <field name="parent_id" ref="amunet_documentos.menu_amunet_documentos_root"/>
        <field name="sequence">30</field>
        <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
        <field name="active" eval="False"/>
    </record>

    <menuitem id="menu_desviaciones_mis"
              name="Mis desviaciones"
              parent="menu_desviaciones_bajo_docs"
              action="action_desviacion_mis"
              sequence="10"/>

    <menuitem id="menu_desviaciones_todas"
              name="Todas las desviaciones"
              parent="menu_desviaciones_bajo_docs"
              action="action_desviacion"
              sequence="20"
              groups="amunet_desviaciones.group_desviaciones_manager"/>
</odoo>
