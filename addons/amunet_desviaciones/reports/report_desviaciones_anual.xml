<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Acción de reporte ──────────────────────────────────────── -->
    <record id="action_report_desviaciones_anual" model="ir.actions.report">
        <field name="name">Registro Anual de Desviaciones / NC</field>
        <field name="model">amunet.desviacion</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">amunet_desviaciones.report_desviaciones_anual_template</field>
        <field name="report_file">amunet_desviaciones.report_desviaciones_anual_template</field>
        <field name="binding_model_id" search="[('model','=','amunet.desviacion')]"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- ── Plantilla QWeb ────────────────────────────────────────── -->
    <template id="report_desviaciones_anual_template">
        <t t-call="web.html_container">
            <t t-foreach="docs_grouped_by_year" t-as="year_group">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- Encabezado -->
                        <div class="row mb-4">
                            <div class="col-12 text-center">
                                <h3 class="mt-0">Registro Anual de Desviaciones y No Conformidades</h3>
                                <h4 class="text-muted">Año <t t-esc="year_group['year']"/></h4>
                                <p class="small">ISO 13485:2016 § 8.3 / § 8.5.2 — Control de Desviaciones y Acciones Correctivas</p>
                            </div>
                        </div>

                        <!-- Tabla por mes -->
                        <t t-foreach="year_group['months']" t-as="mes">
                            <t t-if="mes['records']">
                                <h5 class="mt-3 mb-1 border-bottom pb-1">
                                    <t t-esc="mes['nombre']"/>
                                    <span class="text-muted small"> (<t t-esc="len(mes['records'])"/> registro(s))</span>
                                </h5>
                                <table class="table table-sm table-bordered" style="font-size:10px;">
                                    <thead class="table-secondary">
                                        <tr>
                                            <th style="width:8%">Folio</th>
                                            <th style="width:10%">Fecha</th>
                                            <th style="width:12%">Tipo</th>
                                            <th style="width:15%">Área</th>
                                            <th style="width:20%">Producto / Proceso</th>
                                            <th style="width:10%">Riesgo</th>
                                            <th style="width:13%">Quien reporta</th>
                                            <th style="width:12%">Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="mes['records']" t-as="dev">
                                            <tr>
                                                <td><t t-esc="dev.name"/></td>
                                                <td><t t-esc="dev.fecha_reporte.strftime('%d/%m/%Y') if dev.fecha_reporte else ''"/></td>
                                                <td><t t-esc="dict(dev._fields['tipo_incidencia'].selection).get(dev.tipo_incidencia, dev.tipo_incidencia or '')"/></td>
                                                <td><t t-esc="dev.area_afectada or ''"/></td>
                                                <td><t t-esc="dev.producto or ''"/></td>
                                                <td><t t-esc="dev.nivel_riesgo or ''"/></td>
                                                <td><t t-esc="dev.reporta_id.name if dev.reporta_id else ''"/></td>
                                                <td><t t-esc="dict(dev._fields['state'].selection).get(dev.state, dev.state)"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                        </t>

                        <!-- Totales -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <p class="small text-muted">
                                    Total del año: <strong><t t-esc="year_group['total']"/></strong> desviación(es) registrada(s).
                                </p>
                            </div>
                        </div>

                        <!-- Pie de firma -->
                        <div class="row mt-4">
                            <div class="col-4 text-center">
                                <p style="border-top:1px solid #333; padding-top:4px; font-size:10px;">
                                    Elaboró
                                </p>
                            </div>
                            <div class="col-4 text-center">
                                <p style="border-top:1px solid #333; padding-top:4px; font-size:10px;">
                                    Revisó
                                </p>
                            </div>
                            <div class="col-4 text-center">
                                <p style="border-top:1px solid #333; padding-top:4px; font-size:10px;">
                                    Autorizó
                                </p>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
