<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Quien trabaja en Distribucion.

         Es un grupo propio y no un permiso de Inventario a proposito: la
         fabrica y la venta son dos operaciones distintas sobre el mismo
         inventario, y cada quien debe ver lo suyo. Hoy: Luis, Michel, Fernando
         y Mery. -->
    <record id="group_distribucion_user" model="res.groups">
        <field name="name">Distribucion / Operador</field>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_distribucion_manager" model="res.groups">
        <field name="name">Distribucion / Responsable</field>
        <field name="implied_ids" eval="[(4, ref('amunet_almacen_distribucion.group_distribucion_user'))]"/>
    </record>

    <!-- Solo lo de ADT.

         La regla filtra por almacen, no por usuario: asi no hay que tocarla
         cada vez que entra o sale alguien del area. Se aplica a quien tenga el
         grupo de Distribucion Y NO tenga acceso amplio de inventario. -->
    <record id="rule_distribucion_picking" model="ir.rule">
        <field name="name">Distribucion: solo traslados de ADT</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="domain_force">['|', ('picking_type_id.warehouse_id.code', '=', 'ADT'), ('picking_type_id.warehouse_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('amunet_almacen_distribucion.group_distribucion_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
