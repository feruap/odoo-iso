<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_solicitud_compra_form" model="ir.ui.view">
        <field name="name">amunet.solicitud.compra.form</field>
        <field name="model">amunet.solicitud.compra</field>
        <field name="arch" type="xml">
            <form string="Solicitud de compra">
                <header>
                    <button name="action_enviar" string="Enviar a autorizacion"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_autorizar" string="Autorizar"
                            type="object" class="oe_highlight"
                            invisible="state != 'pending_approval'"
                            help="La autoriza el jefe directo de quien pide, o compras."/>
                    <button name="action_marcar_comprada" string="Marcar como comprada"
                            type="object" class="oe_highlight"
                            invisible="state != 'approved'"/>
                    <button name="action_cerrar" string="Cerrar"
                            type="object"
                            invisible="state != 'purchased'"/>
                    <button name="action_volver_borrador" string="Volver a borrador"
                            type="object"
                            invisible="state not in ('pending_approval','cancelled')"/>
                    <button name="action_cancelar" string="Cancelar"
                            type="object"
                            invisible="state in ('closed','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending_approval,approved,purchased,closed"/>
                </header>
                <div class="oe_button_box" name="button_box">
                    <button name="action_ver_recepcion" type="object"
                            class="oe_stat_button" icon="fa-truck"
                            invisible="not picking_count">
                        <div class="o_stat_info">
                            <field name="picking_count" class="o_stat_value"/>
                            <span class="o_stat_text">Recepciones</span>
                        </div>
                    </button>
                </div>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Quien pide">
                            <field name="requester_id"/>
                            <field name="department_id"/>
                            <field name="marketplace_flow"/>
                        </group>
                        <group string="Cuando y a quien">
                            <field name="request_date"/>
                            <field name="required_date"/>
                            <field name="partner_id"/>
                            <field name="warehouse_id"
                                   readonly="state not in ('draft','pending_approval')"/>
                            <field name="requiere_aprobacion" readonly="1"/>
                            <field name="amunet_aprobador_id" readonly="1"
                                   invisible="state in ('draft','closed','cancelled')"/>
                            <field name="amunet_usuario_es_aprobador" invisible="1"/>
                            <field name="amunet_autorizada_por_id" readonly="1"
                                   invisible="not amunet_autorizada_por_id"/>
                            <field name="amunet_autorizada_fecha" readonly="1"
                                   invisible="not amunet_autorizada_fecha"/>
                            <field name="purchase_order_id" readonly="1"
                                   invisible="not purchase_order_id"/>
                            <field name="amunet_material_request_id" readonly="1"
                                   invisible="not amunet_material_request_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Que se compra" name="lineas">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="proposal_id" optional="hide"/>
                                    <field name="name"/>
                                    <field name="qty"/>
                                    <field name="uom_id"/>
                                <field name="warehouse_id" options="{'no_create': True}" placeholder="Elegir"/>
                                <field name="purchase_url" widget="url"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                            <separator string="Para que se necesita"/>
                            <field name="note" placeholder="Justificacion..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_solicitud_compra_list" model="ir.ui.view">
        <field name="name">amunet.solicitud.compra.list</field>
        <field name="model">amunet.solicitud.compra</field>
        <field name="arch" type="xml">
            <list string="Solicitudes de compra">
                <field name="name"/>
                <field name="request_date"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="marketplace_flow"/>
                <field name="partner_id" optional="show"/>
                <field name="requiere_aprobacion" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('approved','purchased','closed')"
                       decoration-warning="state == 'pending_approval'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_solicitud_compra_search" model="ir.ui.view">
        <field name="name">amunet.solicitud.compra.search</field>
        <field name="model">amunet.solicitud.compra</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="partner_id"/>
                <filter string="Abiertas" name="f_abiertas"
                        domain="[('state','not in',('closed','cancelled'))]"/>
                <filter string="Pte. autorizacion" name="f_pte"
                        domain="[('state','=','pending_approval')]"/>
                <separator/>
                <filter string="Compra general" name="f_general"
                        domain="[('marketplace_flow','=','general')]"/>
                <filter string="Produccion" name="f_prod"
                        domain="[('marketplace_flow','=','production')]"/>
                <separator/>
                <filter string="Por estado" name="g_estado" context="{'group_by':'state'}"/>
                <filter string="Por area" name="g_area" context="{'group_by':'department_id'}"/>
                <filter string="Por tipo de compra" name="g_flow" context="{'group_by':'marketplace_flow'}"/>
            </search>
        </field>
    </record>

    <record id="action_solicitud_compra" model="ir.actions.act_window">
        <field name="name">Solicitudes de compra</field>
        <field name="res_model">amunet.solicitud.compra</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_f_abiertas': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra una solicitud de compra</p>
            <p>Aqui va lo que hay que COMPRAR, del catalogo interno o de una
               propuesta. Para pedir material que ya esta en Almacen, usa
               Solicitudes de Material.</p>
        </field>
    </record>

</odoo>
