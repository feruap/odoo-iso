<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="marketplace_product_proposal_rule_requester_own" model="ir.rule">
            <field name="name">Marketplace proposal requester own</field>
            <field name="model_id" ref="model_amunet_marketplace_product_proposal"/>
            <field name="domain_force">[('requester_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('amunet_material_request.group_material_requester'))]"/>
        </record>

        <record id="marketplace_product_proposal_rule_warehouse_all" model="ir.rule">
            <field name="name">Marketplace proposal warehouse all</field>
            <field name="model_id" ref="model_amunet_marketplace_product_proposal"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('amunet_material_request.group_material_warehouse'))]"/>
        </record>

        <record id="marketplace_product_proposal_rule_manager_all" model="ir.rule">
            <field name="name">Marketplace proposal manager all</field>
            <field name="model_id" ref="model_amunet_marketplace_product_proposal"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('amunet_material_request.group_material_manager'))]"/>
        </record>

    </data>
</odoo>
