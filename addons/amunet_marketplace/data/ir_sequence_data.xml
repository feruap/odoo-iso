<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Folio de la solicitud de compra: SC/AA/NNNNN.
        noupdate="1" es OBLIGATORIO: sin el, la secuencia se reinicia en cada
        actualizacion del modulo y se repiten folios. Ya paso con el preflight
        el 08-ago-2026: 44 folios duplicados que hubo que renumerar a mano.
    -->
    <data noupdate="1">
        <record id="seq_amunet_solicitud_compra" model="ir.sequence">
            <field name="name">Solicitud de compra</field>
            <field name="code">amunet.solicitud.compra</field>
            <field name="prefix">SC/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
