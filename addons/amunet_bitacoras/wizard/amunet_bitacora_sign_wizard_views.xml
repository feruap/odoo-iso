<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bitacora_sign_wizard_form" model="ir.ui.view">
        <field name="name">amunet.bitacora.sign.wizard.form</field>
        <field name="model">amunet.bitacora.sign.wizard</field>
        <field name="arch" type="xml">
            <form string="Firmar registro">
                <group>
                    <field name="entry_id" invisible="1"/>
                    <field name="role"/>
                    <field name="pin" password="True"/>
                    <field name="deviation_note"
                           placeholder="Solo si el registro está fuera de especificación o falta un paso obligatorio."/>
                </group>
                <footer>
                    <button name="action_sign" type="object" string="Firmar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
