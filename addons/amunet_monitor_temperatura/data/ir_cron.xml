<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_temp_generate" model="ir.cron">
        <field name="name">Monitor Temperatura: generar turnos y marcar no realizados</field>
        <field name="model_id" ref="model_amunet_temp_reading"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_and_mark()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
