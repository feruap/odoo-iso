<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_temp_user" model="res.groups">
        <field name="name">Monitor Temperatura / Usuario</field>
        <field name="comment">Captura y consulta segun su area (derivado de Empleados).</field>
    </record>

    <record id="group_temp_manager" model="res.groups">
        <field name="name">Monitor Temperatura / Configuracion</field>
        <field name="implied_ids" eval="[(4, ref('group_temp_user'))]"/>
        <field name="comment">Configura areas, limites, horarios e instrumentos.</field>
    </record>

    <record id="group_temp_signoff" model="res.groups">
        <field name="name">Monitor Temperatura / Cierre diario (supervisores)</field>
        <field name="implied_ids" eval="[(4, ref('group_temp_user'))]"/>
        <field name="comment">Solo supervisores de area (mas Alma y Mery): ven y firman el Cierre diario. Membresia explicita (no se hereda de manager/system).</field>
    </record>

    <!-- El acceso al monitor NO es automatico para todos los internos: es
         EXPLICITO por usuario (group_temp_user). Asi, personal sin capacitar
         (ej. practicantes) no lo ve hasta que se le otorgue el grupo. La
         membresia inicial de los usuarios actuales se gestiona como dato. -->

    <!-- La configuracion la tienen los administradores del sistema -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_temp_manager'))]"/>
    </record>
</odoo>
