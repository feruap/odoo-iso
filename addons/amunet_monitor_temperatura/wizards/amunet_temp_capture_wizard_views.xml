<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amunet_temp_capture_wizard" model="ir.ui.view">
        <field name="name">amunet.temp.capture.wizard.form</field>
        <field name="model">amunet.temp.capture.wizard</field>
        <field name="arch" type="xml">
            <form string="Capturar temperatura">
                <group>
                    <group>
                        <field name="area_name"/>
                        <field name="scheduled_label"/>
                        <field name="instrument_name"/>
                    </group>
                    <group>
                        <label for="temp_min" string="Rango temp."/>
                        <div>
                            <field name="temp_min" class="oe_inline" nolabel="1"/> -
                            <field name="temp_max" class="oe_inline" nolabel="1"/> C
                        </div>
                        <label for="hum_max" string="Humedad max." invisible="not hum_required"/>
                        <div invisible="not hum_required">
                            <field name="hum_max" class="oe_inline" nolabel="1"/> %HR
                        </div>
                    </group>
                </group>
                <group string="Lectura">
                    <field name="hum_required" invisible="1"/>
                    <field name="temp_value"/>
                    <field name="hum_value" invisible="not hum_required" required="hum_required"/>
                    <field name="observation" placeholder="Opcional"/>
                    <field name="pin" password="True" placeholder="PIN de quien captura"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Guardar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
