<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_n3000" model="ir.ui.view">
        <field name="name">hr.employee.form.n3000.access</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Control de Acceso N3000"
                      name="n3000_access"
                      groups="hr.group_hr_user">
                    <group>
                        <group string="Tarjeta de la puerta">
                            <field name="n3000_card_no"/>
                            <field name="n3000_access_enabled"/>
                            <field name="n3000_valid_from"/>
                            <field name="n3000_valid_to"/>
                        </group>
                        <group string="QR para compartir con el empleado">
                            <field name="n3000_qr" widget="image"
                                   options="{'size': [220, 220]}" nolabel="1"/>
                        </group>
                    </group>
                    <div class="text-muted" colspan="2">
                        El empleado muestra este codigo QR a la camara de la puerta
                        para entrar. RRHH puede descargarlo y compartirlo.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
