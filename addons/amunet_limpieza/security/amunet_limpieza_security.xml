<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_limpieza_user" model="res.groups">
        <field name="name">Limpieza / Usuario</field>
        <field name="comment">Registra y consulta limpieza. Para responsable (Amelia) y supervisores de area.</field>
    </record>

    <record id="group_limpieza_manager" model="res.groups">
        <field name="name">Limpieza / Configuracion</field>
        <field name="implied_ids" eval="[(4, ref('group_limpieza_user'))]"/>
        <field name="comment">Configura items, frecuencias y plantillas de limpieza por area.</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_limpieza_manager'))]"/>
    </record>
</odoo>
