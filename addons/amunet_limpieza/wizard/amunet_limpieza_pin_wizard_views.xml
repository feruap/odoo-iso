<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_limpieza_pin_wizard_form" model="ir.ui.view">
        <field name="name">amunet.limpieza.pin.wizard.form</field>
        <field name="model">amunet.limpieza.pin.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="mode" invisible="1"/>
                <div class="alert alert-info" role="alert">
                    <strong><field name="area_name" class="oe_inline" readonly="1"/></strong> —
                    <field name="surface" class="oe_inline" readonly="1"/>
                    <div invisible="mode != 'realizada'">Sanitizante: <field name="sanitizer" class="oe_inline" readonly="1"/></div>
                </div>
                <group>
                    <field name="pin" password="True" placeholder="Captura tu PIN"
                           nolabel="1" class="oe_inline"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
