<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="0">
    <record id="cron_amunet_notify_minimos" model="ir.cron">
        <field name="cron_name">Almacén MP: notificar productos bajo mínimo</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="model_id" ref="stock.model_stock_warehouse_orderpoint"/>
        <field name="state">code</field>
        <field name="code">model._amunet_notify_minimos(user_ids=[78])</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 08:00:00')"/>
    </record>
</data>
</odoo>
