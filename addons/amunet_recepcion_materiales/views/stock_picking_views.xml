<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_recepcion_materiales" model="ir.ui.view">
        <field name="name">stock.picking.form.recepcion.materiales</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="amunet_lot.view_picking_form_inherit_amunet_lot_detailed_operations"/>
        <field name="priority">110</field>
        <field name="arch" type="xml">

            <!-- Campo auxiliar para ocultar columnas de MP en recepciones de equipo -->
            <xpath expr="//field[@name='picking_type_id']" position="after">
                <field name="amunet_es_recepcion_equipo" invisible="1"/>
            </xpath>

            <!-- Lote Amunet: sobreescribir las condiciones de Odoo que lo ocultan en draft -->
            <xpath expr="//page[@name='operations']/field[@name='move_ids']//field[@name='lot_ids']" position="attributes">
                <attribute name="string">Lote Amunet</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="column_invisible">parent.picking_type_code != 'incoming' and parent.state == 'draft'</attribute>
                <attribute name="invisible">has_tracking == 'none'</attribute>
                <attribute name="readonly">parent.state == 'draft' and parent.picking_type_code == 'incoming'</attribute>
            </xpath>

            <!-- Ocultar botón "Detalles" para incoming: toda la info ya está en la tabla principal -->
            <xpath expr="//button[@name='action_show_details']" position="attributes">
                <attribute name="invisible">not show_details_visible or parent.picking_type_code == 'incoming'</attribute>
            </xpath>

            <!-- Agregar columnas extra para recepciones, después del lote Amunet -->
            <!-- Todas grises (readonly) en draft; editables después de "Marcar por realizar" -->
            <xpath expr="//page[@name='operations']/field[@name='move_ids']//field[@name='lot_ids']" position="after">
                <field name="amunet_supplier_lot"
                       string="Serie / Lote proveedor"
                       column_invisible="parent.picking_type_code != 'incoming'"
                       readonly="parent.state == 'draft'"/>
                <field name="amunet_mfg_date"
                       string="Fecha fabricación"
                       placeholder="DD/MM/AAAA o NA"
                       column_invisible="parent.picking_type_code != 'incoming' or parent.amunet_es_recepcion_equipo"
                       readonly="parent.state == 'draft'"/>
                <field name="amunet_exp_date"
                       string="Fecha caducidad"
                       placeholder="DD/MM/AAAA o NA"
                       column_invisible="parent.picking_type_code != 'incoming' or parent.amunet_es_recepcion_equipo"
                       readonly="parent.state == 'draft'"/>
                <field name="amunet_removal_date"
                       string="Fecha remoción"
                       readonly="1"
                       column_invisible="parent.picking_type_code != 'incoming' or parent.amunet_es_recepcion_equipo"/>
                <field name="location_dest_id"
                       string="Destino"
                       readonly="1"
                       column_invisible="parent.picking_type_code != 'incoming'"
                       options="{'no_open': True}"/>
            </xpath>

            <!-- Botón y resumen de lotes de equipos -->
            <xpath expr="//page[@name='operations']" position="inside">
                <div class="mt-3" invisible="picking_type_code != 'incoming'">
                    <button name="action_open_serial_wizard"
                            type="object"
                            string="Registrar números de serie (equipos)"
                            icon="fa-barcode"
                            class="btn-secondary btn-sm"/>
                    <div class="mt-2 p-2 rounded"
                         style="background:#f8f9fa; border:1px solid #dee2e6;"
                         invisible="not amunet_equipment_lots_html">
                        <div class="fw-bold mb-1" style="font-size:13px;">
                            Números de serie registrados:
                        </div>
                        <field name="amunet_equipment_lots_html" widget="html" readonly="1"
                               style="font-size:13px;"/>
                    </div>
                </div>
            </xpath>

            <!-- Cant. real editable en recepciones (no depende de transfer_approved) -->
            <xpath expr="//field[@name='move_line_ids']//field[@name='quantity']" position="attributes">
                <attribute name="readonly">parent.state == 'done' or (parent.picking_type_code == 'internal' and not parent.transfer_approved)</attribute>
            </xpath>

            <!-- Estado en Calidad: visible en move_line_ids (vista de recepción hecha) -->
            <xpath expr="//field[@name='move_line_ids']//field[@name='product_uom_id']" position="after">
                <field name="amunet_calidad_estado"
                       string="Estado en Calidad"
                       widget="badge"
                       decoration-danger="amunet_calidad_estado == 'quarantine'"
                       decoration-warning="amunet_calidad_estado == 'in_review'"
                       decoration-success="amunet_calidad_estado == 'released'"
                       column_invisible="parent.picking_type_code != 'incoming'"
                       readonly="1"/>
            </xpath>

        </field>
    </record>

    <!-- Pestaña Inspección de entrada -->
    <record id="view_picking_form_inspeccion_entrada" model="ir.ui.view">
        <field name="name">stock.picking.form.inspeccion.entrada</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">115</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='operations']" position="after">
                <page name="inspeccion_entrada" string="Inspección de entrada"
                      invisible="picking_type_code != 'incoming'">

                    <group string="Criterios de aceptación (ISO 13485 §7.4.3)">
                        <group>
                            <field name="amunet_crit1" widget="radio" options="{'horizontal': true}"/>
                            <field name="amunet_crit2" widget="radio" options="{'horizontal': true}"/>
                            <field name="amunet_crit3" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group>
                            <field name="amunet_crit4" widget="radio" options="{'horizontal': true}"
                                   help="Aplica para anticuerpos, antígenos, reactivos y materiales biológicos. Para consumibles selecciona N/A."/>
                            <field name="amunet_crit5" widget="radio" options="{'horizontal': true}"/>
                        </group>
                    </group>

                    <group string="Observaciones y disposición">
                        <field name="amunet_con_observaciones" widget="boolean_toggle"/>
                        <field name="amunet_crit_obs"
                               placeholder="Describe cualquier anomalía detectada..."
                               invisible="not amunet_con_observaciones"/>
                    </group>

                    <group string="Responsable de recepción">
                        <field name="amunet_receptor_id"
                               domain="[('share', '=', False)]"
                               options="{'no_create': True}"/>
                    </group>

                </page>
            </xpath>
        </field>
    </record>

    <!-- Orden por defecto en Actualizar Cantidad: siempre AMP/Existencias antes que AMPB -->
    <record id="view_stock_quant_inventory_order_almacenmp" model="ir.ui.view">
        <field name="name">stock.quant.inventory.list.order.almacenmp</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="priority">120</field>
        <field name="arch" type="xml">
            <xpath expr="." position="attributes">
                <attribute name="default_order">location_id, product_id, lot_id</attribute>
            </xpath>
        </field>
    </record>

</odoo>
