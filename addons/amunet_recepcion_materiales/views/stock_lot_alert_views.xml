<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_alert_decoration" model="ir.ui.view">
        <field name="name">stock.lot.alert.decoration.almacenmp</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="priority">120</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">amunet_alert_level == 'expired'</attribute>
                <attribute name="decoration-warning">amunet_alert_level == 'soon'</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="before">
                <field name="amunet_alert_level" column_invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
