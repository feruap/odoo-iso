<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_recepcion_pin_wizard_form" model="ir.ui.view">
        <field name="name">amunet.recepcion.pin.wizard.form</field>
        <field name="model">amunet.recepcion.pin.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar recepción">
                <div class="alert alert-info mb-3" role="alert">
                    Esta acción ingresará el material al inventario (o a Control de calidad
                    si el producto lo requiere). Confirma con tu PIN de firma.
                </div>
                <group>
                    <field name="picking_id" invisible="1"/>
                    <field name="pin"
                           placeholder="Escribe tu PIN de firma"/>
                </group>
                <footer>
                    <button name="action_confirmar" type="object"
                            string="Confirmar recepción" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
