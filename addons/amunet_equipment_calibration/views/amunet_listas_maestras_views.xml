<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ================================================================
             LISTA MAESTRA 1: EQUIPOS CALIFICADOS
             ================================================================ -->
        <record id="view_lista_equipos_calificados_list" model="ir.ui.view">
            <field name="name">amunet.equipment.lista.calificados.list</field>
            <field name="model">amunet.equipment</field>
            <field name="arch" type="xml">
                <list string="Equipos Calificados"
                      decoration-muted="state == 'out_of_service'">
                    <field name="serial_number" string="Código/ID"/>
                    <field name="name" string="Equipo"/>
                    <field name="department" string="Área"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'active'"
                           decoration-warning="state == 'maintenance'"
                           decoration-muted="state == 'out_of_service'"
                           string="Estatus"/>
                    <field name="expediente_state" widget="badge"
                           decoration-success="expediente_state == 'vigente'"
                           decoration-warning="expediente_state == 'en_proceso'"
                           decoration-muted="expediente_state == 'obsoleto'"
                           string="Calificación"/>
                </list>
            </field>
        </record>

        <record id="action_lista_equipos_calificados" model="ir.actions.act_window">
            <field name="name">Equipos Calificados</field>
            <field name="res_model">amunet.equipment</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_lista_equipos_calificados_list"/>
            <field name="domain">[('expediente_count', '>', 0), ('is_deseable', '=', False)]</field>
            <field name="context">{'search_default_group_department': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No hay equipos con expediente de calificación registrado.
                </p>
            </field>
        </record>

        <!-- ================================================================
             LISTA MAESTRA 2: EQUIPOS CALIBRABLES
             ================================================================ -->
        <record id="view_lista_equipos_calibrables_list" model="ir.ui.view">
            <field name="name">amunet.equipment.lista.calibrables.list</field>
            <field name="model">amunet.equipment</field>
            <field name="arch" type="xml">
                <list string="Equipos Calibrables"
                      decoration-danger="calibration_work_status == 'expired'"
                      decoration-warning="calibration_work_status == 'due_soon'"
                      decoration-muted="state == 'out_of_service'">
                    <field name="serial_number" string="Código/ID"/>
                    <field name="name" string="Equipo"/>
                    <field name="department" string="Área"/>
                    <field name="calibracion_via" string="Calibración"/>
                    <field name="next_calibration_date" string="Próxima calibración"/>
                    <field name="calibration_work_status" widget="badge"
                           decoration-success="calibration_work_status == 'current'"
                           decoration-warning="calibration_work_status == 'due_soon'"
                           decoration-danger="calibration_work_status == 'expired'"
                           decoration-muted="calibration_work_status == 'missing'"
                           string="Estado"/>
                    <field name="state" column_invisible="1"/>
                    <field name="calibration_work_status" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_lista_calibrables_search" model="ir.ui.view">
            <field name="name">amunet.equipment.lista.calibrables.search</field>
            <field name="model">amunet.equipment</field>
            <field name="arch" type="xml">
                <search>
                    <field name="serial_number" string="Código/ID"/>
                    <field name="name" string="Equipo"/>
                    <field name="department" string="Área"/>
                    <separator/>
                    <filter name="group_department" string="Agrupar por área"
                            context="{'group_by': 'department'}"/>
                </search>
            </field>
        </record>

        <record id="action_lista_equipos_calibrables" model="ir.actions.act_window">
            <field name="name">Equipos Calibrables</field>
            <field name="res_model">amunet.equipment</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_lista_equipos_calibrables_list"/>
            <field name="search_view_id" ref="view_lista_calibrables_search"/>
            <field name="domain">[
                ('is_deseable', '=', False),
                ('parent_equipment_id', '=', False),
                '|',
                    ('calibration_required', '=', True),
                    ('has_calibratable_children', '=', True)
            ]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No hay equipos que requieran calibración registrados.
                </p>
            </field>
        </record>

        <!-- ================================================================
             LISTA MAESTRA 3: ÁREAS
             ================================================================ -->
        <record id="view_lista_areas_list" model="ir.ui.view">
            <field name="name">amunet.equipment.lista.areas.list</field>
            <field name="model">amunet.equipment</field>
            <field name="arch" type="xml">
                <list string="Áreas"
                      decoration-muted="state == 'out_of_service'">
                    <field name="serial_number" string="Código/ID"/>
                    <field name="name" string="Equipo"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'active'"
                           decoration-warning="state == 'maintenance'"
                           decoration-muted="state == 'out_of_service'"
                           string="Estatus"/>
                    <field name="calibracion_via" string="Calibración"/>
                    <field name="calibration_work_status" widget="badge"
                           decoration-success="calibration_work_status == 'current'"
                           decoration-warning="calibration_work_status in ('due_soon', 'missing')"
                           decoration-danger="calibration_work_status == 'expired'"
                           decoration-muted="calibration_work_status == 'no_required'"
                           string="Estado calibración"/>
                    <field name="expediente_state" widget="badge"
                           decoration-success="expediente_state == 'vigente'"
                           decoration-warning="expediente_state == 'en_proceso'"
                           decoration-muted="expediente_state == 'obsoleto'"
                           string="Calificación"/>
                </list>
            </field>
        </record>

        <record id="action_lista_areas" model="ir.actions.act_window">
            <field name="name">Áreas</field>
            <field name="res_model">amunet.equipment</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_lista_areas_list"/>
            <field name="domain">[('is_deseable', '=', False)]</field>
            <field name="context">{'group_by': ['department']}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No hay equipos registrados.
                </p>
            </field>
        </record>

    </data>
</odoo>
