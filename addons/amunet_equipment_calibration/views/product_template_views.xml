<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_amunet_multi_serial" model="ir.ui.view">
        <field name="name">product.template.form.amunet.multi.serial</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tracking']" position="after">
                <field name="amunet_allow_multi_serial"
                       invisible="tracking != 'lot'"/>
            </xpath>
        </field>
    </record>
</odoo>
