<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- =====================================================
             EXPEDIENTE — Lista
             ===================================================== -->
        <record id="view_amunet_expediente_list" model="ir.ui.view">
            <field name="name">amunet.equipment.expediente.list</field>
            <field name="model">amunet.equipment.expediente</field>
            <field name="arch" type="xml">
                <list string="Expedientes de Calificación"
                      decoration-success="state == 'vigente'"
                      decoration-muted="state == 'obsoleto'">
                    <field name="name"/>
                    <field name="equipment_id"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'vigente'"
                           decoration-warning="state == 'en_proceso'"
                           decoration-muted="state == 'obsoleto'"/>
                </list>
            </field>
        </record>

        <!-- =====================================================
             EXPEDIENTE — Formulario
             ===================================================== -->
        <record id="view_amunet_expediente_form" model="ir.ui.view">
            <field name="name">amunet.equipment.expediente.form</field>
            <field name="model">amunet.equipment.expediente</field>
            <field name="arch" type="xml">
                <form string="Expediente de Calificación">
                    <header>
                        <field name="state" widget="statusbar"
                               statusbar_visible="en_proceso,vigente,obsoleto"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <field name="equipment_id"
                                   options="{'no_create': True, 'no_edit': True}"
                                   readonly="id != False"/>
                            <field name="equipment_serial"
                                   string="Código/ID"
                                   readonly="1"/>
                            <field name="physical_location"
                                   placeholder="Expediente físico"/>
                        </group>

                        <notebook>
                            <page string="Calificaciones" name="calificaciones">
                                <field name="qualification_ids" editable="bottom">
                                    <list string="Calificaciones">
                                        <field name="qual_type"/>
                                        <field name="protocol_code" readonly="1"/>
                                        <field name="report_code" readonly="1"/>
                                        <field name="protocol_date"/>
                                        <field name="report_date"/>
                                        <field name="responsible_id"
                                               placeholder="Jorge Simarron Cuaya"/>
                                        <field name="result" widget="badge"
                                               decoration-success="result == 'aprobado'"
                                               decoration-warning="result == 'pendiente'"
                                               decoration-danger="result == 'rechazado'"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notas" name="notas">
                                <field name="notes" placeholder="Observaciones generales del expediente..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- =====================================================
             EXPEDIENTE — Búsqueda
             ===================================================== -->
        <record id="view_amunet_expediente_search" model="ir.ui.view">
            <field name="name">amunet.equipment.expediente.search</field>
            <field name="model">amunet.equipment.expediente</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="equipment_id"/>
                    <separator/>
                    <filter name="vigente" string="Vigentes" domain="[('state','=','vigente')]"/>
                    <filter name="en_proceso" string="En proceso" domain="[('state','=','en_proceso')]"/>
                    <separator/>
                    <filter name="group_state" string="Agrupar por estado"
                            context="{'group_by': 'state'}"/>
                </search>
            </field>
        </record>

        <!-- =====================================================
             EXPEDIENTE — Acción
             ===================================================== -->
        <record id="action_amunet_expediente" model="ir.actions.act_window">
            <field name="name">Expedientes de Calificación</field>
            <field name="res_model">amunet.equipment.expediente</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_amunet_expediente_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No hay expedientes de calificación registrados.
                </p>
                <p>
                    Crea un expediente por cada equipo que requiera calificación (CD/CI/CO/CE)
                    para cumplir con ISO 13485 §7.5.6.
                </p>
            </field>
        </record>

    </data>
</odoo>
