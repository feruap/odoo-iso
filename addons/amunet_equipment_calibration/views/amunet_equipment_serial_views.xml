<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amunet_equipment_serial_list" model="ir.ui.view">
        <field name="name">amunet.equipment.serial.list</field>
        <field name="model">amunet.equipment.serial</field>
        <field name="arch" type="xml">
            <list string="Series del fabricante">
                <field name="lot_id"/>
                <field name="product_id"/>
                <field name="serial_number"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_amunet_equipment_serial_form" model="ir.ui.view">
        <field name="name">amunet.equipment.serial.form</field>
        <field name="model">amunet.equipment.serial</field>
        <field name="arch" type="xml">
            <form string="Serie del fabricante">
                <sheet>
                    <group>
                        <group>
                            <field name="lot_id" options="{'no_create': True}"/>
                            <field name="product_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="serial_number"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Notas">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
