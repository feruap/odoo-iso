<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- En el PDF de Orden de Compra: envolver la tabla de precios con t-if -->
    <template id="report_purchaseorder_document_hide_prices" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//th[@name='th_price_unit']" position="attributes">
            <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
        </xpath>
        <xpath expr="//th[@name='th_discount']" position="attributes">
            <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
        </xpath>
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
        </xpath>
        <xpath expr="//th[@name='th_subtotal']" position="attributes">
            <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
        </xpath>
        <xpath expr="//span[@t-field='line.price_unit']/ancestor::td[1]" position="attributes">
            <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
        </xpath>
        <xpath expr="//span[@t-field='line.discount']/ancestor::td[1]" position="attributes">
            <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
        </xpath>
        <xpath expr="//span[contains(@t-out, 'line.tax_ids')]/ancestor::td[1]" position="attributes">
            <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
        </xpath>
        <xpath expr="//span[@t-field='line.price_subtotal']/ancestor::td[1]" position="attributes">
            <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
        </xpath>
        <xpath expr="//div[@id='total']" position="attributes">
            <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
        </xpath>
    </template>

    <template id="report_purchasequotation_document_hide" inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//table" position="attributes">
            <attribute name="t-if">user_has_group('amunet_price_visibility.group_price_viewer') or not any(line.price_unit for line in o.order_line)</attribute>
        </xpath>
    </template>
</odoo>
