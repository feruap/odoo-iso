<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- En el PDF de Factura de Proveedor: ocultar columnas de precio si no es Fernando -->
    <template id="report_invoice_document_hide_prices_for_purchase" inherit_id="account.report_invoice_document">
        <!-- Total al pie -->
        <xpath expr="//div[@id='total']" position="attributes">
            <attribute name="t-if">env.user.has_group('amunet_price_visibility.group_price_viewer') or o.move_type not in ('in_invoice','in_refund')</attribute>
        </xpath>
    </template>
</odoo>
