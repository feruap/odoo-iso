<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- account.move list: ocultar amounts cuando es vendor bill -->
    <record id="account_move_list_hide" model="ir.ui.view">
        <field name="name">account.move.list.hide.amounts</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total_in_currency_signed']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_untaxed_in_currency_signed']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
        </field>
    </record>

    <!-- account.move form -->
    <record id="account_move_form_hide" model="ir.ui.view">
        <field name="name">account.move.form.hide.amounts</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_untaxed']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_tax']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='price_unit']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='price_subtotal']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='price_total']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
        </field>
    </record>
</odoo>
