<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- stock.lot: standard_price agregado por stock_account -->
    <record id="stock_lot_hide_cost" model="ir.ui.view">
        <field name="name">stock.lot.form.hide.cost</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock_account.view_production_lot_form_stock_account"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
        </field>
    </record>

    <!-- stock.move valuation list -->
    <record id="stock_move_valuation_hide" model="ir.ui.view">
        <field name="name">stock.move.view.list.valuation.hide</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock_account.stock_move_view_list_valuation"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
            <xpath expr="//field[@name='remaining_value']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
        </field>
    </record>
</odoo>
