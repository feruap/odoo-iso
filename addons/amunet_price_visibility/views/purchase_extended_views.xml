<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- PO list (purchase.order.list) -->
    <record id="po_list_hide_amount" model="ir.ui.view">
        <field name="name">purchase.order.list.hide.amount</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <field name="amount_total" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </field>
            <field name="amount_untaxed" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </field>
        </field>
    </record>

    <!-- PO kanban -->
    <record id="po_kanban_hide_amount" model="ir.ui.view">
        <field name="name">purchase.order.kanban.hide.amount</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_untaxed']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
        </field>
    </record>

    <!-- PO form: completar amount_total + amount_tax que la vista existente no cubría -->
    <record id="po_form_hide_amount" model="ir.ui.view">
        <field name="name">purchase.order.form.hide.amount</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_untaxed']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_tax']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='price_total']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='discount']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='taxes_id']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
        </field>
    </record>

    <!-- purchase.order.line standalone tree (id=942 purchase.order.line.list) -->
    <record id="pol_list_hide" model="ir.ui.view">
        <field name="name">purchase.order.line.list.hide</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_unit']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
            <xpath expr="//field[@name='price_subtotal']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
        </field>
    </record>

    <!-- purchase.order.line form2 standalone -->
    <record id="pol_form2_hide" model="ir.ui.view">
        <field name="name">purchase.order.line.form2.hide</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_unit']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
            <xpath expr="//field[@name='price_subtotal']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
            <xpath expr="//field[@name='taxes_id']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
        </field>
    </record>

    <!-- purchase.history (historial de compras por proveedor) -->
    <record id="purchase_history_hide" model="ir.ui.view">
        <field name="name">purchase.history.list.hide</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_history_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_unit']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
        </field>
    </record>

    <!-- purchase.report (analytical) -->
    <record id="purchase_report_hide" model="ir.ui.view">
        <field name="name">purchase.report.tree.hide</field>
        <field name="model">purchase.report</field>
        <field name="inherit_id" ref="purchase.purchase_report_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_total']" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </xpath>
        </field>
    </record>
</odoo>
