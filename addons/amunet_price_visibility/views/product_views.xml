<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- product.template form: ocultar list_price y standard_price a no-miembros -->
    <record id="product_template_form_hide_prices" model="ir.ui.view">
        <field name="name">product.template.form.hide.prices</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="list_price" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </field>
            <field name="standard_price" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </field>
        </field>
    </record>

    <record id="product_product_form_hide_prices" model="ir.ui.view">
        <field name="name">product.product.form.hide.prices</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <field name="list_price" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </field>
            <field name="standard_price" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </field>
        </field>
    </record>

    <!-- Vista lista de productos: ocultar columnas de precio -->
    <record id="product_template_tree_hide_prices" model="ir.ui.view">
        <field name="name">product.template.tree.hide.prices</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="list_price" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </field>
        </field>
    </record>

    <record id="product_product_tree_hide_prices" model="ir.ui.view">
        <field name="name">product.product.tree.hide.prices</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="lst_price" position="attributes">
                <attribute name="groups">amunet_price_visibility.group_price_viewer</attribute>
            </field>
        </field>
    </record>
</odoo>
