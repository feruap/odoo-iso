<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_stability_user" model="res.groups">
            <field name="name">Estabilidad / Analista</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Captura puntos de jalado y resultados de estabilidad.</field>
        </record>

        <record id="group_stability_approver" model="res.groups">
            <field name="name">Estabilidad / Aprobador (Calidad)</field>
            <field name="implied_ids" eval="[(4, ref('group_stability_user'))]"/>
            <field name="comment">Aprueba protocolos y conclusiones de vida útil; firma electrónica.</field>
        </record>
    </data>
</odoo>
