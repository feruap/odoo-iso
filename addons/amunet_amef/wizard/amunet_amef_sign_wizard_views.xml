<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amef_sign_wizard_form" model="ir.ui.view">
        <field name="name">amunet.amef.sign.wizard.form</field>
        <field name="model">amunet.amef.sign.wizard</field>
        <field name="arch" type="xml">
            <form string="Firmar AMEF">
                <group>
                    <field name="amef_id" invisible="1"/>
                    <field name="role"/>
                    <field name="pin" password="True"/>
                    <field name="motivo"/>
                </group>
                <footer>
                    <button name="action_sign" type="object" string="Firmar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
