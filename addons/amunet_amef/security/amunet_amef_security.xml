<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_amef_user" model="res.groups">
            <field name="name">AMEF / Analista de riesgo</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Crea y edita análisis de riesgo (AMEF) en borrador.</field>
        </record>

        <record id="group_amef_approver" model="res.groups">
            <field name="name">AMEF / Aprobador (Calidad)</field>
            <field name="implied_ids" eval="[(4, ref('group_amef_user'))]"/>
            <field name="comment">Revisa y aprueba análisis de riesgo; firma electrónica.</field>
        </record>
    </data>
</odoo>
