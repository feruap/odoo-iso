<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SEARCH VIEW -->
    <record id="view_amunet_quality_procedure_search" model="ir.ui.view">
        <field name="name">amunet.quality.procedure.search</field>
        <field name="model">amunet.quality.procedure</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="product_ids"/>
                <filter name="filter_active" string="Vigentes" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archivados" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="cat_operacion" string="Operación" domain="[('category', '=', 'operacion')]"/>
                <filter name="cat_limpieza" string="Limpieza" domain="[('category', '=', 'limpieza')]"/>
                <filter name="cat_mantenimiento" string="Mantenimiento" domain="[('category', '=', 'mantenimiento')]"/>
                <filter name="cat_general" string="Generales" domain="[('category', '=', 'general')]"/>
                <filter name="cat_pendiente" string="Sin categoría" domain="[('category', '=', False)]"/>
                <separator/>
                <filter name="group_category" string="Agrupar por categoría" context="{'group_by': 'category'}"/>
                <filter name="group_code" string="Código de Documento" context="{'group_by': 'code'}"/>
            </search>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_amunet_quality_procedure_list" model="ir.ui.view">
        <field name="name">amunet.quality.procedure.list</field>
        <field name="model">amunet.quality.procedure</field>
        <field name="arch" type="xml">
            <list string="Procedimientos (SOPs)">
                <field name="code"/>
                <field name="name"/>
                <field name="category" widget="badge"
                       decoration-info="category == 'operacion'"
                       decoration-success="category == 'limpieza'"
                       decoration-muted="category == 'mantenimiento'"
                       decoration-warning="category == 'general'"
                       column_invisible="context.get('default_category')"/>
                <field name="version"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="create_date" optional="hide"/>
                <field name="write_date" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_amunet_quality_procedure_form" model="ir.ui.view">
        <field name="name">amunet.quality.procedure.form</field>
        <field name="model">amunet.quality.procedure</field>
        <field name="arch" type="xml">
            <form string="Procedimiento (SOP)">
                <header>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Ej: Instrucción de Inspección de Cajas"/></h1>
                        <h3>
                            <span class="oe_read_only">Código: </span>
                            <field name="code" placeholder="SOP-001" class="oe_inline"/>
                            <span class="oe_read_only"> | v</span>
                            <field name="version" class="oe_inline"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="document_file" filename="document_filename" widget="binary"/>
                            <field name="document_filename" invisible="1"/>
                            <field name="active"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="product_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ACTION GENÉRICA: todos los PNOs -->
    <record id="action_amunet_quality_procedure" model="ir.actions.act_window">
        <field name="name">Control de Documentos (SOPs)</field>
        <field name="res_model">amunet.quality.procedure</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cargar un nuevo Procedimiento Operativo (SOP)
            </p>
            <p>
                Gestione los documentos controlados (ISO 13485).
                Al cargar una nueva versión con el mismo código, la anterior se archivará automáticamente.
            </p>
        </field>
    </record>

    <!-- ACTIONS POR CATEGORÍA -->
    <record id="action_amunet_quality_procedure_operacion" model="ir.actions.act_window">
        <field name="name">PNOs · Operación</field>
        <field name="res_model">amunet.quality.procedure</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('category', '=', 'operacion')]</field>
        <field name="context">{'default_category': 'operacion'}</field>
    </record>

    <record id="action_amunet_quality_procedure_limpieza" model="ir.actions.act_window">
        <field name="name">PNOs · Limpieza</field>
        <field name="res_model">amunet.quality.procedure</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('category', '=', 'limpieza')]</field>
        <field name="context">{'default_category': 'limpieza'}</field>
    </record>

    <record id="action_amunet_quality_procedure_mantenimiento" model="ir.actions.act_window">
        <field name="name">PNOs · Mantenimiento</field>
        <field name="res_model">amunet.quality.procedure</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('category', '=', 'mantenimiento')]</field>
        <field name="context">{'default_category': 'mantenimiento'}</field>
    </record>

    <record id="action_amunet_quality_procedure_general" model="ir.actions.act_window">
        <field name="name">PNOs · Generales</field>
        <field name="res_model">amunet.quality.procedure</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('category', '=', 'general')]</field>
        <field name="context">{'default_category': 'general'}</field>
    </record>
</odoo>
