<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_lot_extension_sign_wizard_form" model="ir.ui.view">
        <field name="name">amunet.lot.extension.sign.wizard.form</field>
        <field name="model">amunet.lot.extension.sign.wizard</field>
        <field name="arch" type="xml">
            <form string="Firma electrónica — Extensión de caducidad">
                <sheet>
                    <group string="Información del lote">
                        <group>
                            <field name="extension_id" invisible="1"/>
                            <field name="signature_role" invisible="1"/>
                            <field name="lot_name" readonly="1"/>
                            <field name="product_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="expiration_date_before" readonly="1"/>
                            <field name="expiration_date_after" readonly="1"/>
                            <field name="months_extended" readonly="1"/>
                        </group>
                    </group>
                    <group string="Firma electrónica">
                        <field name="password" password="True"
                               placeholder="PIN o contraseña de Odoo"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_sign"
                            string="Firmar"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
