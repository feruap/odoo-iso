<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amunet_generic_signature_wizard_form" model="ir.ui.view">
        <field name="name">amunet.generic.signature.wizard.form</field>
        <field name="model">amunet.generic.signature.wizard</field>
        <field name="arch" type="xml">
            <form string="Firma electronica">
                <sheet>
                    <group>
                        <field name="signature_type" readonly="1"/>
                        <field name="reason" readonly="1" nolabel="1"/>
                        <field name="password" password="True"/>
                        <field name="res_model" invisible="1"/>
                        <field name="res_id" invisible="1"/>
                        <field name="method_name" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_signature"
                            string="Firmar"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
