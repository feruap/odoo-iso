<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="amunet_quality.DecisionMatrixWidget" owl="1">
        <div class="o_decision_matrix_widget border rounded p-3 mb-2">

            <!-- Encabezado: título + badge de concentración + botón N/A -->
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h6 class="mb-1 text-primary fw-bold">MAVI-15: Decisión por Rango</h6>
                    <!-- Badge de concentración fija -->
                    <t t-if="isFixedConcentration">
                        <span t-attf-class="{{ fixedConcentrationBadgeClass }}">
                            <t t-esc="fixedConcentrationLabel"/>
                        </span>
                    </t>
                </div>
                <!-- Botón N/A (solo editable) -->
                <t t-if="!props.readonly">
                    <button t-if="!isNA"
                            class="btn btn-sm btn-outline-secondary"
                            type="button"
                            t-on-click="onNAToggle">
                        N/A
                    </button>
                    <button t-if="isNA"
                            class="btn btn-sm btn-secondary"
                            type="button"
                            t-on-click="onNAToggle">
                        ↩ Quitar N/A
                    </button>
                </t>
                <!-- Readonly: badge N/A -->
                <t t-if="props.readonly and isNA">
                    <span class="badge bg-secondary">N/A</span>
                </t>
            </div>

            <!-- Cuando N/A está activo: solo mostrar aviso -->
            <t t-if="isNA">
                <div class="alert alert-secondary py-2 mb-0">
                    <i class="fa fa-ban me-2"/>
                    <strong>N/A:</strong> Muestra no disponible para esta concentración.
                </div>
            </t>

            <t t-else="">
                <!-- Paso 1: solo visible cuando NO hay concentración fija -->
                <div t-if="!isFixedConcentration"
                     class="card mb-3"
                     t-attf-class="{{ step1Complete ? 'border-success' : 'border-primary' }}">
                    <div class="card-header bg-light">
                        <strong>
                            <span t-if="step1Complete" class="badge bg-success me-2">✓</span>
                            <span t-else="" class="badge bg-primary me-2">1</span>
                            Paso 1: Seleccione la Concentración Objetivo
                        </strong>
                    </div>
                    <div class="card-body">
                        <div class="btn-group d-flex" role="group">
                            <t t-foreach="concentrationOptions" t-as="option" t-key="option.value">
                                <input type="radio"
                                       class="btn-check"
                                       t-att-name="'dm_conc_' + props.record.id"
                                       t-att-id="'conc_' + option.value + '_' + props.record.id"
                                       t-att-value="option.value"
                                       t-att-checked="record.result_dm_step1_concentration === option.value"
                                       t-on-change="onConcentrationChange"
                                       t-att-disabled="props.readonly"/>
                                <label class="btn btn-outline-primary"
                                       t-att-for="'conc_' + option.value + '_' + props.record.id">
                                    <t t-esc="option.label"/>
                                </label>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Paso 2.1: Línea de Control Visible -->
                <div t-if="showStep2_1"
                     class="card mb-3"
                     t-attf-class="{{ step2_1Complete ? 'border-success' : 'border-primary' }}">
                    <div class="card-header bg-light">
                        <strong>
                            <span t-if="step2_1Complete" class="badge bg-success me-2">✓</span>
                            <span t-else="" class="badge bg-primary me-2">
                                <t t-if="isFixedConcentration">1</t>
                                <t t-else="">2.1</t>
                            </span>
                            ¿La línea de control (C) es visible?
                        </strong>
                    </div>
                    <div class="card-body">
                        <div class="btn-group d-flex" role="group">
                            <t t-foreach="controlVisibleOptions" t-as="option" t-key="option.value">
                                <input type="radio"
                                       class="btn-check"
                                       t-att-name="'dm_control_' + props.record.id"
                                       t-att-id="'control_' + option.value + '_' + props.record.id"
                                       t-att-value="option.value"
                                       t-att-checked="record.result_dm_step2_1_control_visible === option.value"
                                       t-on-change="onControlVisibleChange"
                                       t-att-disabled="props.readonly"/>
                                <label t-attf-class="btn {{ option.value === 'yes' ? 'btn-outline-success' : 'btn-outline-danger' }}"
                                       t-att-for="'control_' + option.value + '_' + props.record.id">
                                    <t t-esc="option.label"/>
                                </label>
                            </t>
                        </div>
                        <div t-if="record.result_dm_step2_1_control_visible === 'no'"
                             class="alert alert-danger mt-3 mb-0">
                            <i class="fa fa-exclamation-triangle me-2"/>
                            <strong>Prueba inválida:</strong> No hay visualización de la línea de control.
                        </div>
                    </div>
                </div>

                <!-- Paso 2.2: Comparación T vs R -->
                <div t-if="showStep2_2"
                     class="card mb-3"
                     t-attf-class="{{ step2_2Complete ? 'border-success' : 'border-primary' }}">
                    <div class="card-header bg-light">
                        <strong>
                            <span t-if="step2_2Complete" class="badge bg-success me-2">✓</span>
                            <span t-else="" class="badge bg-primary me-2">
                                <t t-if="isFixedConcentration">2</t>
                                <t t-else="">2.2</t>
                            </span>
                            Compare visualmente T vs R
                        </strong>
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            <t t-foreach="comparisonOptions" t-as="option" t-key="option.value">
                                <div class="col-6">
                                    <input type="radio"
                                           class="btn-check"
                                           t-att-name="'dm_comp_' + props.record.id"
                                           t-att-id="'comp_' + option.value + '_' + props.record.id"
                                           t-att-value="option.value"
                                           t-att-checked="record.result_dm_step2_2_comparison === option.value"
                                           t-on-change="onComparisonChange"
                                           t-att-disabled="props.readonly"/>
                                    <label class="btn btn-outline-info w-100"
                                           t-att-for="'comp_' + option.value + '_' + props.record.id">
                                        <t t-esc="option.label"/>
                                    </label>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Dictamen Final -->
                <div t-if="record.verdict and record.evaluation_type === 'decision_matrix'">
                    <div t-attf-class="alert py-2 mb-0 {{ record.verdict === 'pass' ? 'alert-success' : record.verdict === 'fail' ? 'alert-danger' : record.verdict === 'not_applicable' ? 'alert-secondary' : 'alert-warning' }}">
                        <strong t-if="record.verdict === 'pass'">✓ CUMPLE</strong>
                        <strong t-elif="record.verdict === 'fail'">✗ NO CUMPLE</strong>
                        <strong t-elif="record.verdict === 'not_applicable'">⚪ N/A</strong>
                        <strong t-else="">⏳ PENDIENTE</strong>
                        <span t-if="record.verdict_message" class="ms-2 small">
                            — <t t-esc="record.verdict_message"/>
                        </span>
                    </div>
                </div>
            </t>

        </div>
    </t>
</templates>
