<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Grupos de Seguridad - Control de Calidad Amunet
        Epic-029: Sistema de Control de Calidad
        T-029-16: Configurar grupos de seguridad
    -->

    <!-- Grupo: Usuario de QC (Analista) -->
    <record id="group_quality_user" model="res.groups">
        <field name="name">Calidad / Analista QC</field>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">
            Puede crear y editar controles de calidad.
            Puede registrar resultados de pruebas.
            Puede firmar en el campo "Realizó".
        </field>
    </record>

    <!-- Grupo: Supervisor de QC -->
    <record id="group_quality_supervisor" model="res.groups">
        <field name="name">Calidad / Supervisor QC</field>
        <!-- Hereda de Analista QC. El comentario de abajo lo dice desde que se creo
             el modulo ("Todos los permisos del Analista"), pero implied_ids apuntaba
             solo a base.group_user, asi que no se cumplia: un supervisor NO podia
             hacer lo del analista. Se detecto el 01-oct-2026 porque el preflight de
             DMADB01 rechazaba a Diana Flores (Supervisor QC) por no pertenecer a
             Analista QC. -->
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user'), ref('group_quality_user')])]"/>
        <field name="comment">
            Todos los permisos del Analista.
            Puede firmar en el campo "Verificó".
        </field>
    </record>

    <!-- Grupo: Responsable Sanitario -->
    <record id="group_quality_sanitary" model="res.groups">
        <field name="name">Calidad / Responsable Sanitario</field>
        <!-- Hereda de Supervisor QC, y por la cadena tambien de Analista. Igual que
             arriba: su comentario decia "Todos los permisos del Supervisor" y no se
             cumplia. La facultad propia del Responsable Sanitario, firmar "Autorizo"
             y finalizar el analisis- NO se hereda hacia nadie: es exclusiva de este
             grupo y asi se queda. -->
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user'), ref('group_quality_supervisor')])]"/>
        <field name="comment">
            Todos los permisos del Supervisor.
            Puede firmar en el campo "Autorizó".
            Único que puede finalizar el análisis.
        </field>
    </record>

    <!-- Grupo: Manager de QC -->
    <record id="group_quality_manager" model="res.groups">
        <field name="name">Calidad / Manager QC</field>
        <!-- A PROPOSITO SIN CADENA, y conviene saber por que: su comentario dice
             "acceso total al modulo de calidad", que es ambiguo. Encadenarlo al
             Responsable Sanitario le daria a los 3 managers la facultad de firmar
             "Autorizo" y finalizar analisis, y eso es una decision regulatoria sobre
             quien libera un lote, no se toma de paso en un arreglo de herencia-.
             Pendiente de definir con Fernando y la Responsable Sanitario. -->
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">
            Acceso total al módulo de calidad.
            Puede configurar parámetros.
            Puede eliminar registros (con restricciones).
        </field>
    </record>

    <record id="rule_signature_pin_own_record" model="ir.rule">
        <field name="name">PIN de Firma: solo registro propio</field>
        <field name="model_id" ref="model_amunet_quality_signature_pin"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[
            (4, ref('base.group_user')),
            (4, ref('amunet_quality.group_quality_user')),
            (4, ref('amunet_quality.group_quality_supervisor')),
            (4, ref('amunet_quality.group_quality_sanitary'))
        ]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_signature_pin_manager_all_records" model="ir.rule">
        <field name="name">PIN de Firma: administracion calidad</field>
        <field name="model_id" ref="model_amunet_quality_signature_pin"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[
            (4, ref('amunet_quality.group_quality_manager')),
            (4, ref('base.group_system'))
        ]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>


    <!-- Firma de ALMACEN en las extensiones de caducidad.

         La extension pide tres firmas: Calidad -> Responsable Sanitario ->
         Almacen. Pero solo los grupos de Calidad tenian permiso de escritura
         sobre amunet.lot.extension, y la firma de almacen escribe para cerrar
         el registro. Resultado: el flujo SIEMPRE se trababa en el ultimo paso
         y por eso el mecanismo llevaba cero usos.

         Detectado por el agente de Almacen el 2026-09-02 con EXT/2026/0001
         (antidoping, 1,730 pz sin poderse vender).

         El grupo vive aqui, junto al modelo, porque amunet_quality no depende
         de los modulos de almacen ni al reves. -->
    <record id="group_lot_extension_warehouse" model="res.groups">
        <field name="name">Almacen / Firma extensiones de caducidad</field>
    </record>

</odoo>
