<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      noupdate="1" A PROPOSITO: si estos parametros se reescribieran en cada
      actualizacion del modulo, se perderia cualquier ajuste manual. En
      particular la fecha de bloqueo por capacitacion debe poder moverse con
      una decision consciente y quedar asi.
    -->
    <data noupdate="1">

        <!-- Hasta esta fecha, asignar a alguien sin capacitacion vigente solo
             genera un AVISO. Desde esta fecha en adelante, se BLOQUEA.
             Definido con Mery el 2026-08-31: 3 meses de gracia, para entonces
             el modulo de capacitacion debe estar cubierto. -->
        <record id="param_capacitacion_bloqueo_desde" model="ir.config_parameter">
            <field name="key">amunet_calidad_tablero.capacitacion_bloqueo_desde</field>
            <field name="value">2026-11-30</field>
        </record>

        <!-- Un lote que caduca dentro de estos dias sube a prioridad
             "Proximo a caducar o usar". -->
        <record id="param_dias_caducidad_prioritaria" model="ir.config_parameter">
            <field name="key">amunet_calidad_tablero.dias_caducidad_prioritaria</field>
            <field name="value">365</field>
        </record>

    </data>
</odoo>
