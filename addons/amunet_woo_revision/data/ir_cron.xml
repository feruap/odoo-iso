<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Revision diaria del mapeo Woo <-> Odoo a las 23:00.
            SOLO LECTURA sobre la tienda (GET). No escribe en WooCommerce.
            Vive en el modelo amunet.revision.mapeo (no amunet.woo.*) para
            respetar el contrato de solo lectura de amunet_woocommerce.
        -->
        <record id="cron_revision_mapeo_diaria" model="ir.cron">
            <field name="name">Amunet: revision diaria del mapeo Woo (23:00)</field>
            <field name="model_id" ref="model_amunet_revision_mapeo"/>
            <field name="state">code</field>
            <field name="code">model.cron_revisar()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall"
                   eval="(DateTime.now().replace(hour=5, minute=0, second=0, microsecond=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
