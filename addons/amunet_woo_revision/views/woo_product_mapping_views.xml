<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Columnas para que Almacen decida cual clave queda como unica -->
    <record id="view_woo_product_mapping_list_clave" model="ir.ui.view">
        <field name="name">amunet.woo.product.mapping.list.clave</field>
        <field name="model">amunet.woo.product.mapping</field>
        <field name="inherit_id" ref="amunet_woocommerce.view_woo_product_mapping_list"/>
        <field name="arch" type="xml">
            <list position="inside">
                <field name="clave_coincide" string="Claves iguales" widget="boolean_toggle"
                       readonly="1" optional="show"/>
                <field name="clave_decidida" string="Clave a usar" optional="show"/>
                <field name="clave_final" string="Clave final" optional="show"/>
                <field name="clave_manual" string="Clave manual" optional="hide"/>
                <field name="clave_aplicada" string="Ya aplicada" optional="hide"/>
                <field name="clave_decidida_por" string="Decidio" optional="hide"/>
                <field name="clave_decidida_fecha" string="Fecha decision" optional="hide"/>
                <field name="clave_notas" string="Notas clave" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_woo_product_mapping_form_clave" model="ir.ui.view">
        <field name="name">amunet.woo.product.mapping.form.clave</field>
        <field name="model">amunet.woo.product.mapping</field>
        <field name="inherit_id" ref="amunet_woocommerce.view_woo_product_mapping_form"/>
        <field name="arch" type="xml">
            <sheet position="inside">
                <group string="Clave unica (decide Almacen)">
                    <group>
                        <field name="woo_sku" string="Clave en la pagina" readonly="1"/>
                        <field name="default_code" string="Clave en Odoo" readonly="1"/>
                        <field name="clave_coincide" readonly="1"/>
                    </group>
                    <group>
                        <field name="clave_decidida"/>
                        <field name="clave_manual"
                               invisible="clave_decidida != 'otra'"
                               required="clave_decidida == 'otra'"/>
                        <field name="clave_final" readonly="1"/>
                        <field name="clave_aplicada"/>
                        <field name="clave_decidida_por" readonly="1"/>
                        <field name="clave_decidida_fecha" readonly="1"/>
                        <field name="clave_notas"/>
                    </group>
                </group>
            </sheet>
        </field>
    </record>

    <record id="view_woo_product_mapping_search_clave" model="ir.ui.view">
        <field name="name">amunet.woo.product.mapping.search.clave</field>
        <field name="model">amunet.woo.product.mapping</field>
        <field name="inherit_id" ref="amunet_woocommerce.view_woo_product_mapping_search"/>
        <field name="arch" type="xml">
            <search position="inside">
                <filter name="f_clave_distinta" string="Claves distintas"
                        domain="[('clave_coincide','=',False)]"/>
                <filter name="f_clave_pendiente" string="Clave por decidir"
                        domain="[('clave_coincide','=',False),('clave_decidida','=','pendiente')]"/>
                <filter name="f_clave_no_aplicada" string="Decidida pero no aplicada"
                        domain="[('clave_decidida','!=','pendiente'),('clave_aplicada','=',False)]"/>
                <separator/>
                <filter name="g_clave_decidida" string="Clave a usar"
                        context="{'group_by': 'clave_decidida'}"/>
            </search>
        </field>
    </record>

</odoo>
