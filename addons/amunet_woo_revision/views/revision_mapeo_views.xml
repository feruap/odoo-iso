<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_revision_mapeo_list" model="ir.ui.view">
        <field name="name">amunet.revision.mapeo.list</field>
        <field name="model">amunet.revision.mapeo</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'atencion'" decoration-danger="state == 'error'">
                <field name="name"/>
                <field name="fecha"/>
                <field name="total_publicados" string="Publicados"/>
                <field name="n_emparejados" string="Emparejados"/>
                <field name="n_nuevos" string="Nuevos"/>
                <field name="n_huerfanos" string="Huerfanos"/>
                <field name="n_cambios" string="Cambios"/>
                <field name="n_clave_distinta" string="Claves por decidir"/>
                <field name="n_excluidos" string="Omitidos" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'ok'"
                       decoration-warning="state == 'atencion'"
                       decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="view_revision_mapeo_form" model="ir.ui.view">
        <field name="name">amunet.revision.mapeo.form</field>
        <field name="model">amunet.revision.mapeo</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_revisar_ahora" type="object" string="Revisar ahora"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Cuando">
                            <field name="fecha"/>
                            <field name="backend_id"/>
                        </group>
                        <group string="Totales">
                            <field name="total_tienda"/>
                            <field name="total_publicados"/>
                            <field name="total_mapeo"/>
                        </group>
                    </group>
                    <group string="Hallazgos">
                        <group>
                            <field name="n_emparejados"/>
                            <field name="n_nuevos"/>
                            <field name="n_huerfanos"/>
                        </group>
                        <group>
                            <field name="n_cambios"/>
                            <field name="n_sin_sku"/>
                            <field name="n_clave_distinta"/>
                            <field name="n_excluidos"/>
                        </group>
                    </group>
                    <field name="mensaje" readonly="1"/>
                    <notebook>
                        <page string="Detalle">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="tipo"/>
                                    <field name="woo_sku"/>
                                    <field name="woo_name"/>
                                    <field name="detalle"/>
                                    <field name="woo_product_id" optional="hide"/>
                                    <field name="mapping_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_revision_mapeo_search" model="ir.ui.view">
        <field name="name">amunet.revision.mapeo.search</field>
        <field name="model">amunet.revision.mapeo</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="f_atencion" string="Requieren atencion"
                        domain="[('state','=','atencion')]"/>
                <filter name="f_hoy" string="Hoy"
                        domain="[('fecha','&gt;=', (context_today()).strftime('%Y-%m-%d 00:00:00'))]"/>
            </search>
        </field>
    </record>

    <record id="action_revision_mapeo" model="ir.actions.act_window">
        <field name="name">Revisiones del mapeo (23:00)</field>
        <field name="res_model">amunet.revision.mapeo</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aun no hay revisiones</p>
            <p>Cada noche a las 23:00 el sistema compara el catalogo de la tienda
               contra el mapeo y reporta aqui lo que falta emparejar, lo que ya no
               existe y lo que cambio. Tambien puedes lanzarla a mano.</p>
        </field>
    </record>

    <menuitem id="menu_revision_mapeo"
              name="Revisiones del mapeo"
              parent="amunet_woocommerce.menu_amunet_woo_root"
              action="action_revision_mapeo"
              sequence="35"/>

</odoo>
