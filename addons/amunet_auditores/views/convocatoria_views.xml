<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════ LISTA de convocatorias ════════════════ -->
    <record id="view_convocatoria_list" model="ir.ui.view">
        <field name="name">amunet.auditor.convocatoria.list</field>
        <field name="model">amunet.auditor.convocatoria</field>
        <field name="arch" type="xml">
            <list decoration-success="state=='cerrada'" decoration-info="state=='publicada'" decoration-warning="state=='en_proceso'">
                <field name="name"/>
                <field name="fecha_emision"/>
                <field name="fecha_limite"/>
                <field name="vacantes"/>
                <field name="candidato_count" string="Candidatos"/>
                <field name="seleccionados_count" string="Seleccionados"/>
                <field name="state" widget="badge"
                    decoration-success="state in ('cerrada','publicada')"
                    decoration-warning="state == 'en_proceso'"
                    decoration-danger="state == 'cancelada'"
                    decoration-muted="state == 'borrador'"/>
            </list>
        </field>
    </record>

    <!-- ════════════════ FORMULARIO de convocatoria ════════════════ -->
    <record id="view_convocatoria_form" model="ir.ui.view">
        <field name="name">amunet.auditor.convocatoria.form</field>
        <field name="model">amunet.auditor.convocatoria</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(amunet_auditores.action_report_convocatoria)d"
                        type="action" string="Imprimir" icon="fa-print"
                        class="btn-secondary"/>
                    <button name="action_publicar" type="object" string="Publicar"
                        class="btn-primary"
                        invisible="state != 'borrador'"/>
<button name="action_cerrar" type="object" string="Cerrar convocatoria"
                        invisible="state not in ('publicada', 'en_proceso')"/>
                    <button name="action_cancelar" type="object" string="Cancelar"
                        invisible="state in ('cancelada', 'cerrada')"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="borrador,publicada,en_proceso,cerrada"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Fechas">
                            <field name="fecha_emision"/>
                            <field name="fecha_limite"/>
                            <field name="fecha_entrevista"/>
                            <field name="hora_inicio_entrevista"/>
                            <field name="hora_fin_entrevista"/>
                            <field name="lugar_entrevista"/>
                        </group>
                        <group string="Datos generales">
                            <field name="vacantes"/>
                            <field name="area_ids" widget="many2many_tags"/>
                            <field name="correo_contacto"/>
                            <field name="fecha_publicacion" readonly="1" invisible="state == 'borrador'"/>
                            <field name="fecha_cierre" readonly="1" invisible="state not in ('cerrada', 'cancelada')"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Convocatoria" name="texto">
                            <separator string="Objetivo"/>
                            <field name="objetivo" nolabel="1" widget="html"/>
                            <separator string="Formación académica"/>
                            <field name="formacion_academica" nolabel="1" rows="4"/>
                            <separator string="Funciones y responsabilidades"/>
                            <field name="funciones" nolabel="1" rows="6"/>
                            <separator string="Beneficios"/>
                            <field name="beneficios" nolabel="1" rows="4"/>
                        </page>

                        <page string="Destinatarios" name="destinatarios">
                            <p class="text-muted" style="margin-bottom:12px;">
                                Selecciona a quiénes les llegará el correo de invitación al publicar la convocatoria.
                                Si la lista está vacía al publicar, no se enviará ningún correo.
                            </p>
                            <field name="destinatario_ids" widget="many2many_tags"
                                domain="[('share','=',False),('active','=',True)]"
                                placeholder="Busca un empleado..."
                                readonly="state in ('cerrada', 'cancelada')"/>
                        </page>

                        <page string="Respuestas" name="invitaciones"
                              invisible="state == 'borrador'">
                            <field name="invitacion_ids" readonly="1">
                                <list decoration-success="respuesta == 'interesado'"
                                      decoration-muted="respuesta == 'no_interesado'">
                                    <field name="usuario_id" string="Empleado"/>
                                    <field name="respuesta" widget="badge"
                                        decoration-success="respuesta == 'interesado'"
                                        decoration-muted="respuesta == 'no_interesado'"
                                        decoration-warning="respuesta == 'pendiente'"/>
                                    <field name="fecha_respuesta" string="Fecha"/>
                                    <field name="candidato_id" string="Candidato"/>
                                    <button name="action_agregar_candidato" type="object"
                                        string="Agregar a candidatos" icon="fa-user-plus"
                                        invisible="respuesta != 'interesado' or candidato_id != False"/>
                                </list>
                            </field>
                        </page>

                        <page string="Candidatos" name="candidatos">
                            <field name="candidato_ids"
                                readonly="state in ('cerrada', 'cancelada')">
                                <list editable="bottom"
                                    decoration-success="estado == 'seleccionado'"
                                    decoration-danger="estado == 'rechazado'"
                                    decoration-warning="estado == 'espera'">
                                    <field name="usuario_id"/>
                                    <field name="criterios_count" string="Criterios eval."/>
                                    <field name="puntaje_total"/>
                                    <field name="porcentaje" string="%" digits="[5,1]"/>
                                    <field name="tipo_auditor"/>
                                    <field name="estado" widget="badge"
                                        decoration-success="estado == 'seleccionado'"
                                        decoration-danger="estado == 'rechazado'"
                                        decoration-warning="estado == 'espera'"
                                        decoration-muted="estado == 'pendiente'"/>
                                    <field name="es_lider" string="Líder"/>
                                    <button name="action_seleccionar" type="object" string="Seleccionar" icon="fa-check"
                                        invisible="estado == 'seleccionado'"/>
                                    <button name="action_rechazar" type="object" string="Rechazar" icon="fa-times"
                                        invisible="estado in ('rechazado', 'seleccionado')"/>
                                    <button name="action_designar_lider" type="object"
                                        string="Designar líder" icon="fa-star"
                                        invisible="estado != 'seleccionado' or es_lider"
                                        title="Designar como auditor líder"/>
                                    <button name="action_abrir_evaluacion" type="object"
                                        string="Evaluar" icon="fa-pencil" title="Abrir evaluación"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ════════════════ FORMULARIO de evaluación por criterio ════════════════ -->
    <record id="view_evaluacion_form" model="ir.ui.view">
        <field name="name">amunet.auditor.evaluacion.form</field>
        <field name="model">amunet.auditor.evaluacion</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h2><field name="criterio_id" readonly="1"/></h2>
                    </div>
                    <group>
                        <field name="evaluador_id" readonly="1"/>
                        <field name="fecha" readonly="1"/>
                    </group>

                    <!-- Criterios numéricos: preguntas con opciones múltiples -->
                    <separator string="Selecciona la respuesta del candidato"
                        invisible="not tiene_preguntas or criterio_tipo == 'abierta'"/>
                    <field name="respuesta_ids" nolabel="1"
                        invisible="not tiene_preguntas or criterio_tipo == 'abierta'">
                        <list editable="bottom">
                            <field name="pregunta_id" column_invisible="1"/>
                            <field name="pregunta_name" string="Pregunta" readonly="1"/>
                            <field name="opcion_id" string="Respuesta"
                                domain="[('pregunta_id', '=', pregunta_id)]"
                                options="{'no_create': True, 'no_open': True}"/>
                            <field name="puntaje" string="Pts." readonly="1"/>
                        </list>
                    </field>
                    <group string="Calificación resultante"
                        invisible="not tiene_preguntas or criterio_tipo == 'abierta'">
                        <field name="calificacion_int" string="Promedio (1–5)" readonly="1"/>
                    </group>

                    <!-- Criterios abiertos: preguntas guía + área de texto + puntaje -->
                    <separator string="Preguntas guía" invisible="criterio_tipo == 'numerica'"/>
                    <field name="criterio_descripcion" readonly="1" nolabel="1"
                        invisible="criterio_tipo == 'numerica'"
                        style="white-space: pre-wrap; background:#f8f9fa; padding:12px; border-radius:6px;"/>
                    <separator string="Respuesta del candidato" invisible="criterio_tipo == 'numerica'"/>
                    <field name="respuesta_abierta" nolabel="1" rows="5"
                        invisible="criterio_tipo == 'numerica'"
                        placeholder="Escribe aquí la respuesta del candidato..."/>
                    <group string="Puntaje" invisible="criterio_tipo == 'numerica'">
                        <field name="calificacion" widget="radio" nolabel="1"/>
                    </group>

                    <separator string="Observaciones adicionales"/>
                    <field name="observaciones" nolabel="1" rows="3"
                        placeholder="Notas adicionales del evaluador..."/>
                    <field name="criterio_tipo" invisible="1"/>
                    <field name="tiene_preguntas" invisible="1"/>
                    <field name="criterio_descripcion" invisible="1"/>
                </sheet>
                <footer>
                    <button string="Guardar" name="action_guardar_y_cerrar" type="object" class="btn-primary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ════════════════ FORMULARIO independiente de candidato ════════════════ -->
    <record id="view_candidato_form" model="ir.ui.view">
        <field name="name">amunet.auditor.candidato.form</field>
        <field name="model">amunet.auditor.candidato</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="usuario_id" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Datos generales">
                            <field name="convocatoria_id" readonly="1"/>
                            <field name="evaluador_id"/>
                            <field name="estado"/>
                            <field name="es_lider"/>
                            <field name="tipo_auditor" readonly="1"/>
                        </group>
                        <group string="Resultado">
                            <field name="puntaje_total" readonly="1"/>
                            <field name="porcentaje" readonly="1" string="% obtenido"/>
                            <field name="criterios_count" readonly="1" string="Criterios evaluados"/>
                        </group>
                    </group>
                    <separator string="Evaluación por criterio"/>
                    <field name="evaluacion_ids" nolabel="1">
                        <list>
                            <field name="criterio_id" readonly="1"/>
                            <field name="criterio_tipo" column_invisible="1"/>
                            <field name="calificacion_int" string="Calificación" readonly="1"/>
                            <button name="action_abrir_evaluacion_criterio" type="object"
                                string="Evaluar" icon="fa-pencil" title="Abrir evaluación"/>
                        </list>
                    </field>
                    <separator string="Observaciones / justificación"/>
                    <field name="observaciones" nolabel="1" rows="3"/>
                    <field name="justificacion" nolabel="1" rows="3"/>
                </sheet>
                <footer>
                    <button string="Guardar" special="save" class="btn-primary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_candidato" model="ir.actions.act_window">
        <field name="name">Candidato</field>
        <field name="res_model">amunet.auditor.candidato</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'form', 'view_id': ref('view_candidato_form')})]"/>
    </record>

    <!-- ════════════════ LISTA de criterios ════════════════ -->
    <record id="view_criterio_list" model="ir.ui.view">
        <field name="name">amunet.auditor.criterio.list</field>
        <field name="model">amunet.auditor.criterio</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="secuencia" widget="handle"/>
                <field name="name"/>
                <field name="categoria"/>
                <field name="descripcion"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ════════════════ ACCIÓN principal ════════════════ -->
    <record id="action_convocatoria" model="ir.actions.act_window">
        <field name="name">Convocatorias de auditores</field>
        <field name="res_model">amunet.auditor.convocatoria</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea la primera convocatoria para selección de auditores internos
            </p>
        </field>
    </record>

    <record id="action_criterio" model="ir.actions.act_window">
        <field name="name">Criterios de evaluación</field>
        <field name="res_model">amunet.auditor.criterio</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
