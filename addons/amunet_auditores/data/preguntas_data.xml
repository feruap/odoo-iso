    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- CRITERIO 1: Conocimiento de ISO 13485                     -->
    <!-- ══════════════════════════════════════════════════════════ -->

    <record id="pregunta_iso_1" model="amunet.auditor.pregunta">
        <field name="criterio_id" ref="criterio_iso13485"/>
        <field name="name">¿Cuál es el propósito principal de la ISO 13485 y a qué tipo de organizaciones aplica?</field>
        <field name="secuencia">10</field>
    </record>
    <record id="opcion_iso1_p1_5" model="amunet.auditor.opcion">
        <field name="pregunta_id" ref="pregunta_iso_1"/>
        <field name="puntaje">5</field>
        <field name="descripcion">Explica que regula el SGC para fabricantes de dispositivos médicos (IVD incluido) y menciona proveedores y distribuidores.</field>
    </record>
    <record id="opcion_iso1_p1_4" model="amunet.auditor.opcion">
        <field name="pregunta_id" ref="pregunta_iso_1"/>
        <field name="puntaje">4</field>
        <field name="descripcion">Menciona dispositivos médicos y sistema de calidad, sin especificar IVD.</field>
    </record>
    <record id="opcion_iso1_p1_3" model="amunet.auditor.opcion">
        <field name="pregunta_id" ref="pregunta_iso_1"/>
        <field name="puntaje">3</field>
        <field name="descripcion">Sabe que es una norma ISO de calidad, pero no detalla a quién aplica.</field>
    </record>
    <record id="opcion_iso1_p1_2" model="amunet.auditor.opcion">
        <field name="pregunta_id" ref="pregunta_iso_1"/>
        <field name="puntaje">2</field>
        <field name="descripcion">La confunde con ISO 9001 o no la diferencia con claridad.</field>
    </record>
    <record id="opcion_iso1_p1_1" model="amunet.auditor.opcion">
        <field name="pregunta_id" ref="pregunta_iso_1"/>
        <field name="puntaje">1</field>
        <field name="descripcion">No la conoce.</field>
    </record>

    <record id="pregunta_iso_2" model="amunet.auditor.pregunta">
        <field name="criterio_id" ref="criterio_iso13485"/>
        <field name="name">¿Qué diferencia hay entre un documento controlado y un registro de calidad?</field>
        <field name="secuencia">20</field>
    </record>
    <record id="opcion_iso1_p2_5" model="amunet.auditor.opcion">
        <field name="pregunta_id" ref="pregunta_iso_2"/>
        <field name="puntaje">5</field>
        <field name="descripcion">El documento dice cómo hacer las cosas; el registro es evidencia de que se hicieron. Ambos requieren control y retención.</field>
    </record>
    <record id="opcion_iso1_p2_4" model="amunet.auditor.opcion">
        <field name="pregunta_id" ref="pregunta_iso_2"/>
        <field name="puntaje">4</field>
        <field name="descripcion">Los distingue correctamente aunque no detalla los requisitos de retención.</field>
    </record>
    <record id="opcion_iso1_p2_3" model="amunet.auditor.opcion">
        <field name="pregunta_id" ref="pregunta_iso_2"/>
        <field name="puntaje">3</field>
        <field name="descripcion">Sabe que son diferentes pero no puede explicar la diferencia con precisión.</field>
    </record>
    <record id="opcion_iso1_p2_2" model="amunet.auditor.opcion">
        <field name="pregunta_id" ref="pregunta_iso_2"/>
        <field name="puntaje">2</field>
        <field name="descripcion">Los confunde o mezcla sus definiciones.</field>
    </record>
    <record id="opcion_iso1_p2_1" model="amunet.auditor.opcion">
        <field name="pregunta_id" ref="pregunta_iso_2"/>
        <field name="puntaje">1</field>
        <field name="descripcion">No los distingue.</field>
    </record>

    <record id="pregunta_iso_4" model="amunet.auditor.pregunta">
        <field name="criterio_id" ref="criterio_iso13485"/>
        <field name="name">¿Qué es una no conformidad y cómo debe manejarse según la norma?</field>
        <field name="secuencia">40</field>
    </record>
    <record id="opcion_iso1_p4_5" model="amunet.auditor.opcion">
        <field name="pregunta_id" ref="pregunta_iso_4"/>
        <field name="puntaje">5</field>
        <field name="descripcion">Define NC como incumplimiento de un requisito; describe disposición del producto, acción correctiva y cierre con evidencia.</field>
    </record>
    <record id="opcion_iso1_p4_4" model="amunet.auditor.opcion">
        <field name="pregunta_id" ref="pregunta_iso_4"/>
        <field name="puntaje">4</field>
        <field name="descripcion">La define y menciona acciones correctivas.</field>
    </record>
    <record id="opcion_iso1_p4_3" model="amunet.auditor.opcion">
        <field name="pregunta_id" ref="pregunta_iso_4"/>
        <field name="puntaje">3</field>
        <field name="descripcion">Sabe que es un incumplimiento que debe corregirse.</field>
    </record>
    <record id="opcion_iso1_p4_2" model="amunet.auditor.opcion">
        <field name="pregunta_id" ref="pregunta_iso_4"/>
        <field name="puntaje">2</field>
        <field name="descripcion">La confunde con una observación o queja del cliente.</field>
    </record>
    <record id="opcion_iso1_p4_1" model="amunet.auditor.opcion">
        <field name="pregunta_id" ref="pregunta_iso_4"/>
        <field name="puntaje">1</field>
        <field name="descripcion">No la conoce.</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- CRITERIO 2: Conocimiento de regulaciones Cofepris         -->
    <!-- ══════════════════════════════════════════════════════════ -->

    <record id="pregunta_cof_1" model="amunet.auditor.pregunta">
