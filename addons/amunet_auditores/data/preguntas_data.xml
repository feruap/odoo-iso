        <field name="descripcion">Autorización de Cofepris para comercializar en México; sin él no se puede fabricar ni vender legalmente el IVD.</field>
    </record>
    <record id="opcion_cof_p1_4" model="amunet.auditor.opcion">
        <field name="pregunta_id" ref="pregunta_cof_1"/>
        <field name="puntaje">4</field>
        <field name="descripcion">Es un permiso de Cofepris necesario para poder vender el producto.</field>
    </record>
    <record id="opcion_cof_p1_3" model="amunet.auditor.opcion">
        <field name="pregunta_id" ref="pregunta_cof_1"/>
        <field name="puntaje">3</field>
        <field name="descripcion">Sabe que existe pero no puede detallarlo.</field>
