    <record id="opcion_cof_p1_2" model="amunet.auditor.opcion">
        <field name="pregunta_id" ref="pregunta_cof_1"/>
        <field name="puntaje">2</field>
        <field name="descripcion">Lo confunde con otro tipo de registro interno o de calidad.</field>
