<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1": la secuencia se crea UNA vez. Sin esto, cada -u del
         modulo reescribia number_next=1 y reiniciaba el folio (duplicados). -->
    <data noupdate="1">
    <record id="seq_amunet_change_control" model="ir.sequence">
        <field name="name">Desviaciones y cambios Amunet</field>
        <field name="code">amunet.change.control</field>
        <field name="prefix">DCC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
    </data>
</odoo>
